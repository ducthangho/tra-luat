{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ruff check:*)",
      "Bash(python -m ruff check:*)",
      "Bash(python -m py_compile:*)",
      "Bash(python scripts/tl.py --selftest:*)",
      "Bash(python scripts/tl.py counts:*)",
      "Bash(python scripts/tl.py sweep:*)",
      "Bash(python scripts/tl.py review-queue:*)",
      "Bash(python scripts/tl.py reg-query:*)",
      "Bash(python3 scripts/tl.py --selftest:*)",
      "Bash(python3 scripts/tl.py counts:*)",
      "Bash(python3 scripts/tl.py sweep:*)",
      "Bash(python3 scripts/tl.py review-queue:*)",
      "Bash(python3 scripts/tl.py reg-query:*)",
      "Bash(python3 -m ruff check:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(python .githooks/eol_policy:*)",
      "Bash(python3 .githooks/eol_policy:*)",
      "Bash(python .github/coordination/reviewer_bootstrap/core/controller.py:*)",
      "Bash(python3 .github/coordination/reviewer_bootstrap/core/controller.py:*)",
      "Bash(python /tmp/claude-0/:*)",
      "Bash(python3 /tmp/claude-0/:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(clasp:*)"
    ],
    "deny": [
      "Read(**/*.enc)",
      "Read(**/tl_secrets*)",
      "Read(**/.env)",
      "Read(**/*cookie*)",
      "Read(**/client_secret*)",
      "Read(**/credentials*.json)",
      "Edit(**/*.enc)",
      "Edit(**/tl_secrets*)",
      "Edit(**/.env)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/pretooluse_guard.py"
          }
        ]
      }
    ]
  }
}
