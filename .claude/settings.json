{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git cat-file:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-remote:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git name-rev:*)",
      "Bash(git describe:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git shortlog:*)",
      "Bash(git remote:*)",
      "Bash(git check-ignore:*)",
      "Bash(git config core.abbrev:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git reset:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh api:*)",
      "Bash(gh search:*)",
      "Bash(gh label list:*)",
      "Bash(gh auth status:*)",
      "Bash(gh --version)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(ruff check:*)",
      "Bash(rg:*)",
      "Bash(codex --version)",
      "Bash(codex login status)",
      "Bash(codex exec:*)",
      "Bash(claude --version)",
      "Bash(claude -p:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(awk:*)",
      "Bash(grep:*)",
      "Bash(diff:*)",
      "Bash(sha256sum:*)",
      "Bash(date)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(command -v:*)",
      "Bash(which:*)",
      "Bash(where.exe:*)"
    ],
    "ask": [
      "Bash(clasp:*)"
    ],
    "deny": [
      "Read(**/*.enc)",
      "Read(**/tl_secrets*)",
      "Read(**/.env)",
      "Read(**/*cookie*)",
      "Read(**/client_secret*)",
      "Read(**/credentials*.json)",
      "Edit(**/*.enc)",
      "Edit(**/tl_secrets*)",
      "Edit(**/.env)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py"
            ],
            "timeout": 630
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pretooluse_guard.py\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'D=\"${CLAUDE_PROJECT_DIR:-}\"; [ -n \"$D\" ] || D=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$D\" ] || D=\"$PWD\"; PY=\"$(command -v python3 || command -v python || command -v py)\"; \"$PY\" \"$D/.claude/hooks/subagent_ghi_detect.py\"'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'D=\"${CLAUDE_PROJECT_DIR:-}\"; [ -n \"$D\" ] || D=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$D\" ] || D=\"$PWD\"; PY=\"$(command -v python3 || command -v python || command -v py)\"; \"$PY\" \"$D/.claude/hooks/subagent_ghi_detect.py\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'D=\"${CLAUDE_PROJECT_DIR:-}\"; [ -n \"$D\" ] || D=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$D\" ] || D=\"$PWD\"; PY=\"$(command -v python3 || command -v python || command -v py)\"; \"$PY\" \"$D/ops/cloud_agent_creds.py\" ghi-nguoc --neu-doi || true'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
