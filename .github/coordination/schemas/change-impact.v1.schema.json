{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ducthangho/tra-luat/.github/coordination/schemas/change-impact.v1.schema.json",
  "title": "tra-luat change-impact policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "candidate_rules",
    "unproven_candidates",
    "land_obligations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "const": "change-impact.v1"
    },
    "candidate_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "unproven_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unprovenCandidate"
      }
    },
    "land_obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/landObligation"
      }
    }
  },
  "$defs": {
    "pathSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "enum": [
            "exact",
            "prefix"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "$ref": "#/$defs/pathSpec"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathSpec"
          }
        }
      ]
    },
    "nonEmptyStrings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "trigger",
        "write_closure",
        "required_checks",
        "land_obligations",
        "evidence",
        "owner",
        "expires_at"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "write_closure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathSpec"
          }
        },
        "required_checks": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "land_obligations": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "unprovenCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "missing_proof",
        "evidence",
        "owner"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "missing_proof": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "landObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "description",
        "evidence",
        "owner"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
