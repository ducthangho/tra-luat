{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "Reviewer evidence",
  "description": "Tap TRUONG cua khoi reviewer evidence. Nguon normative duy nhat: docs/PROTOCOL_DA_PHIEN.md §7 (khoi reviewer) va §8 (bon muc assurance). Schema CHI hinh thuc hoa truong va enum - quy tac doc lap, quyen han va y nghia `approve` o lai §7/§8. `tests[]` dung CHUNG dinh nghia voi handoff qua `$ref` sang handoff.schema.json de mot ban khong troi lech.",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "generation",
    "provider",
    "role",
    "session_id",
    "reviewed_sha",
    "verdict",
    "assurance",
    "findings"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "packet_id": {"type": "string", "pattern": "^wp[0-9]+$"},
    "generation": {"type": "integer", "minimum": 1},
    "provider": {"enum": ["claude", "codex", "human"]},
    "role": {"const": "reviewer"},
    "session_id": {"type": "string", "minLength": 1},
    "reviewed_sha": {"$ref": "handoff.schema.json#/$defs/git_oid"},
    "independent_from_executor_session": {"type": "boolean"},
    "review_axes": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["spec", "standards_security"]}
    },
    "tests": {"type": "array", "items": {"$ref": "handoff.schema.json#/$defs/test_result"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "verdict": {"enum": ["approve", "changes_requested", "blocked"]},
    "assurance": {
      "description": "Bon muc review §8. `review_deferred` nghia la CHUA co reviewer, khong phai da review xong.",
      "enum": ["cross_approved", "same_provider_approved", "human_audited", "review_deferred"]
    },
    "evidence_url": {"type": ["string", "null"]}
  },
  "$defs": {
    "finding": {
      "description": "§7 doi finding co stable ID. Chap nhan hai dang da dung trong evidence that: chuoi ID tran, hoac object mang them severity/file/line.",
      "anyOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["id"],
          "additionalProperties": true,
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "severity": {"type": "string", "minLength": 1},
            "file": {"type": "string"},
            "line": {"type": "integer"},
            "evidence": {"type": "string"},
            "blocking": {"type": "boolean"}
          }
        }
      ]
    }
  }
}
