   144	        "đọc code, chạy kiểm tra read-only trên exact sha",
   145	        "start/pause/resume/reroute/override/authorize/apply/deploy",
   146	    ],
   147	    "dinh-nghia-trang-thai-hoan-tat": [
   148	        "merged: pr đã vào nhánh đích",
   149	        "integrated: packet pr đã vào mission integration branch",
   150	        "landed: kết quả đã vào canonical",
   151	        "complete: toàn mission đã readback canonical",
   152	    ],
   153	}
   154	
   155	
   156	def _cung_hoa_stdout() -> None:
   157	    """Ép stdout/stderr về UTF-8 để lệnh không chết khi bị CAPTURE.
   158	
   159	    Lỗi THẬT đã đo ở vòng review 3: chạy qua subprocess có capture stdout dưới
   160	    codepage không phải UTF-8, `next-comment` cho rc=1 và stdout RỖNG với
   161	    `UnicodeEncodeError: 'charmap' codec can't encode character`. Nghĩa là lệnh
   162	    trung tâm của "mọi transition ghi comment" không chạy được bằng đúng cách
   163	    adapter hướng dẫn. Không có dòng này thì mọi ca cp1252/cp1258 đỏ lại.
   164	    """
   165	    for luong in (sys.stdout, sys.stderr):
   166	        try:
   167	            luong.reconfigure(encoding="utf-8", errors="backslashreplace")
   168	        except Exception:  # pragma: no cover - nền quá cũ thì thà chạy tiếp
   169	            pass
   170	
   171	
   172	# Ký tự TRANG TRÍ của Markdown, bị bỏ trước khi so. Không có bước này thì chép
   173	# nguyên một dòng doctrine kèm dấu nháy ngược là lọt: `merged`: … không khớp
   174	# "merged: …". Đã ĐO: 5/9 dòng doctrine THẬT lọt lưới chỉ vì lớp trang trí này.
   175	# Bỏ cả gạch dưới nên `same_failure_limit` và `same failure limit` quy về một mối
   176	# — hai vế đều đi qua cùng phép chuẩn hoá nên vẫn khớp nhau.
   177	_TRANG_TRI = str.maketrans("", "", "`*_~")
   178	
   179	
   180	def _chuan_hoa(text: str) -> str:
   181	    """NFC + casefold + bỏ trang trí Markdown + gộp khoảng trắng.
   182	
   183	    Dùng CHỈ cho doctrine-scan. Ở đây chuẩn hoá rộng là ĐÚNG HƯỚNG, ngược hẳn
   184	    với phép đếm finding: khớp rộng chỉ buộc adapter viết mỏng hơn (sai về phía
   185	    an toàn), còn khớp rộng ở finding-id sẽ gộp oan hai lỗi khác nhau.
   186	    """
   187	    text = unicodedata.normalize("NFC", text).casefold().translate(_TRANG_TRI)
   188	    return " ".join(text.split())
   189	
   190	
   191	def _phang_ca_tep(raw: str):
   192	    """Ép CẢ TỆP về một chuỗi chuẩn hoá, kèm bản đồ vị trí → số dòng.
   193	
   194	    Vì sao không so từng dòng: quét theo DÒNG VẬT LÝ thì một câu doctrine bị
   195	    xuống dòng theo lối Markdown bình thường sẽ lọt sạch — đã ĐO, 3/3 cụm thử
   196	    (state machine ngắt trước "accepted", định nghĩa `merged`, ô bảng vai trò)
   197	    đều cho rc=0. Ngắt dòng là thứ người viết làm vô thức, nên chốt nào thua nó
   198	    thì thua thường xuyên, không phải hiếm.
   199	
   200	    Đây là lớp lách THỨ HAI liên tiếp bị bắt ở cùng một cơ chế (trước đó là dấu
   201	    nháy ngược). Nên lần này chữa tận gốc: so trên VĂN BẢN LOGIC, không phải trên
   202	    cách nó được bẻ dòng.
   203	    """
   204	    phan, ban_do, vi_tri = [], [], 0
   205	    for so_dong, dong in enumerate(raw.splitlines(), 1):
   206	        n = _chuan_hoa(dong)
   207	        if not n:
   208	            continue
   209	        if phan:
   210	            phan.append(" ")
   211	            vi_tri += 1
   212	        ban_do.append((vi_tri, so_dong))
   213	        phan.append(n)
   214	        vi_tri += len(n)
   215	    return "".join(phan), ban_do
   216	
   217	
   218	def _dong_tai(ban_do, offset: int) -> int:
   219	    """Vị trí trong chuỗi phẳng → số dòng gốc gần nhất."""
   220	    so = ban_do[0][1] if ban_do else 0
   221	    for bat_dau, so_dong in ban_do:
   222	        if bat_dau > offset:
   223	            break
   224	        so = so_dong
   225	    return so
   226	
   227	
   228	def _die(rc: int, msg: str) -> None:
   229	    print(msg, file=sys.stderr)
   230	    sys.exit(rc)
   231	
   232	
   233	def _state_path(state_dir: Path, packet: int) -> Path:
   234	    return state_dir / f"wp{packet}.json"
   235	
   236	
   237	def _load(state_dir: Path, packet: int) -> dict:
   238	    p = _state_path(state_dir, packet)
   239	    if not p.exists():
   240	        _die(RC_STATE, f"chưa có state cho packet {packet} — chạy `init` trước ({p})")
   241	    return json.loads(p.read_text(encoding="utf-8"))
   242	
   243	
   244	def _save(state_dir: Path, st: dict) -> None:
   245	    state_dir.mkdir(parents=True, exist_ok=True)
   246	    p = _state_path(state_dir, st["packet"])
   247	    p.write_text(
   248	        json.dumps(st, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
   249	        encoding="utf-8",
   250	        newline="\n",
   251	    )
   252	
   253	
   254	def _kiem_chuyen(st: dict, den: str) -> None:
   255	    hien = st["state"]
   256	    if den not in CHUYEN_HOP_LE.get(hien, ()):
   257	        _die(
   258	            RC_STATE,
   259	            f"transition không hợp lệ: {hien} → {den} "
   260	            f"(hợp lệ từ {hien}: {', '.join(CHUYEN_HOP_LE.get(hien, ())) or 'không còn'})",
   261	        )
   262	
   263	
   264	def _tieu_thu_comment_id(st: dict, comment_id: str | None, cho: str) -> dict:
   265	    """Đòi một ID comment ĐÃ ĐĂNG KÝ, đúng transition, và CHƯA dùng.
   266	
   267	    Vì sao không kiểm URL bằng regex: vòng 1 nhận chuỗi bất kỳ, vòng 2 lọt ".."
   268	    và repo khác, vòng 3 lọt alias `pull`/`issues` và số 0 đứng đầu. Regex trên
   269	    URL không bao giờ chứng minh được comment CÓ THẬT — luôn còn một alias nữa.
   270	
   271	    KHAI THẲNG GIỚI HẠN: tiến trình này KHÔNG gọi mạng, nên nó KHÔNG xác minh
   272	    được ID có tồn tại trên GitHub hay không. Đây là SỔ TAY, không phải xác minh.
   273	    Thứ nó BẢO ĐẢM chỉ gồm hai điều, và đừng đọc nó rộng hơn thế:
   274	      1. ID phải được ghi vào sổ bằng `record-post` TRƯỚC — ID chưa từng ghi bị
   275	         từ chối, nên không dán đại một con số vào `transition` được;
   276	      2. mỗi ID dùng đúng MỘT lần cho ĐÚNG transition đã khai — không tái sử
   277	         dụng một comment thật để tiêu thụ hai transition.
   278	    """
   279	    if not comment_id:
   280	        _die(RC_TRACE, f"thiếu --comment-id: transition '{cho}' phải có dấu vết bền đã đăng")
   281	    so = st["posts"].get(comment_id)
   282	    if so is None:
   283	        _die(
   284	            RC_TRACE,
   285	            f"comment id {comment_id!r} chưa có trong sổ — đăng comment rồi ghi lại bằng "
   286	            f"`record-post --for {cho} --comment-id <id GitHub trả về>`",
   287	        )
   288	    if so["for"] != cho:
   289	        _die(
   290	            RC_TRACE,
   291	            f"comment id {comment_id!r} đã đăng ký cho transition {so['for']!r}, "
   292	            f"không dùng lại cho {cho!r} được",
   293	        )
   294	    if so["consumed_by"] is not None:
   295	        _die(
   296	            RC_TRACE,
   297	            f"comment id {comment_id!r} đã bị tiêu thụ bởi transition {so['consumed_by']!r} "
   298	            f"— mỗi ID chỉ dùng MỘT lần",
   299	        )
   300	    return so
   301	
