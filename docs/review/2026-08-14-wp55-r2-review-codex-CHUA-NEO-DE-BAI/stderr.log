   593	def cmd_doctrine_scan(a, state_dir: Path) -> int:
   594	    root = Path(a.root)
   595	    muc_tieu: list[Path] = []
   596	    skills = root / ".claude" / "skills"
   597	    if skills.is_dir():
   598	        muc_tieu.extend(sorted(skills.rglob("*.md")))
   599	    claude_md = root / "CLAUDE.md"
   600	    if claude_md.is_file():
   601	        muc_tieu.append(claude_md)
   602	    for extra in a.path or []:
   603	        muc_tieu.append(Path(extra))
   604	
   605	    dinh: list[tuple[str, str, str, int]] = []
   606	    for f in muc_tieu:
   607	        try:
   608	            raw = f.read_text(encoding="utf-8")
   609	        except (OSError, UnicodeDecodeError) as e:
   610	            _die(RC_ARG, f"không đọc được {f}: {e}")
   611	        phang, ban_do = _phang_ca_tep(raw)
   612	        for nhom, cum_list in FORBIDDEN_DOCTRINE_PHRASES.items():
   613	            for cum in cum_list:
   614	                kim = _chuan_hoa(cum)
   615	                if not kim:
   616	                    continue
   617	                tu = phang.find(kim)
   618	                while tu != -1:
   619	                    dinh.append((str(f), nhom, cum, _dong_tai(ban_do, tu)))
   620	                    tu = phang.find(kim, tu + len(kim))
   621	
   622	    if dinh:
   623	        for f, nhom, cum, i in dinh:
   624	            print(f"{f}:{i}: [{nhom}] chép doctrine: {cum!r}", file=sys.stderr)
   625	        _die(
   626	            RC_DOCTRINE,
   627	            f"{len(dinh)} chỗ chép doctrine trong adapter. Adapter chỉ được TRỎ về "
   628	            f"docs/PROTOCOL_DA_PHIEN.md, không nhắc lại nội dung ở đó.",
   629	        )
   630	    print(f"doctrine-scan: sạch — đã quét {len(muc_tieu)} tệp, 0 chỗ chép doctrine")
   631	    return RC_OK
