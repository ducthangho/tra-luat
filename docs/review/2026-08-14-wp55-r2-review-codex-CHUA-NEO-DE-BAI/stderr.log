   701	def case_doctrine_scan_bat_doctrine_THAT_tu_protocol(c: Ctx):
   702	    """Chép DÒNG THẬT từ docs/PROTOCOL_DA_PHIEN.md vào adapter ⇒ phải ĐỎ hết.
   703	
   704	    Đây là ca đắt nhất của bộ này. Bơm cụm từ do chính mình soạn chỉ chứng minh
   705	    danh sách khớp với chính nó; lấy dòng từ NGUỒN mới chứng minh nó phủ được
   706	    doctrine thật. Lần chạy đầu ca này bắt 4/9 — 5 dòng lọt CHỈ vì dấu nháy
   707	    ngược của Markdown (`merged`: … không khớp "merged: …"), đúng loại lỗ đã làm
   708	    ba lượt review trước trượt.
   709	
   710	    Ca này đọc protocol LÚC CHẠY, nên khi doctrine đổi câu chữ mà danh sách cấm
   711	    không theo, nó sẽ đỏ thay vì im lặng mục ruỗng.
   712	    """
   713	    proto = ROOT / "docs" / "PROTOCOL_DA_PHIEN.md"
   714	    if not proto.is_file():
   715	        raise AssertionError(f"thiếu {proto}")
   716	    neo = (
   717	        "| Dispatcher", "| Executor", "| Reviewer", "| Land Operator",
   718	        "| Người có thẩm quyền", "proposed →", "- `merged`", "- `integrated`",
   719	        "- `landed`", "- `complete`", "Mặc định: 3 attempt/packet",
   720	    )
   721	    dong = [
   722	        (i, l.strip())
   723	        for i, l in enumerate(proto.read_text(encoding="utf-8").splitlines(), 1)
   724	        if l.strip().startswith(neo) and len(l.strip()) >= 40
   725	    ]
   726	    if len(dong) < 8:
   727	        raise AssertionError(f"chỉ tìm được {len(dong)} dòng doctrine — mỏ neo có thể đã trôi")
   728	    lot = []
   729	    for n, (ln, s) in enumerate(dong):
   730	        r = _repo_gia(c.tmp, f"# Adapter\n\nĐọc trước: docs/PROTOCOL_DA_PHIEN.md.\n\n{s}\n",
   731	                      ten=f"that{n}")
   732	        rc, _, _ = run(c.script, ["doctrine-scan", "--root", r])
   733	        if rc != 6:
   734	            lot.append(f"protocol:{ln} rc={rc} :: {s[:80]}")
   735	    if lot:
   736	        raise AssertionError(
   737	            f"{len(lot)}/{len(dong)} dòng doctrine THẬT lọt lưới:\n  " + "\n  ".join(lot)
   738	        )
