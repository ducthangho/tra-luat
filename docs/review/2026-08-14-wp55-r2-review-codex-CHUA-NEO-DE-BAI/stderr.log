   645	def build_parser() -> argparse.ArgumentParser:
   646	    p = argparse.ArgumentParser(
   647	        prog="packet_loop.py",
   648	        description=(
   649	            "Cưỡng chế vài stop condition của work packet bằng mã thoát. "
   650	            "Quy tắc đầy đủ ở docs/PROTOCOL_DA_PHIEN.md — tệp này không nhắc lại chúng."
   651	        ),
   652	        epilog=(
   653	            "Mã thoát: 0 ok · 2 sai đối số · 3 chạm trần · 4 sai provider · "
   654	            "5 dấu vết comment không hợp lệ · 6 adapter chép doctrine · "
   655	            "7 hành vi bị chặn cứng · 8 trạng thái không hợp lệ."
   656	        ),
   657	    )
   658	    p.add_argument("--state-dir", default=".claude/.packet_state", help="nơi giữ state cục bộ")
   659	    sub = p.add_subparsers(dest="cmd", required=True)
   660	
   661	    q = sub.add_parser("init", help="khởi tạo state cho một packet")
   662	    q.add_argument("--packet", type=int, required=True)
   663	    q.add_argument("--mission", type=int, required=True)
   664	    q.add_argument("--executor", required=True)
   665	    q.add_argument("--reviewer", required=True)
   666	    q.add_argument("--attempts-limit", type=int, default=MAC_DINH_TRAN_ATTEMPT)
   667	    q.add_argument("--same-failure-limit", type=int, default=MAC_DINH_TRAN_SAME_FAILURE)
   668	    q.set_defaults(fn=cmd_init)
   669	
   670	    q = sub.add_parser("begin-attempt", help="mở một lượt executor")
   671	    q.add_argument("--packet", type=int, required=True)
   672	    q.add_argument("--provider", required=True)
   673	    q.set_defaults(fn=cmd_begin_attempt)
   674	
   675	    q = sub.add_parser("void-attempt", help="hoàn lượt vì lỗi hạ tầng/quota")
   676	    q.add_argument("--packet", type=int, required=True)
   677	    q.add_argument("--reason", required=True, help=f"một trong {LY_DO_VOID}")
   678	    q.set_defaults(fn=cmd_void_attempt)
   679	
   680	    q = sub.add_parser("record-review", help="ghi một lượt review")
   681	    q.add_argument("--packet", type=int, required=True)
   682	    q.add_argument("--provider", required=True)
   683	    q.add_argument("--verdict", required=True, choices=("approve", "changes_requested", "blocked"))
   684	    q.add_argument("--reviewed-sha", help="exact head đã đọc; phải khớp head đưa ra review")
   685	    q.add_argument(
   686	        "--finding-id",
   687	        action="append",
   688	        help="slug kebab-case ổn định, ví dụ url-alias. Lặp lại được. Đây là KHOÁ đếm.",
   689	    )
   690	    q.add_argument(
   691	        "--finding-desc",
   692	        action="append",
   693	        help="mô tả tự do, CHỈ để đọc — không tham gia phép đếm.",
   694	    )
   695	    q.set_defaults(fn=cmd_record_review)
   696	
   697	    q = sub.add_parser("transition", help="chuyển state, đòi dấu vết comment bền")
   698	    q.add_argument("--packet", type=int, required=True)
   699	    q.add_argument("--to", required=True)
   700	    q.add_argument("--comment-id", help="ID GitHub trả về, đã ghi sổ bằng record-post")
   701	    q.add_argument("--head-sha", help="bắt buộc khi --to reviewing: exact head đưa ra review")
   702	    q.set_defaults(fn=cmd_transition)
   703	
   704	    q = sub.add_parser("record-post", help="ghi sổ ID comment GitHub trả về lúc đăng")
   705	    q.add_argument("--packet", type=int, required=True)
   706	    q.add_argument("--for", dest="For", required=True, help="transition mà comment này chứng minh")
   707	    q.add_argument("--comment-id", required=True)
   708	    q.set_defaults(fn=cmd_record_post)
   709	
   710	    q = sub.add_parser("next-comment", help="in văn bản comment để người đăng")
   711	    q.add_argument("--packet", type=int, required=True)
   712	    q.set_defaults(fn=cmd_next_comment)
   713	
   714	    q = sub.add_parser("guard", help="chặn cứng hành vi ngoài vai executor")
   715	    q.add_argument("--action", required=True, choices=HANH_VI_CHAN)
   716	    q.set_defaults(fn=cmd_guard)
   717	
   718	    q = sub.add_parser("doctrine-scan", help="bắt adapter chép doctrine")
   719	    q.add_argument("--root", default=".")
   720	    q.add_argument("--path", action="append", help="quét thêm tệp cụ thể")
   721	    q.set_defaults(fn=cmd_doctrine_scan)
   722	
   723	    q = sub.add_parser("status", help="in state đầy đủ")
   724	    q.add_argument("--packet", type=int, required=True)
   725	    q.set_defaults(fn=cmd_status)
   726	
   727	    sub.add_parser("where", help="in thư mục state").set_defaults(fn=cmd_where)
   728	    return p
