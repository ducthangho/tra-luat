   750	def _kich_ban_in(c: Ctx, codepage: str):
   751	    """Chạy MỌI lệnh in tiếng Việt với stdout BỊ CAPTURE và encoding ép về codepage."""
   752	    env = {"PYTHONIOENCODING": codepage}
   753	    sd = c.sd()
   754	    r = _repo_gia(c.tmp, SACH, ten=f"cp{codepage}")
   755	
   756	    buoc = [
   757	        (["where"], None),
   758	        (["init", "--packet", 55, "--mission", 54,
   759	          "--executor", EXECUTOR, "--reviewer", REVIEWER], sd),
   760	        (["begin-attempt", "--packet", 55, "--provider", EXECUTOR], sd),
   761	        (["next-comment", "--packet", 55], sd),
   762	        (["record-post", "--packet", 55, "--for", "reviewing", "--comment-id", "7770000009"], sd),
   763	        (["transition", "--packet", 55, "--to", "reviewing", "--comment-id", "7770000009",
   764	          "--head-sha", "%040x" % 1], sd),
   765	        (["record-review", "--packet", 55, "--provider", REVIEWER, "--verdict", "changes_requested",
   766	          "--reviewed-sha", "%040x" % 1,
   767	          "--finding-id", "loi-co-dau-tieng-viet", "--finding-desc", "mô tả có dấu tiếng Việt"], sd),
   768	        (["status", "--packet", 55], sd),
   769	        (["doctrine-scan", "--root", r], None),
   770	    ]
   771	    for args, state_dir in buoc:
   772	        rc, o, e = run(c.script, args, state_dir, env_extra=env)
   773	        ten = args[0]
   774	        if rc != 0:
   775	            raise AssertionError(
   776	                f"[{codepage}] lệnh {ten!r} phải rc=0 khi stdout bị capture, được rc={rc}; "
   777	                f"stderr={_txt(e)!r}"
   778	            )
   779	        if not o.strip():
   780	            raise AssertionError(f"[{codepage}] lệnh {ten!r} rc=0 nhưng stdout RỖNG")
   781	
   782	
