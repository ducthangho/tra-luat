   304	
   305	
   306	def cmd_init(a, state_dir: Path) -> int:
   307	    if a.executor not in PROVIDERS or a.reviewer not in PROVIDERS:
   308	        _die(RC_ARG, f"provider phải thuộc {PROVIDERS}")
   309	    # Cross-provider: chặn NGAY từ init, không đợi tới lúc ghi review.
   310	    if a.executor == a.reviewer:
   311	        _die(
   312	            RC_PROVIDER,
   313	            f"executor và reviewer cùng là {a.executor!r} — mặc định phải khác nền "
   314	            f"(mức assurance khác nhau, xem protocol §8)",
   315	        )
   316	    p = _state_path(state_dir, a.packet)
   317	    # KHÔNG có `--force-new`, và đừng thêm lại. Cờ đó ghi đè state cũ nên nó xoá
   318	    # sạch attempts_used/finding_counts và đưa một packet ĐÃ blocked về leased —
   319	    # tức là đường vòng qua đúng cái trần mà tệp này tồn tại để cưỡng chế. Tiến
   320	    # trình này không biết revision/generation và không có uỷ quyền của bên điều
   321	    # phối, nên nó KHÔNG phân biệt được reroute hợp lệ với hồi sinh một lease đã
   322	    # cạn. Reroute là việc của bên điều phối: cấp generation mới với state-dir mới.
   323	    if p.exists():
   324	        _die(
   325	            RC_STATE,
   326	            f"state đã tồn tại: {p}. Không ghi đè — reroute phải là generation mới "
   327	            f"do bên điều phối cấp, với --state-dir mới.",
   328	        )
   329	    st = {
   330	        "schema_version": 1,
   331	        "packet": a.packet,
   332	        "mission": a.mission,
   333	        "executor": a.executor,
   334	        "reviewer": a.reviewer,
   335	        "state": "leased",
   336	        "attempts_used": 0,
   337	        "attempts_limit": a.attempts_limit,
   338	        "same_failure_limit": a.same_failure_limit,
   339	        "finding_counts": {},
   340	        "attempt_open": False,
   341	        "reviewing_head_sha": None,
   342	        "accepted_sha": None,
   343	        "reviews": [],
   344	        "posts": {},
   345	        "history": [],
   346	    }
   347	    _save(state_dir, st)
   348	    print(
   349	        f"đã khởi tạo packet {a.packet} (mission {a.mission}) — "
   350	        f"executor {a.executor}, reviewer {a.reviewer}, state {st['state']}"
   351	    )
   352	    return RC_OK
   353	
   354	
   355	def cmd_begin_attempt(a, state_dir: Path) -> int:
   356	    st = _load(state_dir, a.packet)
   357	    if a.provider != st["executor"]:
   358	        _die(
   359	            RC_PROVIDER,
   360	            f"provider {a.provider!r} không phải executor của packet này ({st['executor']!r})",
   361	        )
   362	    # Lượt đầu đi từ 'leased'; lượt rework đi từ 'running' sau changes_requested.
   363	    if st["state"] not in ("leased", "running"):
   364	        _die(RC_STATE, f"không mở được lượt từ state {st['state']!r}")
   365	    # Một lượt ĐANG MỞ thì không mở thêm được. Thiếu chốt này, gõ `begin-attempt`
   366	    # bốn lần liên tiếp sẽ đốt sạch trần dù chưa lượt nào chạy xong — trần bị
   367	    # tiêu bởi thao tác lặp, không phải bởi công việc thật.
   368	    if st["attempt_open"]:
   369	        _die(
   370	            RC_STATE,
   371	            f"lượt {st['attempts_used']} đang mở — đóng nó bằng một review trước đã. "
   372	            f"Gọi lại begin-attempt không mở lượt mới và không tiêu thêm trần.",
   373	        )
   374	    if st["attempts_used"] >= st["attempts_limit"]:
   375	        st["state"] = "blocked"
   376	        st["history"].append({"event": "blocked_attempts_exhausted", "at_attempt": st["attempts_used"]})
   377	        _save(state_dir, st)
   378	        _die(
   379	            RC_TRAN,
   380	            f"đã dùng hết {st['attempts_used']}/{st['attempts_limit']} lượt — packet về blocked. "
   381	            f"Ghi failure evidence + handoff rồi dừng; reroute là việc của bên điều phối.",
   382	        )
   383	    st["attempts_used"] += 1
   384	    st["state"] = "running"
   385	    st["attempt_open"] = True
   386	    # Head cũ hết hiệu lực ngay khi mở lượt mới: có commit mới thì bản duyệt
   387	    # trước không còn nói về cây đang có nữa.
   388	    st["reviewing_head_sha"] = None
   389	    st["history"].append({"event": "begin_attempt", "attempt": st["attempts_used"]})
   390	    _save(state_dir, st)
   391	    print(f"bắt đầu lượt {st['attempts_used']}/{st['attempts_limit']} — state {st['state']}")
   392	    return RC_OK
   393	
   394	
   395	def cmd_void_attempt(a, state_dir: Path) -> int:
   396	    st = _load(state_dir, a.packet)
   397	    if a.reason not in LY_DO_VOID:
   398	        _die(RC_ARG, f"lý do {a.reason!r} không thuộc allowlist {LY_DO_VOID}")
   399	    if st["attempts_used"] <= 0:
   400	        _die(RC_STATE, "chưa có lượt nào để hoàn")
   401	    # Lượt ĐÃ được review thì không hoàn được — nếu không, mọi lượt hỏng đều
   402	    # biến thành "quota" và trần trở thành trang trí.
   403	    if st["reviews"] and st["reviews"][-1]["attempt"] == st["attempts_used"]:
   404	        _die(
   405	            RC_STATE,
   406	            f"lượt {st['attempts_used']} đã có review — không hoàn được lượt đã tiêu thụ nội dung",
   407	        )
   408	    st["attempts_used"] -= 1
   409	    # Đóng luôn lượt đang mở. Thiếu dòng này thì hoàn lượt vì quota lại KHOÁ CỨNG
   410	    # packet: trần đã trả về nhưng `attempt_open` còn bật nên không mở lại được
   411	    # lượt nào — biến một lỗi hạ tầng tạm thời thành ngõ cụt vĩnh viễn.
   412	    st["attempt_open"] = False
   413	    st["history"].append({"event": "void_attempt", "reason": a.reason})
   414	    _save(state_dir, st)
   415	    print(f"đã hoàn một lượt vì {a.reason} — còn dùng {st['attempts_used']}/{st['attempts_limit']}")
   416	    return RC_OK
   417	
   418	
   419	def cmd_record_review(a, state_dir: Path) -> int:
   420	    st = _load(state_dir, a.packet)
   421	    if st["state"] != "reviewing":
   422	        _die(RC_STATE, f"chỉ ghi review khi state là 'reviewing' (đang là {st['state']!r})")
   423	    if a.provider != st["reviewer"]:
   424	        _die(
   425	            RC_PROVIDER,
   426	            f"reviewer {a.provider!r} sai nền — packet này đòi {st['reviewer']!r}",
   427	        )
   428	
   429	    # Bản duyệt phải neo ĐÚNG head đã đưa ra review. Không có chốt này thì
   430	    # `approve` đưa packet sang 'accepted' mà chẳng nói về commit nào — và một
   431	    # commit chưa ai đọc vẫn được coi là đã duyệt.
   432	    if not a.reviewed_sha:
   433	        _die(RC_TRACE, "record-review phải khai --reviewed-sha (exact head đã đọc)")
   434	    if not SHA_RE.match(a.reviewed_sha):
   435	        _die(RC_TRACE, f"--reviewed-sha {a.reviewed_sha!r} phải là git oid 40 ký tự hex thường")
   436	    if a.reviewed_sha != st["reviewing_head_sha"]:
   437	        _die(
   438	            RC_TRACE,
   439	            f"--reviewed-sha {a.reviewed_sha} KHÔNG khớp head đã đưa ra review "
   440	            f"({st['reviewing_head_sha']}). Head đổi ⇒ bản duyệt cũ hết hiệu lực, "
   441	            f"phải vào lại 'reviewing' với head mới.",
   442	        )
   443	
   444	    ids = list(a.finding_id or [])
   445	    if a.verdict == "changes_requested" and not ids:
   446	        _die(RC_ARG, "verdict changes_requested phải có ít nhất một --finding-id SLUG")
   447	    for fid in ids:
   448	        if not SLUG_RE.match(fid):
   449	            _die(
   450	                RC_ARG,
   451	                f"--finding-id {fid!r} sai dạng slug kebab-case (^[a-z0-9]+(-[a-z0-9]+)*$). "
   452	                f"KHÔNG tự suy ID từ mô tả — ID phải do reviewer khai.",
   453	            )
   454	
   455	    # (c) cùng ID lặp TRONG MỘT review chỉ tính MỘT lần: dedup trước khi đếm.
   456	    # Không có bước này thì reviewer nhắc lại một lỗi hai lần trong cùng một
   457	    # lượt sẽ chặn oan ngay lượt đầu — đúng lỗi đã đo ở vòng 3.
   458	    ids_duy_nhat = sorted(set(ids))
   459	
   460	    st["attempt_open"] = False
   461	    st["reviews"].append(
   462	        {
   463	            "attempt": st["attempts_used"],
   464	            "provider": a.provider,
   465	            "verdict": a.verdict,
   466	            "reviewed_sha": a.reviewed_sha,
   467	            "finding_ids": ids_duy_nhat,
   468	            # (d) mô tả CHỈ để đọc. Nó không tham gia phép đếm, nên hai mô tả
   469	            # khác nhau cùng một ID vẫn là một finding.
   470	            "finding_descs": list(a.finding_desc or []),
   471	        }
   472	    )
   473	
   474	    cham_tran = []
   475	    for fid in ids_duy_nhat:
   476	        st["finding_counts"][fid] = st["finding_counts"].get(fid, 0) + 1
   477	        if st["finding_counts"][fid] >= st["same_failure_limit"]:
   478	            cham_tran.append(fid)
   479	
   480	    if cham_tran:
   481	        st["state"] = "blocked"
   482	        st["history"].append({"event": "blocked_same_failure", "finding_ids": cham_tran})
   483	        _save(state_dir, st)
   484	        chi_tiet = ", ".join(f"{f}×{st['finding_counts'][f]}" for f in cham_tran)
   485	        _die(
   486	            RC_TRAN,
   487	            f"cùng finding-id lặp tới trần ({chi_tiet}; trần {st['same_failure_limit']}) "
   488	            f"— packet về blocked. Lặp lại nghĩa là bản vá không trúng gốc; "
   489	            f"ghi failure evidence + handoff rồi dừng.",
   490	        )
   491	
   492	    st["state"] = {"approve": "accepted", "changes_requested": "running", "blocked": "blocked"}[a.verdict]
   493	    if a.verdict == "approve":
   494	        st["accepted_sha"] = a.reviewed_sha
   495	    st["history"].append(
   496	        {"event": "record_review", "verdict": a.verdict,
   497	         "reviewed_sha": a.reviewed_sha, "finding_ids": ids_duy_nhat}
   498	    )
   499	    _save(state_dir, st)
   500	    print(
   501	        f"đã ghi review {a.verdict} bởi {a.provider} — "
   502	        f"{len(ids_duy_nhat)} finding, state {st['state']}"
   503	    )
   504	    return RC_OK
   505	
   506	
   507	def cmd_transition(a, state_dir: Path) -> int:
   508	    st = _load(state_dir, a.packet)
   509	    # Chặn TƯỜNG MINH trước khi tra bảng, để thông điệp nói đúng lý do thay vì
   510	    # rơi vào lỗi "transition không hợp lệ" chung chung.
   511	    if a.to in STATE_CHI_DO_REVIEW_GHI:
   512	        _die(
