{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatGPTReviewBundleManifestV1",
  "type": "object",
  "required": [
    "schema",
    "bundle_id",
    "packet_id",
    "base_sha",
    "head_sha",
    "tree_sha",
    "write_set",
    "review_class",
    "files",
    "created_at_utc",
    "builder_version"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "chatgpt_review_bundle.v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "write_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_class": {
      "type": "string",
      "enum": [
        "routine",
        "systemic",
        "sensitive"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "created_at_utc": {
      "type": "string"
    },
    "builder_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
