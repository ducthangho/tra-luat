+@ca
+def r1077_cwd_dai_khong_keo_dai_duong_da_chay_duoc():
+    """F4 lượt 5: tên tương đối ngắn vẫn chạy được khi cwd vượt PATH_MAX."""
+    if platform.system() != "Linux":
+        return "BO QUA can getcwd Linux dai hon PATH_MAX"
+    from unittest.mock import patch
+    m = _tai_launcher_thu()
+    with San() as d:
+        goc_fd = os.open(".", os.O_RDONLY)
+        try:
+            os.chdir(d)
+            while len(os.getcwd()) < 4200:
+                ten = "a" * 220
+                os.mkdir(ten)
+                os.chdir(ten)
+            env = {"PATH": ".", "LANG": "C.UTF-8", "TL_LAUNCHER_ENV_DA_DOC": "1"}
+            for shebang in (True, False):
+                _wp1077_tep(Path("."), "llm", ("#!/bin/sh\n" if shebang else "") +
+                             'case "$1" in --version) echo llm-FIRST;; keys) echo openai;; esac\n')
+                with patch.dict(os.environ, env, clear=True):
+                    try:
+                        kq = m._do_openai_llm(env, False)
+                    except (OSError, subprocess.SubprocessError) as e:
+                        kq = (type(e).__name__, getattr(e, "errno", None))
+                bang(kq[0] == "CO_CREDENTIAL" and "llm-FIRST" in kq[1],
+                     f"cwd dai lam hong ten tuong doi ngan, shebang={shebang}: {kq}")
+        finally:
+            os.fchdir(goc_fd)
+            os.close(goc_fd)
