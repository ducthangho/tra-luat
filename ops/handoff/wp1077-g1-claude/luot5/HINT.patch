+@ca
+def r1077_PATH_tuong_doi_giu_dollar_zero():
+    """F4 lượt 5: PATH tương đối giữ $0 mà bash/execvp truyền cho wrapper POSIX."""
+    if LA_WINDOWS:
+        return "BO QUA shell POSIX"
+    from unittest.mock import patch
+    m = _tai_launcher_thu()
+    with San() as d:
+        _wp1077_tep(d / "bin", "llm", 'case "$0" in bin/llm) ;; *) exit 42;; esac\n'
+                     'case "$1" in --version) echo llm-FIRST;; keys) echo openai;; esac\n')
+        env = {"PATH": "bin", "LANG": "C.UTF-8", "TL_LAUNCHER_ENV_DA_DOC": "1"}
+        with contextlib.chdir(d), patch.dict(os.environ, env, clear=True):
+            try:
+                kq = m._do_openai_llm(env, False)
+            except (OSError, subprocess.SubprocessError) as e:
+                kq = (type(e).__name__, str(e))
+        bang(kq[0] == "CO_CREDENTIAL" and "llm-FIRST" in kq[1],
+             f"$0 tuong doi bi doi thanh tuyet doi: {kq}")
