+        for bin_ in (odd, d / "ascii"):
+            _wp1077_llm_tep(bin_, "BYTES", shebang=True)
+            with (bin_ / "llm").open("a") as f:
+                f.write('case "$1" in prompt) echo ok;; esac\n')
