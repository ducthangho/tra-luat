+                   "TL_LAUNCHER_ENV_DA_DOC": "1"}
+            m.CONG_CU = [c for c in m.CONG_CU if c["ten"] == "llm"]
+            m.MODULE_PY = []
+            m.KHA_NANG = [k for k in m.KHA_NANG if k["ten"] == "openai-llm"]
+            m._doc_moi_truong = lambda: (env, {"da_doc_truoc_cong_cu": True})
+            m.tim_workspace = lambda _: None
+            m._chuan_bi_va_bo_snapshot = lambda: None
