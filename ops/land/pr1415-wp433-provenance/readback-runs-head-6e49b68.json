   "display_title": "wp433 P2a: credentials.json của gws (W4, W5) trên POSIX nằm ngoài kho git, không xuyên liên kết, ghi nguyên tử",
   "event": "pull_request_target",
   "head_branch": "agent/wp433-r2-g1-claude",
   "head_commit": {
    "author": {
