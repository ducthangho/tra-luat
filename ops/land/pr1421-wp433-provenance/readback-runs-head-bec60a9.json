   "display_title": "wp433 P2b: dữ liệu W6 (token, webappUrl, config) được kiểm trước khi gán env và trước khi ghi",
   "event": "pull_request_target",
   "head_branch": "agent/wp433-r3-g1-claude",
   "head_commit": {
