+def _khoi_bash_chua(txt: str, dau_hieu: str, ten_tep: str) -> str:
+    """Lấy NGUYÊN VĂN thân khối ``` đầu tiên có chứa `dau_hieu`.
+
+    Bóc từ tệp thay vì chép lại vào suite: chép lại là dựng bản sao, và bản sao
+    trôi lệch — đúng cái bẫy mà chính adapter này đã dính ba lượt liền.
+    """
+    dong = txt.splitlines()
+    i = 0
+    while i < len(dong):
+        if dong[i].lstrip().startswith("```"):
+            j = i + 1
+            while j < len(dong) and not dong[j].lstrip().startswith("```"):
+                j += 1
+            than = "\n".join(dong[i + 1:j])
+            if dau_hieu in than:
+                return than
+            i = j + 1
+            continue
+        i += 1
+    raise AssertionError(f"{ten_tep}: không tìm thấy khối lệnh nào chứa {dau_hieu!r}")
+
