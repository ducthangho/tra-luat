+    # --- lớp 2: HÀNH VI. Bơm giá trị giả, chạy ĐÚNG lệnh trong adapter, đòi giá
+    # trị không lọt ra stdout LẪN stderr (vết `set -x` cũng đi vào transcript).
+    sh = shutil.which("bash") or shutil.which("sh")
+    if sh is None:  # nền không có shell POSIX — lớp 1 vẫn đã chốt hình dạng
+        return
+    env = os.environ.copy()
+    env["TEN_BIEN"] = BI_MAT_GIA
+    p = subprocess.run([sh, "-c", lenh], capture_output=True, env=env)
+    ra = _txt(p.stdout) + "\n" + _txt(p.stderr)
