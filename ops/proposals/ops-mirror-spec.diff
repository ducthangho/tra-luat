@@ -0,0 +1,140 @@
+name: ops — chiếu spec lên thân Issue bằng git
+
+# Cùng lý do với `ops-publish-lease.yml`: thân Issue là CSDL riêng của GitHub, git
+# không ghi được. Nhưng push thì phiên nào cũng làm được. ĐÃ ĐO 14/15-08-2026: phiên
+# agent bị 403 ở MỌI lời gọi api.github.com (REST lẫn GraphQL, có token lẫn không)
+# trong khi clone/fetch/push đều chạy.
+#
+# ⚠ KHÁC `ops-publish-lease.yml` MỘT ĐIỂM QUYẾT ĐỊNH — đọc kỹ trước khi duyệt:
+# cửa lease chỉ THÊM comment (`POST …/issues/N/comments`), sai thì bản cũ còn nguyên.
+# Cửa này GHI ĐÈ thân issue (`PATCH …/issues/N`): một lượt chạy sai XOÁ SẠCH văn bản
+# người ta gõ tay, và trong kho không có bản sao để dựng lại. Vì thế có hai chốt mà
+# cửa lease không cần, cả hai nằm trong `ops/mirror_spec.py` để test được:
+#   A. QUYỀN SỞ HỮU — chỉ ghi khi thân RỖNG hoặc đã mang dấu `<!-- ops-mirror-spec v1`.
+#      Thân do người viết mà không có dấu thì TỪ CHỐI. Không "hợp nhất thông minh".
+#   B. IDEMPOTENT THEO NỘI DUNG — thân mới trùng thân cũ thì KHÔNG gọi PATCH.
+#
+# NĂM LỚP THU HẸP:
+#   1. Chỉ nhánh `ops/**`, chỉ đường dẫn `ops/specs/**-than-issue.md`.
+#   2. OPT-IN TƯỜNG MINH: commit cuối phải mang `[mirror-spec]`. Sửa spec là chuyện
+#      thường; ghi đè thân issue thì không — đừng tự đoán.
+#   3. `permissions` tối thiểu: `issues: write` + `contents: read`. KHÔNG
+#      `contents: write` (cửa này không ghi ngược gì vào kho), KHÔNG `pull-requests`,
+#      KHÔNG `actions`.
+#   4. Bộ kiểm NEO VÀO NHÁNH MẶC ĐỊNH, không lấy từ head được đẩy.
+#   5. Chốt A + B ở trên, cộng ĐỌC LẠI đối chiếu byte sau khi ghi.
+#
+# VÌ SAO CÓ LỚP 4 — kế thừa nguyên văn finding P1 của cross-review trên PR #104:
+# **bộ kiểm nằm cùng nhánh với thứ nó kiểm thì nó không kiểm gì hết.** Một push vào
+# `ops/**` vừa sửa bản chiếu vừa sửa bộ kiểm sẽ qua trơn nếu `checkout` lấy head đó.
+#
+# NÓI THẲNG PHẦN CÒN THỦNG — đừng để ai đọc rộng hơn thực tế:
+# với sự kiện `push`, GitHub lấy CHÍNH TỆP YAML NÀY từ head được đẩy. Ai sửa được
+# `ops/mirror_spec.py` thì cũng sửa được tệp này và gỡ luôn mỏ neo lớp 4. Thứ đóng
+# nốt phần còn lại nằm NGOÀI kho: ruleset/branch protection chặn push vào
+# `.github/workflows/**` và `ops/mirror_spec*.py`. **Chưa đặt ruleset thì đường này
+# vẫn quy về "ai push được vào `ops/**` thì GHI ĐÈ được thân issue"** — và với một
+# cửa ghi đè, câu đó nặng hơn hẳn cửa chỉ thêm comment. Cứ nói đúng như vậy.
+#
+# PHÚT ACTIONS: job ubuntu (hệ số 1x), vài giây, không matrix.
+
+on:
+  push:
+    branches: ['ops/**']
+    paths:
+      - 'ops/specs/**-than-issue.md'
+
+permissions:
+  contents: read
+  issues: write
+
+concurrency:
+  group: ops-mirror-spec-${{ github.ref }}
+  cancel-in-progress: false   # đang GHI ĐÈ thì không huỷ giữa chừng
+
+jobs:
+  chieu:
+    # Lọc ngay ở đây để lượt không khớp KHÔNG tốn runner.
+    if: contains(github.event.head_commit.message, '[mirror-spec]')
+    runs-on: ubuntu-latest
+    steps:
+      - name: lấy head được đẩy (NỘI DUNG cần chiếu)
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: lấy NHÁNH MẶC ĐỊNH (BỘ KIỂM — lớp 4)
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.repository.default_branch }}
+          path: _goc
+
+      - name: phản chứng của chính bộ kiểm phải XANH trước
+        run: python3 _goc/ops/mirror_spec_test.py
+
+      - name: chiếu từng bản chiếu ĐÃ ĐỔI trong lượt push này
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPO: ${{ github.repository }}
+          NEO: ${{ github.workspace }}/_goc
+          TRUOC: ${{ github.event.before }}
+          SAU: ${{ github.event.after }}
+        run: |
+          set -euo pipefail
+          # Chỉ tệp ĐỔI trong lượt push này, không quét cả cây: một push không được
+          # kéo theo mọi bản chiếu cũ cùng bị ghi lại.
+          if [ "$TRUOC" = "0000000000000000000000000000000000000000" ]; then
+            DS=$(git show --name-only --pretty=format: "$SAU" \
+                 | grep -E '^ops/specs/.*-than-issue\.md$' || true)
+          else
+            DS=$(git diff --name-only "$TRUOC" "$SAU" -- 'ops/specs/*-than-issue.md' || true)
+          fi
+          if [ -z "$DS" ]; then
+            echo "không có bản chiếu nào đổi — bỏ qua"
+            exit 0
+          fi
+
+          # Vòng `for` chứ không `... | while read`: pipe chạy ở subshell nên `exit 1`
+          # trong đó KHÔNG làm job đỏ — lỗi sẽ đi lọt trong im lặng.
+          for tep in $DS; do
+            if [ ! -f "$tep" ]; then
+              echo "bỏ qua $tep (đã xoá trong lượt này)"
+              continue
+            fi
+            echo "::group::$tep"
+
+            # KIỂM bằng bộ kiểm của NHÁNH MẶC ĐỊNH, đọc nội dung từ head được đẩy.
+            python3 "$NEO/ops/mirror_spec.py" check "$tep" --root .
+            python3 "$NEO/ops/mirror_spec.py" body  "$tep" --root . > than-moi.md
+            ISSUE=$(python3 "$NEO/ops/mirror_spec.py" issue "$tep" --root .)
+
+            # Chốt A — QUYỀN SỞ HỮU. Đọc thân hiện tại rồi mới quyết.
+            gh api "repos/$REPO/issues/$ISSUE" --jq '.body // ""' > than-cu.md
+            python3 "$NEO/ops/mirror_spec.py" guard --than-cu than-cu.md --issue "$ISSUE"
+
+            # Chốt B — IDEMPOTENT theo NỘI DUNG.
+            if cmp -s than-cu.md than-moi.md; then
+              echo "thân #$ISSUE đã đúng nội dung — KHÔNG gọi PATCH"
+              echo "::endgroup::"
+              continue
+            fi
+
+            python3 -c "import json,sys;print(json.dumps({'body':open(sys.argv[1],encoding='utf-8').read()}))" \
+              than-moi.md > payload.json
+            gh api -X PATCH "repos/$REPO/issues/$ISSUE" --input payload.json --jq '.number' >/dev/null
+            echo "đã chiếu $tep → thân issue #$ISSUE"
+
+            # ĐỌC LẠI để xác nhận — không tin mã trả về suông. Đường đăng của kho này
+            # ĐÃ TỪNG làm biến dạng ký tự (thân #55 còn `&#34;` nguyên văn ở đúng chỗ
+            # đáng ra là dấu nháy kép), nên phải đối chiếu BYTE sau khi ghi chứ không
+            # khai "đã đăng" rồi thôi. Đây chính là lý do wp55 r3 bỏ "băm thân Issue".
+            gh api "repos/$REPO/issues/$ISSUE" --jq '.body // ""' > than-doc-lai.md
+            if cmp -s than-doc-lai.md than-moi.md; then
+              echo "đọc lại KHỚP BYTE ✓"
+            else
+              echo "⚠ đọc lại LỆCH — đường đăng làm biến dạng nội dung:"
+              diff than-moi.md than-doc-lai.md | head -20 || true
+              exit 1
+            fi
+            echo "::endgroup::"
+          done
