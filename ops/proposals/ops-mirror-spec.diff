+}
+
+
+def _chay_bo(script: Path, chi_chay=None) -> dict:
+    ket = {}
+    for fn in CA:
+        if chi_chay and fn.__name__ not in chi_chay:
+            continue
+        try:
+            fn.__globals__["CANONICAL"] = script
+            fn()
+            ket[fn.__name__] = None
+        except Exception as ex:  # noqa: BLE001 — ca đỏ là dữ liệu, không phải sự cố
+            ket[fn.__name__] = f"{type(ex).__name__}: {ex}"
+    fn.__globals__["CANONICAL"] = HERE / "mirror_spec.py"
+    return ket
+
+
+def main() -> int:
+    goc_src = CANONICAL.read_text(encoding="utf-8")
+    hong_tong = 0
+
+    ket = _chay_bo(CANONICAL)
+    dat = sum(1 for v in ket.values() if v is None)
+    for ten, ly in ket.items():
+        if ly:
+            print(f"  ĐỎ  {ten}: {ly}")
+    print(f"nền: {dat}/{len(ket)} đạt")
+    hong_tong += len(ket) - dat
+
+    print("\ntự chứng minh suite KHÔNG RỖNG (gỡ chốt ⇒ ca tương ứng phải ĐỎ):")
+    with tempfile.TemporaryDirectory(prefix="mirror_spec_mut_") as td:
+        for ten_mut, (tim, thay, phai_chet) in DOT_BIEN.items():
+            if tim not in goc_src:
+                print(f"  ĐỎ  đột biến {ten_mut}: không tìm thấy mỏ neo {tim!r}")
+                hong_tong += 1
+                continue
+            d = Path(td) / ten_mut
+            d.mkdir(parents=True, exist_ok=True)
+            mut = d / "mirror_spec.py"
+            mut.write_text(goc_src.replace(tim, thay, 1), encoding="utf-8", newline="\n")
+            km = _chay_bo(mut, chi_chay=set(phai_chet))
+            song = [t for t in phai_chet if km.get(t) is None]
+            if song:
+                print(f"  ĐỎ  đột biến {ten_mut}: ca {song} VẪN XANH ⇒ ca đó không đo gì")
+                hong_tong += len(song)
+            else:
+                print(f"  ok  {ten_mut} → giết {len(phai_chet)}/{len(phai_chet)} ca: "
+                      f"{', '.join(phai_chet)}")
+
+    print(f"\nmirror_spec: {'ĐẠT' if hong_tong == 0 else f'{hong_tong} lỗi'}")
+    return 0 if hong_tong == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
