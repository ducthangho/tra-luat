+def kiem_symlink_treo_ca_cay(kho=ROOT) -> list[str]:
+    """`t82` quét CẢ cây, nên chốt phải quét CẢ cây — `kiem_loai_tep` chỉ nhìn tệp ĐỔI trong diff. Symlink HỢP LỆ vào
+    cây qua một PR đầy đủ (vd `docs/x.md -> ../ops/specs/D.md`, ngoài allowlist nên không qua `kiem-re`) thành TREO khi
+    một PR hồ sơ XOÁ đích: symlink không nằm trong diff, `kiem_loai_tep` không thấy, `t82` bị bỏ ⇒ PR xanh, master ĐỎ.
+    Bỏ qua đúng những gì `t82` bỏ qua (`.git`, `__pycache__`, `*.pyc`). Không đọc được thư mục ⇒ ĐỎ (không nuốt)."""
+    import fnmatch
+    loi = []
+
+    def bo_qua(ten):
+        return ten in (".git", "__pycache__") or fnmatch.fnmatch(ten, "*.pyc")
+
+    def khong_doc_duoc(e):
+        loi.append(f"KHONG DO DUOC: khong duyet duoc cay de tim symlink treo: {type(e).__name__}: {getattr(e, 'filename', '')!r}")
+
+    for goc, thu_muc, tep in os.walk(kho, onerror=khong_doc_duoc):
+        thu_muc[:] = sorted(d for d in thu_muc if not bo_qua(d))
+        for ten in thu_muc + sorted(t for t in tep if not bo_qua(t)):
+            p = os.path.join(goc, ten)
+            if os.path.islink(p) and not os.path.exists(p):
+                loi.append("symlink TREO trong cay (t82 cua lease-publish selftest copytree ca cay se DO): "
+                           f"{os.path.relpath(p, kho).replace(os.sep, '/')!r}")
+    return loi
+
