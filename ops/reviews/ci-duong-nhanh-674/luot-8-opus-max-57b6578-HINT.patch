+def _commit_symlink(kho, cap):
+    """Tao cac symlink {duong: dich} (xoa tep thuong cung ten neu co = doi kieu), commit, tra SHA."""
+    for duong, dich in cap.items():
+        p = kho / duong
+        p.parent.mkdir(parents=True, exist_ok=True)
+        if p.exists() or p.is_symlink():
+            p.unlink()
+        p.symlink_to(dich)
+    git(kho, "add", "-A")
+    git(kho, "commit", "-q", "-m", "symlink")
