+    return loi + [f"symlink ho so co san bi TREO sau PR nay (dich da mat): {duong!r}" for duong in treo if duong not in doi]
+
+
+def _nem(e):
+    raise e
+
+
+def _symlink_treo_trong_ho_so(kho=ROOT) -> list[str]:
+    """Mọi symlink TREO trong cây dưới bốn tiền tố allowlist (đường dẫn repo-relative, đã sắp). `followlinks=False`: không đi vào
+    symlink thư mục; lỗi đọc thư mục NÉM (không im lặng bỏ qua — quét hụt là fail-open)."""
+    ra = []
+    for tien_to in ALLOWLIST_TIEN_TO:
+        if not (Path(kho) / tien_to).is_dir():
+            continue   # vùng chưa tồn tại trong cây: không có gì để quét
+        for thu_muc, con, tep in os.walk(Path(kho) / tien_to, onerror=_nem):
+            for ten in con + tep:
+                duong = Path(thu_muc) / ten
+                if duong.is_symlink() and not duong.exists():
+                    ra.append(duong.relative_to(Path(kho)).as_posix())
+    return sorted(ra)
 
 
