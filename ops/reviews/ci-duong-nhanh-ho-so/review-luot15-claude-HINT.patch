+    neo = re.compile(r"(?<![0-9a-f])(?=[0-9a-f]*[a-f])[0-9a-f]{7,40}(?![0-9a-f])")
+    co_ti_le = [d for d in re.split(r"\n\s*\n|\n\s*·\s", ma_sp) if ti_le.search(d)]
+    bang(co_ti_le, "ha tang: docstring san pham khong con ti le nao — ca nay khong do gi (doi mau hoac bo ca)")
+    thieu = [ti_le.findall(d) for d in co_ti_le if not neo.search(d)]
+    bang(not thieu, f"ti le trong docstring san pham khong neo commit (se troi khi merge master): {thieu}")
