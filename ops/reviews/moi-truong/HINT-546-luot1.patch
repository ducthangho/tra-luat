+def _do_hook_da_chay(ws: str | None, bay_gio: float | None = None) -> tuple[str, str]:
+    """Hook phiên đã CHẠY chưa (M3) — đo bằng dấu vết, VÀ đo cả ĐỘ TƯƠI của dấu vết.
