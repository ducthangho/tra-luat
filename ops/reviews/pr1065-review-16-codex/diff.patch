+                while ($i -lt $DoiSo.Count -and $DoiSo[$i] -notmatch '^/') {
+                    if ($DoiSo[$i] -notmatch '^([^:]+):(?:(?:\(OI\)|\(CI\))*)(F|RX|M)$') { throw "grant ngoài mô hình: $($DoiSo[$i])" }
