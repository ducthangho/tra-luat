# chưa chạy trên cây thật — executor tự áp, tự đo, tự chịu trách nhiệm commit
# Test-only hint; expected RED on reviewed HEAD. Product fixes are described in VERDICT.md.
--- /dev/null
+++ ops/vm/cap-nhat-cong-cu_review_test.ps1
@@ -0,0 +1,100 @@
+# Gợi ý test của reviewer; không gọi mạng, installer hoặc Scheduled Task thật.
+# Chạy: pwsh -NoProfile -File <test> -ProductPath <cap-nhat-cong-cu.ps1>
+param([string]$ProductPath = (Join-Path $PSScriptRoot 'cap-nhat-cong-cu.ps1'))
+$ErrorActionPreference='Stop'
+. $ProductPath -NapHam
+$script:reviewPassed=0; $script:reviewTotal=0
+function Review-Ca([string]$Name,[scriptblock]$Body) {
+    $script:reviewTotal++
+    try {
+        $values=@(& $Body)
+        if ($values.Count -ne 1 -or $values[0] -isnot [bool] -or -not $values[0]) { throw 'expected exactly one true boolean' }
+        $script:reviewPassed++; Write-Host "PASS $Name"
+    } catch { Write-Host "FAIL $Name : $($_.Exception.Message)" }
+}
+function Review-Throws([scriptblock]$Body) { try { & $Body | Out-Null; return $false } catch { return $true } }
+$script:reviewTemp=Join-Path ([IO.Path]::GetTempPath()) ('cncc-review-'+[guid]::NewGuid().ToString('N'))
+New-Item -ItemType Directory $script:reviewTemp | Out-Null
+try {
+    $script:reviewPayload='offline-review-payload'
+    $script:reviewText=''
+    function Invoke-WebRequest { param($Uri,$Headers,$TimeoutSec,$OutFile)
+        if ($OutFile) { [IO.File]::WriteAllText($OutFile,$script:reviewPayload); return }
+        [pscustomobject]@{Content=$script:reviewText}
+    }
+    Review-Ca 'save-rejects-mismatch-and-removes-file' {
+        $dest=Join-Path $script:reviewTemp 'bad.msi'
+        (Review-Throws { Save-CoKiemBam 'OFFLINE:payload' ('0'*64) $script:reviewTemp 'bad.msi' }) -and -not (Test-Path $dest)
+    }
+    $script:reviewAsset=[pscustomobject]@{name='wanted.msi';digest=$null}
+    $script:reviewRelease=[pscustomobject]@{assets=@($script:reviewAsset,[pscustomobject]@{name='wanted.msi.sha256';browser_download_url='OFFLINE:checksum'})}
+    Review-Ca 'asset-sidecar-rejects-other-filename' {
+        $script:reviewText=('a'*64)+'  other.msi'
+        $null -eq (Get-BamTaiSan $script:reviewRelease $script:reviewAsset)
+    }
+    Review-Ca 'asset-sidecar-accepts-bare-hash' {
+        $script:reviewText='a'*64
+        (Get-BamTaiSan $script:reviewRelease $script:reviewAsset) -eq ('a'*64)
+    }
+    Review-Ca 'asset-sidecar-selects-named-line' {
+        $script:reviewText=('a'*64)+"  other.msi`n"+('b'*64)+"  wanted.msi`n"
+        (Get-BamTaiSan $script:reviewRelease $script:reviewAsset) -eq ('b'*64)
+    }
+    # Đây chỉ là chốt đối số; không chứng minh ACL hiệu lực trên Windows.
+    Review-Ca 'admin-temp-explicitly-removes-inheritance' {
+        $tokens=$null; $errors=$null
+        $ast=[Management.Automation.Language.Parser]::ParseFile($ProductPath,[ref]$tokens,[ref]$errors)
+        $func=$ast.FindAll({param($n) $n -is [Management.Automation.Language.FunctionDefinitionAst] -and $n.Name -eq 'New-ThuMucTai'},$true)[0]
+        $call=$func.FindAll({param($n) $n -is [Management.Automation.Language.CommandAst] -and $n.Extent.Text -match 'icacls\.exe'},$true)[0]
+        $nativeArguments=@($call.CommandElements | Where-Object { $_ -is [Management.Automation.Language.StringConstantExpressionAst] } | ForEach-Object { $_.Value })
+        [bool]($nativeArguments -contains '/inheritance:r')
+    }
+    $env:ProgramFiles=Join-Path $script:reviewTemp 'ProgramFiles'
+    $node=Join-Path $env:ProgramFiles 'nodejs/node.exe'
+    New-Item -ItemType Directory -Path (Split-Path $node -Parent) | Out-Null
+    [IO.File]::WriteAllText($node,'fixture-exists-only-never-executed')
+    $script:reviewMode=''; $script:reviewInstalled=$false; $script:reviewRestarted=$false; $script:reviewFlagAtInstall=$false
+    function Get-PhienBanLenh($Exe,$DoiSo,$Mau) {
+        if ($Exe -match 'git.exe$') { return '2.56.0.windows.4' }
+        if ($Exe -match 'gh.exe$') { return '1.0.0' }
+        if ($Exe -match 'pwsh.exe$') { return '7.6.9' }
+        if ($script:reviewMode -eq 'unknown') { return $null }
+        return '24.1.0'
+    }
+    function Get-Release($Repo) {
+        $tag='7.6.9'; $file='PowerShell-7.6.9-win-x64.msi'
+        if ($Repo -eq 'git-for-windows/git') { $tag='2.56.0.windows.4';$file='Git-2.56.0-64-bit.exe' }
+        if ($Repo -eq 'cli/cli') { $tag='1.0.0';$file='gh_1.0.0_windows_amd64.msi' }
+        [pscustomobject]@{tag_name="v$tag";assets=@([pscustomobject]@{name=$file;browser_download_url='OFFLINE:asset'})}
+    }
+    function Invoke-RestMethod { param($Uri,$TimeoutSec)
+        @([pscustomobject]@{version='v26.2.0';lts='new'},[pscustomobject]@{version='v24.2.0';lts='old'})
+    }
+    function Save-CoKiemBam($Url,$Bam,$ThuMuc,$Ten) { return (Join-Path $script:reviewTemp $Ten) }
+    function Install-Msi($Msi,$Ten) {
+        $script:reviewInstalled=$true; $script:reviewFlagAtInstall=$Script:DaCaiNode
+        throw 'offline-msi-failure-after-node-may-have-stopped'
+    }
+    function Stop-ScheduledTask { param($TaskName,$ErrorAction) }
+    function Start-ScheduledTask { param($TaskName,$ErrorAction) $script:reviewRestarted=$true }
+    function Get-ScheduledTask { param($TaskName,$ErrorAction) [pscustomobject]@{State='Running'} }
+    function Start-Sleep { param($Seconds) }
+    # Helpers gốc xoá temp trong finally. Không cho stub trỏ về thư mục chứa fixture.
+    function New-ThuMucTai { param([switch]$ChiAdmin)
+        $d=Join-Path $script:reviewTemp ([guid]::NewGuid().ToString('N')); New-Item -ItemType Directory $d | Out-Null; return $d
+    }
+    Review-Ca 'node-existing-unreadable-does-not-install-new-major' {
+        $script:reviewMode='unknown'; $script:reviewInstalled=$false; $Script:DaCaiNode=$false; $Script:KetQua.Clear()
+        $script:reviewText=('a'*64)+"  node-v26.2.0-x64.msi`n"+('a'*64)+"  node-v24.2.0-x64.msi`n"
+        Invoke-TangHeThong | Out-Null
+        -not $script:reviewInstalled
+    }
+    Review-Ca 'node-msi-failure-still-restarts-commander' {
+        $script:reviewMode='msi-failure'; $script:reviewInstalled=$false; $script:reviewRestarted=$false; $script:reviewFlagAtInstall=$false
+        $Script:DaCaiNode=$false; $Script:KetQua.Clear()
+        Invoke-TangHeThong | Out-Null
+        [bool]($script:reviewInstalled -and $script:reviewFlagAtInstall -and $script:reviewRestarted)
+    }
+} finally { Remove-Item -LiteralPath $script:reviewTemp -Recurse -Force -ErrorAction SilentlyContinue }
+Write-Host "review regressions: $script:reviewPassed/$script:reviewTotal"
+exit $(if ($script:reviewPassed -eq $script:reviewTotal) {0} else {1})
