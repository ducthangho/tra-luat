+#!/usr/bin/python3
+import json, os, sys
+from pathlib import Path
+args = sys.argv[1:]
+target = args[0].replace('\\', '/')
+entry = {'args': args, 'resolved': os.path.realpath(target), 'is_link': os.path.islink(target)}
+with open(os.environ['R2_ICACLS_LOG'], 'a') as f:
+    f.write(json.dumps(entry) + '\n')
+# Only records calls. Does not emulate or modify any ACL/owner.
+if os.environ.get('R2_SWAP_PARENT') and '/setowner' in args and '/tra-luat-ops' not in target:
+    parent = Path(os.environ['R2_SWAP_PARENT'])
+    if parent.exists() and not parent.is_symlink():
+        parent.rename(str(parent) + '-before-swap')
+        parent.symlink_to(os.environ['R2_SWAP_TARGET'], target_is_directory=True)
+sys.exit(0)
