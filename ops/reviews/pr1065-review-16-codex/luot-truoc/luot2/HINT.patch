+#!/usr/bin/env python3
+"""Linux offline Register tests; control flow only, not native Windows ACL evidence.
+
+Run: TL_TEST_PWSH=/path/to/pwsh python3 ops/vm/cap-nhat-cong-cu_dang-ky_test.py
+Product override supports isolated mutation copies via --product /path/to/script.ps1.
+chưa chạy trên cây thật — executor tự áp, tự đo, tự chịu trách nhiệm commit
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+HERE = Path(__file__).resolve().parent
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--product', type=Path, default=HERE / 'cap-nhat-cong-cu.ps1')
+ns = parser.parse_args()
+if sys.platform != 'linux':
+    sys.exit('NOT_RUN: this harness is Linux-only; Windows native tests remain required')
+pwsh = os.environ.get('TL_TEST_PWSH') or shutil.which('pwsh')
+if not pwsh:
+    sys.exit('NOT_RUN: set TL_TEST_PWSH to the local pwsh executable')
+
+measurements = {}
+for mode in ('clean', 'owned', 'acl-reject', 'hash-reject'):
+    p = subprocess.run([pwsh, '-NoProfile', '-File', str(HERE / 'cap-nhat-cong-cu_dang-ky_probe.ps1'),
+                        '-Mode', mode, '-ProductScript', str(ns.product.resolve())],
+                       capture_output=True, text=True, timeout=30)
+    lines = [line[len('R2_JSON:'):] for line in p.stdout.splitlines() if line.startswith('R2_JSON:')]
+    if p.returncode or len(lines) != 1:
+        sys.exit(f'HARNESS_ERROR {mode}: rc={p.returncode}\n{p.stdout}\n{p.stderr}')
+    measurements[mode] = json.loads(lines[0])
+
+clean = measurements['clean']
+actions = clean['tasks']
+arguments = actions[0]['action']['Argument'] if actions else ''
+owned = measurements['owned']
+tests = {
+    'action_preserves_supported_configuration': all(x in arguments for x in (
+        '-MayDich "VM"', '-ThuMucCongCu "', '-NlmVenv "D:\\custom nlm"',
+        '-VenvKho "D:\\custom venv"', '-HomeCommander "D:\\custom profile"',
+        '-TaiKhoanNguoiDung "tlcommander"', '-TacVuCommander "CMD-CUSTOM"')),
+    'bad_acl_prevents_task_registration': not measurements['acl-reject']['tasks'] and
+        measurements['acl-reject']['stopped'].startswith('ACL '),
+    'corrupt_copy_prevents_task_registration': not measurements['hash-reject']['tasks'] and
+        'lệch băm nguồn' in measurements['hash-reject']['stopped'],
+    'new_copy_owner_is_normalized_before_use': bool(actions) and
+        clean['stopped'] == 'OFFLINE-STOP-BEFORE-CREDENTIALS',
+    'inherited_write_is_removed': any('/inheritance:r' in e.get('args', []) and
+        'tra-luat-ops' in e.get('args', [''])[0] for e in clean['icacls']),
+    'already_owned_tree_is_not_provisioned_again': not any('/Tools/' in e.get('resolved', '')
+        for e in owned['icacls']) and bool(owned['tasks']),
+}
+for name, passed in tests.items():
+    print(('PASS' if passed else 'FAIL') + ' ' + name)
+print(f'Register offline: {sum(tests.values())}/{len(tests)} PASS; native ACL NOT_MEASURED')
+sys.exit(0 if all(tests.values()) else 1)
