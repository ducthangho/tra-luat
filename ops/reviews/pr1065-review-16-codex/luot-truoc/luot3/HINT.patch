+"""Linux-only offline Register probes. Does not measure native Windows ACL/Tasks.
+
+Usage: TL_TEST_PWSH=/absolute/pwsh python3 this_file.py [--product /path/to/product.ps1]
+Each test invokes Register itself with real scratch paths/copies and explicit native stubs.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--product', type=Path, default=Path(__file__).with_name('cap-nhat-cong-cu.ps1'))
+options = parser.parse_args()
+pwsh = os.environ.get('TL_TEST_PWSH') or shutil.which('pwsh')
+if not pwsh:
+    raise SystemExit('Missing pwsh: set TL_TEST_PWSH')
+probe = Path(__file__).with_name('cap-nhat-cong-cu_register_probe.ps1')
+results = {}
+def measure(mode):
+    if mode not in results:
+        p = subprocess.run([pwsh, '-NoProfile', '-File', str(probe), '-Product', str(options.product.resolve()), '-Mode', mode], capture_output=True, text=True, timeout=30)
+        if p.returncode:
+            raise RuntimeError(f'probe {mode} rc={p.returncode}: {p.stdout}\n{p.stderr}')
+        data = json.loads(p.stdout.splitlines()[-1])
+        results[mode] = data
+    return results[mode]
+
+def successful(j):
+    return len(j['tasks']) == 1 and j['error'] == 'OFFLINE-STOP-BEFORE-CREDENTIALS'
+
+def no_tools_acl():
+    j = measure('ancestor-link')
+    return successful(j) and j['tool_acl_calls'] == 0 and j['icacls_count'] == 3
+
+def refuses_ancestor():
+    j = measure('install-ancestor-link')
+    return not j['tasks'] and j['icacls_count'] == 0 and 'reparse point' in (j['error'] or '')
+
+def refuses_acl():
+    j = measure('acl-reject')
+    return not j['tasks'] and (j['error'] or '').startswith('ACL ')
+
+def refuses_hash():
+    j = measure('hash-reject')
+    return not j['tasks'] and 'lệch băm nguồn' in (j['error'] or '')
+
+def owner_after_copy():
+    j = measure('stateful-owner')
+    copies = [i for i, e in enumerate(j['events']) if e['event'] == 'copy']
+    owners = [i for i, e in enumerate(j['events']) if e['event'] == 'icacls' and '/setowner' in e['argv']]
+    return successful(j) and bool(copies) and bool(owners) and max(owners) > max(copies)
+
+def reset_before_copy():
+    j = measure('stateful-inheritance')
+    copies = [i for i, e in enumerate(j['events']) if e['event'] == 'copy']
+    resets = [i for i, e in enumerate(j['events']) if e['event'] == 'icacls' and '/inheritance:r' in e['argv'] and '/grant:r' in e['argv']]
+    return successful(j) and bool(copies) and bool(resets) and min(resets) < min(copies)
+
+def full_task_configuration():
+    j = measure('clean')
+    if not successful(j) or len(j['actions']) != 2:
+        return False
+    for action, scope in zip(j['actions'], ['HeThong', 'NguoiDung']):
+        arg = action['Argument']
+        if any(s not in arg for s in ['-File "', f'-PhamVi "{scope}"', '-MayDich "REVIEW-VM"', '-ThuMucCongCu "', '-NlmVenv "D:\\nlm venv\\\\"', '-VenvKho "D:\\repo venv\\\\\\\\"', '-HomeCommander "D:\\profile custom"', '-TaiKhoanNguoiDung "tlcommander"', '-TacVuCommander "CMD-CUSTOM"']):
+            return False
+    return True
+
+tests = [no_tools_acl, refuses_ancestor, refuses_acl, refuses_hash, owner_after_copy, reset_before_copy, full_task_configuration]
+passed = 0
+for test in tests:
+    try:
+        ok = bool(test())
+    except Exception as exc:
+        ok = False
+        print(f'HARNESS_ERROR {test.__name__}: {exc}')
+    passed += ok
+    print(('PASS ' if ok else 'FAIL ') + test.__name__)
+print(f'Register offline: {passed}/{len(tests)} PASS; native ACL NOT_MEASURED')
+raise SystemExit(0 if passed == len(tests) else 1)
