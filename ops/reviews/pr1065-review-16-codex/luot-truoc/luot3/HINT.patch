+}
+if ($Mode -eq 'install-root-link') {
+    Remove-Item -LiteralPath "$env:ProgramFiles/tra-luat-ops" -Recurse
+    New-Item -ItemType SymbolicLink -Path "$env:ProgramFiles/tra-luat-ops" -Target "$base/victim" | Out-Null
+}
+if ($Mode -eq 'install-ancestor-link') {
+    Remove-Item -LiteralPath $env:ProgramFiles -Recurse
+    New-Item -ItemType Directory -Path "$base/pf-victim/tra-luat-ops" | Out-Null
+    New-Item -ItemType SymbolicLink -Path $env:ProgramFiles -Target "$base/pf-victim" | Out-Null
+}
+if ($Mode -eq 'install-child-link') {
+    New-Item -ItemType SymbolicLink -Path "$env:ProgramFiles/tra-luat-ops/link" -Target "$base/victim" | Out-Null
+}
+$shim = @'
+#!/usr/bin/python3
+import json, os, sys
+with open(os.environ['REVIEW_IC_LOG'],'a') as f:
+    f.write(json.dumps({'event':'icacls', 'argv':sys.argv[1:], 'resolved':os.path.realpath(sys.argv[1])})+'\n')
+sys.exit(0)
+'@
+$icacls = "$env:SystemRoot/System32/icacls.exe"
+[IO.File]::WriteAllText($icacls,$shim)
+& /bin/chmod +x $icacls
+$env:REVIEW_IC_LOG = "$base/icacls.jsonl"
+$Script:Tasks = [Collections.Generic.List[object]]::new(); $Script:Actions=[Collections.Generic.List[object]]::new()
+$Script:AuditReads = 0
+function Copy-Item {
+    param($LiteralPath,$Destination,[switch]$Force)
+    @{event='copy';source=$LiteralPath;destination=$Destination}|ConvertTo-Json -Compress|Add-Content -LiteralPath $env:REVIEW_IC_LOG
+    Microsoft.PowerShell.Management\Copy-Item -LiteralPath $LiteralPath -Destination $Destination -Force:$Force
+}
+function Get-Acl {
+    param($LiteralPath)
+    $isInstall = "$LiteralPath".StartsWith($env:ProgramFiles)
+    if ($isInstall) { $Script:AuditReads++ }
+    $owner = if ($isInstall) {'BUILTIN\Administrators'} else {"$env:COMPUTERNAME\tlcommander"}
+    $rights = if ($isInstall -and $Mode -eq 'acl-reject') {'Modify'} else {'ReadAndExecute, Synchronize'}
+    if ($isInstall -and $Mode -in 'stateful-owner','stateful-inheritance') {
+        $events=@(Get-Content -LiteralPath $env:REVIEW_IC_LOG|ConvertFrom-Json)
+        if ($Mode -eq 'stateful-owner') {
+            # Explicit model: a new copy is owned by the copying account, until a later recursive setowner.
+            $lastCopy=-1; $lastOwner=-1
+            for ($i=0;$i -lt $events.Count;$i++) {
+                if ($events[$i].event -eq 'copy' -and $events[$i].destination -eq $LiteralPath) {$lastCopy=$i}
+                if ($events[$i].event -eq 'icacls' -and $events[$i].argv -contains '/setowner') {$lastOwner=$i}
+            }
+            if ($lastCopy -gt $lastOwner) {$owner='REVIEW-VM\tladmin'}
+        }
+        if ($Mode -eq 'stateful-inheritance' -and -not ($events|Where-Object {$_.event -eq 'icacls' -and $_.argv -contains '/inheritance:r'})) {
+            $rights='Modify'
+        }
+    }
+    [pscustomobject]@{ Owner=$owner; Access=@([pscustomobject]@{IdentityReference='REVIEW-VM\tlcommander';FileSystemRights=$rights;AccessControlType='Allow'}) }
+}
+function Get-FileHash {
+    param($LiteralPath)
+    if ($Mode -eq 'hash-reject' -and "$LiteralPath".StartsWith($env:ProgramFiles)) { return [pscustomobject]@{ Hash='BAD-HASH' } }
+    Microsoft.PowerShell.Utility\Get-FileHash -LiteralPath $LiteralPath
+}
+function New-ScheduledTaskSettingsSet { param([switch]$StartWhenAvailable,$ExecutionTimeLimit,$MultipleInstances) [pscustomobject]@{ settings=$true } }
+function New-ScheduledTaskTrigger { param([switch]$Weekly,$WeeksInterval,$DaysOfWeek,$At) [pscustomobject]@{ At=$At; WeeksInterval=$WeeksInterval } }
+function New-ScheduledTaskAction { param($Execute,$Argument)
+    $a=[pscustomobject]@{ Execute=$Execute; Argument=$Argument }; $Script:Actions.Add($a); $a
+}
+function New-ScheduledTaskPrincipal { param($UserId,$LogonType,$RunLevel) [pscustomobject]@{UserId=$UserId} }
+function Register-ScheduledTask { param($TaskName,$Action,$Trigger,$Principal,$Settings,[switch]$Force,$ErrorAction) $Script:Tasks.Add([pscustomobject]@{Name=$TaskName;Action=$Action;ErrorAction=$ErrorAction}) }
+function Get-Credential { param($UserName,$Message) throw 'OFFLINE-STOP-BEFORE-CREDENTIALS' }
+$errorText=$null
+try { Register-LichCapNhat (Split-Path -Parent (Split-Path -Parent (Split-Path -Parent $Product))) } catch { $errorText=$_.Exception.Message }
+$events = if (Test-Path -LiteralPath $env:REVIEW_IC_LOG) { @(Get-Content -LiteralPath $env:REVIEW_IC_LOG | ConvertFrom-Json) } else { @() }
+$icCalls = @($events|Where-Object {$_.event -eq 'icacls'})
+$target = Join-Path $env:ProgramFiles 'tra-luat-ops'
+$files = @(Get-ChildItem -LiteralPath $target -File -ErrorAction SilentlyContinue | ForEach-Object {$_.Name})
+[ordered]@{mode=$Mode; error=$errorText; icacls_count=$icCalls.Count; icacls=@($icCalls); events=$events; tool_acl_calls=@($icCalls|Where-Object {$_.argv[0] -notlike '*/tra-luat-ops'}).Count; actions=@($Script:Actions); tasks=@($Script:Tasks); audit_reads=$Script:AuditReads; copied_files=$files; note='Linux paths real; native icacls/Get-Acl/ScheduledTasks stubbed; stateful-* are explicit fake owner/inheritance models; stop before password/COM'} | ConvertTo-Json -Depth 9 -Compress
+Remove-Item -LiteralPath $base -Recurse -Force
