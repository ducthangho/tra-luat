+param([string]$Mode = 'clean', [string]$Product = "$PSScriptRoot/cap-nhat-cong-cu.ps1")
+. $Product -NapHam
+$Product = (Resolve-Path -LiteralPath $Product).Path
+$base = Join-Path ([IO.Path]::GetTempPath()) ('review-register-' + [guid]::NewGuid().ToString('N'))
+New-Item -ItemType Directory -Path $base | Out-Null
+$env:ProgramFiles = Join-Path $base 'PF'; $env:SystemRoot = Join-Path $base 'Windows'; $env:COMPUTERNAME = 'REVIEW-VM'
+$MayDich = 'REVIEW-VM'; $ThuMucCongCu = Join-Path $base 'Tools'; $NlmVenv='D:\nlm venv\'; $VenvKho='D:\repo venv\\'
+$HomeCommander='D:\profile custom'; $TaiKhoanNguoiDung='tlcommander'; $TacVuCommander='CMD-CUSTOM'
+New-Item -ItemType Directory -Path "$env:SystemRoot/System32", "$env:ProgramFiles/tra-luat-ops", "$ThuMucCongCu/npm", "$ThuMucCongCu/Python312", "$ThuMucCongCu/bin", "$base/victim/npm", "$base/victim/Python312", "$base/victim/bin" | Out-Null
+if ($Mode -eq 'root-link') {
