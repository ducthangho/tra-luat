++# Linux-only offline control-flow harness. Does not measure native ACL or Scheduler.
++# chưa chạy trên cây thật — executor tự áp, tự đo, tự chịu trách nhiệm commit
++param([ValidateSet('clean','root-link','ancestor-link','swap-parent','owned','acl-reject','hash-reject')][string]$Mode='clean', [Parameter(Mandatory=$true)][string]$ProductScript)
++$ErrorActionPreference='Stop'
