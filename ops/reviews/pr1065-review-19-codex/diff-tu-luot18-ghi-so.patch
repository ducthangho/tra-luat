++$env:SystemRoot=Join-Path $root 'OS'
++$env:COMPUTERNAME='VM'
++$env:R2_ICACLS_LOG=Join-Path $root 'icacls.jsonl'
++$TaiKhoanNguoiDung='tlcommander';$MayDich='VM';$TacVuCommander='CMD-CUSTOM'
++$NlmVenv='D:\custom nlm';$VenvKho='D:\custom venv';$HomeCommander='D:\custom profile'
++$NhatKy='D:\custom logs\run.json';$ChiKiem=$true
++$ThuMucCongCu=Join-Path $root 'Tools'
++$victim=Join-Path $root 'victim'
++New-Item -ItemType Directory "$env:SystemRoot/System32",$victim,$env:ProgramFiles -Force | Out-Null
++foreach ($name in 'npm','Python312','bin') {New-Item -ItemType Directory (Join-Path $victim $name) -Force | Out-Null}
++Copy-Item "$PSScriptRoot/cap-nhat-cong-cu_icacls_stub.py" "$env:SystemRoot/System32/icacls.exe"
++& /bin/chmod +x "$env:SystemRoot/System32/icacls.exe"
++$script:Captured=[Collections.Generic.List[object]]::new()
++function Get-Acl { param($LiteralPath)
++    $owner='BUILTIN\Administrators'
++    if ($Mode -eq 'owned' -and $LiteralPath.StartsWith($ThuMucCongCu)) {$owner='VM\tlcommander'}
++    $access=@([pscustomobject]@{IdentityReference='BUILTIN\Users';FileSystemRights='ReadAndExecute';AccessControlType='Allow'})
++    if ($LiteralPath -match 'tra-luat-ops' -and (Test-Path $env:R2_ICACLS_LOG)) {
++        $events=@(Get-Content $env:R2_ICACLS_LOG | ForEach-Object {$_ | ConvertFrom-Json})
++        $lastCopy=-1; $lastOwner=-1; $resetInheritance=$false
++        for ($i=0;$i -lt $events.Count;$i++) {
++            $e=$events[$i]
++            if ($e.event -eq 'copy' -and $e.destination -eq $LiteralPath) {$lastCopy=$i}
++            if ($e.args -and $e.args[0] -match 'tra-luat-ops') {
++                if ($e.args -contains '/setowner') {$lastOwner=$i}
++                if ($e.args -contains '/inheritance:r') {$resetInheritance=$true}
++            }
++        }
++        # Model: a freshly copied file can be owned by the running admin account.
++        if ($lastCopy -gt $lastOwner) {$owner='VM\tladmin'}
++        # Model: inherited Users Modify must be removed before protected copies are used.
++        if (-not $resetInheritance) {
++            $access+= [pscustomobject]@{IdentityReference='BUILTIN\Users';FileSystemRights='Modify';AccessControlType='Allow'}
++        }
++    }
++    if ($Mode -eq 'acl-reject' -and $LiteralPath -match 'tra-luat-ops') {
++        $access+= [pscustomobject]@{IdentityReference='VM\tlcommander';FileSystemRights='Modify';AccessControlType='Allow'}
++    }
++    [pscustomobject]@{Owner=$owner;Access=$access}
++}
++function New-ScheduledTaskSettingsSet {param([switch]$StartWhenAvailable,$ExecutionTimeLimit,$MultipleInstances) [pscustomobject]@{stub=$true}}
++function New-ScheduledTaskTrigger {param([switch]$Weekly,$WeeksInterval,$DaysOfWeek,$At) [pscustomobject]@{At=$At}}
++function New-ScheduledTaskAction {param($Execute,$Argument) [pscustomobject]@{Execute=$Execute;Argument=$Argument}}
++function New-ScheduledTaskPrincipal {param($UserId,$LogonType,$RunLevel) [pscustomobject]@{UserId=$UserId}}
++function Register-ScheduledTask {param($TaskName,$Action,$Trigger,$Principal,$Settings,[switch]$Force,$ErrorAction) $script:Captured.Add([pscustomobject]@{name=$TaskName;action=$Action;EA=$ErrorAction})}
++function Get-Credential {param($UserName,$Message) throw 'OFFLINE-STOP-BEFORE-CREDENTIALS'}
++try {
++    if ($Mode -eq 'ancestor-link') {New-Item -ItemType SymbolicLink -Path $ThuMucCongCu -Target $victim | Out-Null}
++    else {
++        New-Item -ItemType Directory $ThuMucCongCu -Force | Out-Null
++        if ($Mode -eq 'root-link') {New-Item -ItemType SymbolicLink -Path (Join-Path $ThuMucCongCu 'npm') -Target $victim | Out-Null}
++    }
++    if ($Mode -eq 'swap-parent') {$env:R2_SWAP_PARENT=$ThuMucCongCu;$env:R2_SWAP_TARGET=$victim}
++    function Copy-Item {param($LiteralPath,$Destination,[switch]$Force)
++        Microsoft.PowerShell.Management\Copy-Item -LiteralPath $LiteralPath -Destination $Destination -Force
++        [pscustomobject]@{event='copy';destination=$Destination} | ConvertTo-Json -Compress | Add-Content $env:R2_ICACLS_LOG
++        if ($Mode -eq 'hash-reject') {[IO.File]::AppendAllText($Destination,'CORRUPTED')}
++    }
++    $why=''
++    try {Register-LichCapNhat (Split-Path (Split-Path (Split-Path $ProductScript -Parent) -Parent) -Parent)} catch {$why=$_.Exception.Message}
++    $calls=@(); if(Test-Path $env:R2_ICACLS_LOG){$calls=@(Get-Content $env:R2_ICACLS_LOG | ForEach-Object {$_ | ConvertFrom-Json})}
++    [pscustomobject]@{mode=$Mode;stopped=$why;icacls_count=$calls.Count;icacls=$calls;tasks=@($script:Captured);custom_log_preserved=(@($script:Captured | Where-Object {$_.action.Argument -match '-NhatKy'}).Count -gt 0);check_preserved=(@($script:Captured | Where-Object {$_.action.Argument -match '-ChiKiem'}).Count -gt 0);native_ACL_measured=$false} | ConvertTo-Json -Depth 6 -Compress | ForEach-Object { "R2_JSON:$_" }
++} finally {
++    Remove-Item Env:R2_SWAP_PARENT,Env:R2_SWAP_TARGET -ErrorAction SilentlyContinue
++    Remove-Item $root -Recurse -Force
++}
