#!/usr/bin/env python3
import json
import os
import subprocess
import sys

argv = sys.argv
line = subprocess.list2cmdline(argv)
units = len(line.encode('utf-16-le')) // 2 + 1
row = {'argc': len(argv), 'arg_chars': [len(a) for a in argv],
       'chars_with_spaces': len(' '.join(argv)), 'quoted_chars': len(line),
       'utf16_units_with_nul': units, 'rejected': units > 32767}
if log := os.environ.get('NODE_LIMIT_LOG'):
    with open(log, 'a', encoding='utf-8') as f:
        f.write(json.dumps(row) + '\n')
if row['rejected']:
    print(f'WINLIMIT206: {units} UTF-16 units including NUL > 32767; argc={len(argv)}; max_arg={max(map(len, argv))}', file=sys.stderr)
    sys.exit(206)
real = os.environ['REVIEW_REAL_NODE']
os.execv(real, [real, *argv[1:]])
