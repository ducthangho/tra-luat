{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NSkMwDvidPSoLyy1toiqWN","type":"tool_result","content":"1\t# ProximaControl.psm1 - wp1279 r2 (PROXIMA-P1-S2). Explicit-target control surface over ONE S1-validated Proxima config:\n2\t# px (client) and Invoke-ProximaOperation (endpoint). No discovery, defaults, CWD/environment target lookup, Get-PSSession\n3\t# adoption, autoconnect or fallback. Not exposed by SKILL/manifest until S3; imported directly from this .psm1.\n4\t# - Dependency: sibling ProximaConfig.psm1 (S1), SHA256 pinned below and verified BEFORE it is imported; it is invoked only\n5\t#   through the pinned module object. Internal coupling (declared): S1 PRIVATE helpers Test-PxPathSyntax, Open-PxChain,\n6\t#   Assert-PxOutside, Get-PxNode, Test-PxChild and the strict JSON reader run inside that pinned module scope. S1 is not modified.\n7\t# - Every business action re-reads the config and requires Ordinal targetId equality. Target fingerprint = SHA256 of a\n8\t#   fixed-order, length-prefixed UTF-8 encoding of all validated fields (missing != empty); it keys sessions and model\n9\t#   selection (Ordinal). Only its first 12 hex digits are displayed; it is routing correlation, not a credential.\n10\t# - ShouldProcess precedes EVERY effect: queries (status/models included), selection change, session, credential use,\n11\t#   journal, process, service and network. WhatIf (explicit or ambient) wins over -Confirm:$false and -Force; -Force only\n12\t#   overrides the pending-request guard of stop/restart. Approved inner calls suppress duplicate confirmation only after it.\n13\t# - State is session-only, in THIS module instance: sessions and selections are lost in a new process and when the module is\n14\t#   removed or re-imported (OnRemove releases owned sessions only). Nothing is written to config/settings/profile.\n15\t# - Remote requests are DATA (fixed key/type set) run by one constant endpoint scriptblock. Hashes bind compatibility; they\n16\t#   are not server attestation or hostile-endpoint security. Hash-then-import is a declared race.\n17\t# - Backend primitives (session, remote invoke, HTTP, CIM process/TCP listener, service, id) live in a private table that only an\n18\t#   isolated test harness replaces through module scope. There is no public callback/executor.\n19\t# - r4 (F03): before ANY gateway HTTP the metadata port must be LISTENed on by the already validated Proxima PID (read-only CIM\n20\t#   MSFT_NetTCPConnection snapshot; rules at Get-PxcGateway). Query failure/denial is fail-closed, never a fallback.\n21\t# - Model ids: an advertised id belongs to provider P only if it starts with 'P/' (Ordinal) and is advertised verbatim.\n22\t# Not proven: runtime provenance/version/quota, real WinRM auth, model identity (answers are untrusted data), installed\n23\t# service wrapper layouts (NSSM and the like fail closed), admin ABA races, outward junctions elsewhere in a repository, and\n24\t# atomic listener ownership: the port check is a snapshot, so a process/port swap between it and the HTTP send is a declared race.\n25\t# Remote ProtectedRoot protects only the deployed control tree. Completed journal records are kept (no housekeeping).\n26\tSet-StrictMode -Version 3.0\n27\t$ErrorActionPreference = 'Stop'\n28\t$script:Protocol = 1\n29\t$script:ConfigSha = '59abfa860e59af7c596a9e3f60829f8dc1af4a853c5d4ac197c00cc033d76e7d'\n30\t$script:IdFields = @('schemaVersion', 'targetId', 'mode', 'basePath', 'connectionUri', 'configurationName')\n31\t$script:PxActions = [Collections.Generic.HashSet[string]]::new([string[]]@('help', 'config', 'status', 'models', 'use', 'ask', 'start', 'stop', 'restart', 'connect', 'disconnect'), [StringComparer]::Ordinal)\n32\t$script:OpActions = [Collections.Generic.HashSet[string]]::new([string[]]@('status', 'models', 'ask', 'start', 'stop', 'restart', 'handshake'), [StringComparer]::Ordinal)\n33\t$script:Sessions = [Collections.Generic.Dictionary[string, object]]::new([StringComparer]::Ordinal)\n34\t$script:Selection = [Collections.Generic.Dictionary[string, object]]::new([StringComparer]::Ordinal)\n35\t$script:Orphans = [Collections.Generic.List[object]]::new()\n36\t$script:Utf8 = [Text.UTF8Encoding]::new($false, $true)\n37\t$script:BadAttr = 0x441400\n38\t$script:ReGuid = '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\z'\n39\t$script:ReRecord = '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.json\\z'\n40\t$script:Help = @('px help', 'px config|status|start|stop|restart|connect|disconnect -ConfigPath <file> -RepositoryRoot <dir> -TargetId <id> [-Credential <PSCredential>] [-Force]',\n41\t    'px models [<provider>] -ConfigPath ... -RepositoryRoot ... -TargetId ...', 'px use <provider> <provider/model> -ConfigPath ... -RepositoryRoot ... -TargetId ...',\n42\t    'px ask <provider> <prompt> [-Model <provider/model>] -ConfigPath ... -RepositoryRoot ... -TargetId ...', 'Every action supports -WhatIf and -Confirm.')\n43\t\n44\tfunction Get-PxcSha256([byte[]]$Bytes) {\n45\t    $h = [Security.Cryptography.SHA256]::Create()\n46\t    try { return ([BitConverter]::ToString($h.ComputeHash($Bytes)) -replace '-', '').ToLowerInvariant() } finally { $h.Dispose() }\n47\t}\n48\t# Codes are constant identifiers; messages never carry values, paths, bodies or inner errors.\n49\tfunction New-PxcError([string]$Code) {\n50\t    if ($Code -cnotmatch '^[A-Za-z]{1,40}\\z') { $Code = 'Internal' }\n51\t    return [Management.Automation.ErrorRecord]::new([InvalidOperationException]::new(\"ProximaControl: operation rejected: $Code.\"), \"ProximaControl.$Code\", 'InvalidOperation', $null)\n52\t}\n53\tfunction Stop-Pxc([string]$Code) { $ex = [Exception]::new(\"ProximaControl.$Code\"); $ex.Data['PxcCode'] = $Code; throw $ex }\n54\t# Runs one step; any failure that is not already a ProximaControl code becomes $PxcStepCode (inner text discarded).\n55\tfunction Invoke-PxcStep([string]$PxcStepCode, [scriptblock]$PxcStepBody) {\n56\t    try { & $PxcStepBody } catch { if ($_.Exception.Data.Contains('PxcCode')) { throw }; Stop-Pxc $PxcStepCode }\n57\t}\n58\tfunction Resolve-PxcError($Err) {\n59\t    if ($Err.Exception.Data.Contains('PxcCode')) { return (New-PxcError ([string]$Err.Exception.Data['PxcCode'])) }\n60\t    if ([string]$Err.FullyQualifiedErrorId -clike 'ProximaConfig.*' -and $Err.Exception.Message -clike 'ProximaConfig: *') { return $Err }\n61\t    return (New-PxcError 'Internal')\n62\t}\n63\t\n64\t# ---- dependency: S1 verified by hash BEFORE import, then used only through the pinned module object ----\n65\t$cfgOk = $false\n66\ttry {\n67\t    $script:SelfSha = Get-PxcSha256 ([IO.File]::ReadAllBytes($PSCommandPath))\n68\t    $script:CfgPath = [IO.Path]::Combine($PSScriptRoot, 'ProximaConfig.psm1')\n69\t    $cfgOk = (Get-PxcSha256 ([IO.File]::ReadAllBytes($script:CfgPath))) -ceq $script:ConfigSha\n70\t} catch { $cfgOk = $false }\n71\tif (-not $cfgOk) { throw (New-PxcError 'DependencyMismatch') }\n72\ttry { $script:CfgMod = Import-Module -Name $script:CfgPath -PassThru -DisableNameChecking -ErrorAction Stop } catch { throw (New-PxcError 'DependencyMismatch') }\n73\t$script:ReadConfig = $script:CfgMod.ExportedCommands['Read-ProximaConfig']\n74\tif ($null -eq $script:ReadConfig) { throw (New-PxcError 'DependencyMismatch') }\n75\t\n76\tfunction Test-PxcPath([string]$P) { return [bool](& $script:CfgMod { param($x) Test-PxPathSyntax $x } $P) }\n77\tfunction Join-PxcPath([string]$Base, [string]$Rel) { if ($Base.Length -eq 3) { return $Base + $Rel }; return $Base + '\\' + $Rel }\n78\tfunction Test-PxcProvider([string]$P) { return $P.Length -gt 0 -and $P.IndexOf([char]'/') -lt 0 }\n79\tfunction Test-PxcEncodable([string]$S) { try { $null = $script:Utf8.GetBytes($S); return $true } catch { return $false } }\n80\tfunction New-PxcCtx {"}]},"parent_tool_use_id":null,"session_id":"e1e04ee9-2119-4e46-af04-4c82507c84cb","uuid":"35e8cdd0-a41a-4626-bd23-ad8549cd70b2","timestamp":"2026-11-09T02:0