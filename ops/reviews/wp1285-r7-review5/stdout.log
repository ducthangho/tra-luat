  foreach ($x in $o.test_manifest, $o.module) { if ($x.version -cne $Want.ModuleVersion -or $x.guid -cne $Want.GUID) { $bad.Add(\"IDENTITY[$($x.version) $($x.guid)]\") } }\n341\t+    $cmds = @($o.module.commands)\n342\t+    if ($cmds.Count -ne 2 -or $cmds -cnotcontains 'px' -or $cmds -cnotcontains 'Invoke-ProximaOperation' -or $o.module.functions -ne 2 -or $o.module.others) { $bad.Add(\"EXPORTS[$($cmds -join ',')]\") }\n343\t+    if ($o.module.loaded -ne 1) { $bad.Add(\"LOADED_INSTANCES[$($o.module.loaded)]\") }\n344\t+    if ($null -eq $o.help -or \"$($o.help.schema)|$($o.help.action)|$($o.help.outcome)|$($o.help.first)\" -cne 'px.result.v1|help|ok|px help') { $bad.Add('HELP_NEGATIVE') }\n345\t+    if ($bad.Count) { Stop-Case ($bad -join '; ') }\n346\t+    \"fresh $($o.ps_edition) $($o.ps_version) [$($o.culture)]: Test-ModuleManifest + import ok, path=$($o.module.path) (root psm1: $($o.module.path_is_root_module)), 2 exports, px help ok\"\n347\t+}\n348\t+Invoke-Case 'PM04' {\n349\t+    Assert-Gate $TaSetup $TaOut; $o = $TaOut; $bad = [Collections.Generic.List[string]]::new(); $text = (@($o.error) + @($o.messages)) -join ' | '\n350\t+    if (@($o.preloaded).Count) { $bad.Add('NOT_FRESH_PROCESS') }; if ($o.imported) { $bad.Add('TAMPERED_DEPENDENCY_IMPORTED') }\n351\t+    if ($text.IndexOf('DependencyMismatch', [StringComparison]::Ordinal) -lt 0) { $bad.Add(\"NOT_NAMED_DependencyMismatch[$text]\") }\n352\t+    if ($o.sentinel_exists -or [IO.File]::Exists($Tamper.sentinel)) { $bad.Add('SENTINEL_EXECUTED') }\n353\t+    if (@($o.loaded_after).Count) { $bad.Add(\"MODULE_LEFT_LOADED[$(@($o.loaded_after) -join ',')]\") }\n354\t+    if ((Get-FileSha $Tamper.path) -cne $Tamper.sha256 -or (Get-FileSha (Join-Addon $Root 'scripts/ProximaConfig.psm1')) -cne $Before['scripts/ProximaConfig.psm1']) { $bad.Add('FIXTURE_OR_ORIGINAL_S1_CHANGED') }\n355\t+    if ($bad.Count) { Stop-Case ($bad -join '; ') }\n356\t+    \"DependencyMismatch before the sentinel line ran ($($o.ps_edition) $(