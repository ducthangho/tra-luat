{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QPeWw4qRMAmrd6SYQRRtC3","type":"tool_result","content":"460\t    return (New-PxcResult 'disconnect' $Fp 'Remote' $false $true 'disconnected' ([ordered]@{ orphansReleased = $orph.Count }))\n461\t}\n462\t\n463\t# ---- public API ----\n464\tfunction px {\n465\t    [CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'Medium', PositionalBinding = $false)]\n466\t    param([Parameter(Position = 0)][string]$Action = 'help', [Parameter(Position = 1)][string]$Provider, [Parameter(Position = 2)][string]$Value,\n467\t        [string]$ConfigPath, [string]$RepositoryRoot, [string]$TargetId, [string]$Model, [pscredential]$Credential, [switch]$Force)\n468\t    try {\n469\t        if (-not $script:PxActions.Contains($Action)) { Stop-Pxc 'UnknownAction' }\n470\t        if ($Action -ceq 'help') { return (New-PxcResult 'help' $null $null $false $false 'ok' $script:Help) }\n471\t        foreach ($n in 'ConfigPath', 'RepositoryRoot', 'TargetId') { if (-not $PSBoundParameters.ContainsKey($n)) { Stop-Pxc 'ArgumentMissing' } }\n472\t        $cfg = & $script:ReadConfig -ConfigPath $ConfigPath -RepositoryRoot $RepositoryRoot\n473\t        if (-not [string]::Equals([string]$cfg.targetId, $TargetId, [StringComparison]::Ordinal)) { Stop-Pxc 'TargetMismatch' }\n474\t        $fp = Get-PxcFingerprint $cfg; $mode = [string]$cfg.mode; $display = 'px target ' + $fp.Substring(0, 12)\n475\t        if ($Action -ceq 'config') { return (New-PxcResult 'config' $fp $mode $false $false 'ok' $cfg) }\n476\t        $useModel = $(if ($PSBoundParameters.ContainsKey('Value')) { $Value } else { $Model })\n477\t        switch -CaseSensitive ($Action) {\n478\t            'use' { if (-not (Test-PxcProvider $Provider) -or -not $useModel) { Stop-Pxc 'ArgumentInvalid' } }\n479\t            'ask' { if (-not (Test-PxcProvider $Provider) -or -not $PSBoundParameters.ContainsKey('Value') -or -not (Test-PxcEncodable $Value)) { Stop-Pxc 'ArgumentInvalid' } }\n480\t            'models' { if ($Provider -and -not (Test-PxcProvider $Provider)) { Stop-Pxc 'ArgumentInvalid' } }\n481\t            { $_ -ceq 'connect' -or $_ -ceq 'disconnect' } { if ($mode -cne 'Remote') { Stop-Pxc 'NotRemote' } }\n482\t        }\n483\t        if (-not $PSCmdlet.ShouldProcess($display, $Action)) { return (New-PxcResult $Action $fp $mode $true $false 'whatif' $null) }\n484\t        $key = Get-PxcSelectionKey $cfg $fp\n485\t        switch -CaseSensitive ($Action) {\n486\t            'connect' { return (Connect-PxcTarget $cfg $fp $(if ($PSBoundParameters.ContainsKey('Credential')) { $Credential })) }\n487\t            'disconnect' { return (Disconnect-PxcTarget $fp) }\n488\t            'use' {\n489\t                $r = Invoke-PxcDispatch $cfg $fp 'models' $RepositoryRoot $Provider '' '' $false\n490\t                $advertised = Get-PxcProp (Get-PxcProp $r 'data') 'models'\n491\t                if (-not (Test-PxcModel @($advertised) $Provider $useModel)) { Stop-Pxc 'ModelNotAdvertised' }\n492\t                $inner = $null\n493\t                if (-not $script:Selection.TryGetValue($key, [ref]$inner)) { $inner = [Collections.Generic.Dictionary[string, string]]::new([StringComparer]::Ordinal); $script:Selection[$key] = $inner }\n494\t                $inner[$Provider] = $useModel\n495\t                return (New-PxcResult 'use' $fp $mode $false $true 'selected' ([ordered]@{ provider = $Provider; model = $useModel; modelState = 'advertised_not_execution_tested' }))\n496\t            }\n497\t            'ask' {\n498\t                $m = $null\n499\t                if ($PSBoundParameters.ContainsKey('Model')) { $m = $Model }\n500\t                else { $inner = $null; if ($script:Selection.TryGetValue($key, [ref]$inner)) { $null = $inner.TryGetValue($Provider, [ref]$m) } }\n501\t                if (-not $m) { Stop-Pxc 'NoModelSelected' }\n502\t                return (Invoke-PxcDispatch $cfg $fp 'ask' $RepositoryRoot $Provider $m $Value $false)\n503\t            }\n504\t            default { return (Invoke-PxcDispatch $cfg $fp $Action $RepositoryRoot $Provider '' '' ([bool]$Force -and ($Action -ceq 'stop' -or $Action -ceq 'restart'))) }\n505\t        }\n506\t    } catch { $PSCmdlet.ThrowTerminatingError((Resolve-PxcError $_)) }\n507\t}\n508\tfunction Invoke-ProximaOperation {\n509\t    [CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'Medium', PositionalBinding = $false)]\n510\t    param([Parameter(Mandatory = $true)][string]$Action, [Parameter(Mandatory = $true)][string]$BasePath, [Parameter(Mandatory = $true)][string]$TargetFingerprint,\n511\t        [Parameter(Mandatory = $true)][string]$ProtectedRoot, [string]$Provider, [string]$Model, [string]$Prompt, [switch]$Force)\n512\t    try {\n513\t        if (-not $script:OpActions.Contains($Action) -or $TargetFingerprint -cnotmatch '^[0-9a-f]{64}\\z' -or -not (Test-PxcPath $BasePath) -or -not (Test-PxcPath $ProtectedRoot)) { Stop-Pxc 'ArgumentInvalid' }\n514\t        if (($Provider -and -not (Test-PxcProvider $Provider)) -or ($Action -ceq 'ask' -and (-not (Test-PxcProvider $Provider) -or -not $Model -or -not (Test-PxcEncodable $Prompt)))) { Stop-Pxc 'ArgumentInvalid' }\n515\t        $opTarget = 'px target ' + $TargetFingerprint.Substring(0, 12)\n516\t        if (-not $PSCmdlet.ShouldProcess($opTarget, $Action)) { return (New-PxcResult $Action $TargetFingerprint 'Endpoint' $true $false 'whatif' $null) }\n517\t        return (Invoke-PxcCore $Action $BasePath $TargetFingerprint $ProtectedRoot $Provider $Model $Prompt ([bool]$Force -and ($Action -ceq 'stop' -or $Action -ceq 'restart')))\n518\t    } catch { $PSCmdlet.ThrowTerminatingError((Resolve-PxcError $_)) }\n519\t}\n520\t\n521\t# ---- concrete backend (qualified commands); replaceable ONLY through module scope by the isolated test harness ----\n522\tfunction Invoke-PxcHttpDefault($Req) {\n523\t    if ($PSVersionTable.PSEdition -cne 'Core') { Add-Type -AssemblyName System.Net.Http }\n5