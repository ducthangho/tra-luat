t 3) { $bad.Add(\"TARGET_EXAMPLES[$targeted]\") }; if ($bad.Count) { Stop-Case ($bad -join '; ') }\n377\t+    \"name/description; version $mv in frontmatter and Versions (both directions); six headings; three version domains; $targeted placeholder targets\"\n378\t+}\n379\t+Invoke-Case 'PM06' {\n380\t+    Assert-Gate $RtSetup $RtOut; $w = $RtOut.wrapper\n381\t+    if ($null -eq $w) { Stop-Case \"NOT_EXECUTED: manifest import failed before the wrapper ran: $($RtOut.error)\" }\n382\t+    $state = \"loaded_after=$($w.loaded_after) same_instance=$($w.same_instance) sentinel_intact=$($w.sentinel_intact)\"; $kept = $w.loaded_after -eq 1 -and $w.same_instance -and $w.sentinel_intact\n383\t+    if ($w.conflict) { if (-not $kept) { Stop-Case \"CONFLICT_WITH_RESET[$state]\" }; return \"ModuleConflict fail-closed; prior instance and sentinel untouched ($state)\" }\n384\t+    if ($w.error) { Stop-Case \"WRAPPER_ERROR[$($w.error)]\" } elseif (\"$($w.action)/$($w.outcome)\" -cne 'help/ok') { Stop-Case \"WRAPPER_HELP_NEGATIVE[$($w.action)/$($w.outcome)]\" }\n385\t+    if (-not $kept) { Stop-Case \"SILENT_RESET_OR_REIMPORT[$state]\" }\n386\t+    \"Run-Px help reused the manifest-imported instance; test-owned sentinel intact ($state)\"\n387\t+}\n388\t+$CxCases = @(@{ id = 'CX00'; file = ''; anchor = ''; replacement = ''; want = ''; before_import = $false },\n389\t+    @{ id = 'CX01'; file = 'scripts/ProximaControl.psd1'; anchor = '    AliasesToExport'; want = 'PM02:UNEXPECTED_KEY[ScriptsToProcess]'; before_import = $true\n390\t+        replacement = \"    ScriptsToProcess     = @('cx01-never-run.ps1')`r`n    AliasesToExport\" },\n391\t+    @{ id = 'CX02'; file = 'scripts/ProximaControl.psd1'; anchor = \"@('px', 'Invoke-ProximaOperation')\"; replacement = \"@('*')\"; want = 'PM02:WILDCARD_EXPORT[FunctionsToExport]'; before_import = $true },\n392\t+    @{ id = 'CX03'; file = 'scripts/ProximaControl.psd1'; anchor = '    AliasesToExport'; want = 'PM02:UNEXPECTED_KEY[NestedModules]'; befo