E_STATEMENT: background pipeline' }; continue }\n192\t            if (($pr.PropertyType -eq [bool] -and $v -ne ($kind -ceq 'NamedBlockAst' -and $pr.Name -ceq 'Unnamed')) -or\n193\t                (($v -is [Ast] -or ($v -is [Collections.ICollection] -and $v.Count)) -and $pr.Name -cnotin $shape[$kind])) { Stop-Case \"EXECUTABLE_STATEMENT: $kind.$($pr.Name)\" }\n194\t        }\n195\t    }\n196\t    $st = @(if ($ast.EndBlock) { $ast.EndBlock.Statements })\n197\t    $ce = $(if ($st.Count -eq 1 -and $st[0] -is [PipelineAst] -and @($st[0].PipelineElements).Count -eq 1) { $st[0].PipelineElements[0] })\n198\t    if ($ce -isnot [CommandExpressionAst] -or @($ce.Redirections).Count -or $ce.Expression -isnot [HashtableAst]) { Stop-Case \"NOT_SINGLE_HASHTABLE: $($st.Count) top-level statement(s)\" }\n199\t    try { $data = $ce.Expression.SafeGetValue() } catch { Stop-Case \"UNSAFE_VALUE: $($_.Exception.Message)\" }\n200\t    $script:ManifestAst = $ce.Expression; $script:ManifestData = $data; 'plain unnamed end block with exactly one hashtable data expression; SafeGetValue accepted'\n201\t}"}]},"parent_tool_use_id":null,"session_id":"e1e04ee9-2119-4e46-af04-4c82507c84cb","uuid":"d1988e7d-cb9d-4731-a0b0-82bd33b4660e","timestamp":"2026-11-09T02:12:06.636Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/scratch/wp1285-claude-cross-audit-H4/.agents/skills/proxima-control/tests/ProximaManifest.Tests.ps1","content":"Invoke-Case 'PM01' {\n    if (-not $ManifestPresent) { Stop-Case 'MANIFEST_ABSENT: scripts/ProximaControl.psd1' }\n    $tk = $null; $er = $null; $ast = [Parser]::ParseFile($ManifestPath, [ref]$tk, [ref]$er); if (@($er).Count) { Stop-Case \"PARSE_ERROR: $(@($er)[0].Message)\" }\n    # WP1285-R1-F01: allow data nodes and child edges throughout the tree, before SafeGetValue. Reflection feature-detects PS7 properties on PS5.1.\n    # All execution flags must be false except the root end block's Unnamed; comments and literal string characters are not executable s