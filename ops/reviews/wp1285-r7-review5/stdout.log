"\n406\t+}\n407\t+if ($Counterexamples) {\n408\t+    foreach ($cx in $CxCases) {\n409\t+        Invoke-Case $cx.id {\n410\t+            if (-not ($ManifestPresent -and $SkillPresent)) { Stop-Case 'CANDIDATE_ABSENT: counterexamples need the manifest and SKILL.md' }\n411\t+            $dir = [IO.Path]::Combine($Run, $cx.id); $src = [IO.Path]::Combine($dir, 'addon'); $rep = [IO.Path]::Combine($dir, 'report.json')\n412\t+            $rec = [ordered]@{ id = $cx.id; mutated_file = $cx.file; anchor = $cx.anchor; replacement = $cx.replacement; source_dir = $src; sha256_before = $null\n413\t+                sha256_after = $null; command = $null; rc = $null; report_path = $rep; want = $cx.want; matched = $null; credited = $false; verdict = $null }\n414\t+            $Report.counterexamples.Add($rec)\n415\t+            try {\n416\t+                foreach ($rel in $Before.Keys) {\n417\t+                    if ($Before[$rel] -ceq 'reparse') { throw \"reparse point in add-on tree: $rel\" }\n418\t+                    $to = Join-Addon $src $rel; $null = [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($to)); [IO.File]::Copy((Join-Addon $Root $rel), $to)\n419\t+                }\n420\t+                if ($cx.file) {\n421\t+                    $p = Join-Addon $src $cx.file; $t = [IO.File]::ReadAllText($p, $Utf8); $rec.sha256_before = Get-FileSha $p; $at = $t.IndexOf($cx.anchor, [StringComparison]::Ordinal)\n422\t+                    if ($at -lt 0 -or $t.IndexOf($cx.anchor, $at + 1, [StringComparison]::Ordinal) -ge 0) { throw \"mutation anchor absent or not unique: $($cx.anchor)\" }\n423\t+                    [IO.File]::WriteAllText($p, $t.Substring(0, $at) + $cx.replacement + $t.Substring($at + $cx.anchor.Length), $Utf8)\n424\t+                    $rec.sha256_after = Get-FileSha $p; Add-Artifact \"$($cx.id)-mutated-source\" $p\n425\t+                }\n426\t+                $ch = Start-Child $cx.id @('-NoProfile', '-NonInteractive', '-File', $PSCommandPath, '-AddonRoot', $src, '-ScratchRoot', $dir, '-ReportPath', $rep) 1200\n427\t+                $rec.command = \"$SelfExe $($ch.arguments)\"; $rec.rc = $ch.rc; if (-not [IO.File]::Exists($rep)) { throw \"child report absent (rc=$($ch.rc))\" }\n428\t+                Add-Artifact \"$($cx.id)-report\" $rep; $rec.verdict = Test-CxKill $cx $ch.rc ([IO.File]::ReadAllText($rep, $Utf8) | ConvertFrom-Json) $rec; $rec.verdict\n429\t+            } catch { $rec.verdict = \"NOT_CREDITED: $($_.Exception.Message)\"; throw }\n430\t+            finally { Save-Text \"$($cx.id)-record\" ([IO.Path]::Combine($dir, 'record.json')) ($rec | ConvertTo-Json -Depth 5) }\n431\t+        }\n432\t+    }\n433\t+}\n434\t+Invoke-Case 'PM07' {\n435\t+    $bad = [Collections.Generic.List[string]]::new()\n436\t+    if (-not $SkillPresent) { $bad.Add('SKILL_ABSENT: SKILL.md') }\n437\t+    else {\n438\t+        foreach ($tok in '_RELEASE_EXCLUDE_DIRS', 'Package') { if ((Get-Section 'Scope').IndexOf($tok, [StringComparison]::Ordinal) -lt 0) { $bad.Add(\"ISOLATION_STATEMENT_MISSING[$tok]\") } }\n439\t+        $deny = [ordered]@{ 'guid-or-device-id' = '[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}'; 'user-profile-path' = '[a-z]:\\\\users\\\\'; 'secret' = 'convertto-securestring'\n440\t+            'real-host-url' = 'https?://(?![^/\\s]*\\.invalid(?:[/:\\s]|$))'; 'policy-override' = 'executionpolicy\\s+(bypass|unrestricted)|set-executionpolicy' }\n441\t+        foreach ($k in $deny.Keys) { if ([regex]::IsMatch($Doc.text, $deny[$k], 'IgnoreCase, CultureInvariant')) { $bad.Add(\"FORBIDDEN_CLAIM[$k]\") } }\n442\t+        $imports = 0; $wrappers = 0\n443\t+        foreach ($c in $DocCommands) {\n444\t+            if ($c.errors) { $bad.Add(\"EXAMPLE_PARSE[$($c.line)]\"); continue }\n445\t+            if ($c.name -ceq 'Import-Module') {\n446\t+                $imports++; if (-not \"$($c.params['Name'])\".EndsWith('\\scripts\\ProximaControl.psd1', [StringComparison]::Ordinal) -or $c.params.Contains('Force')) { $bad.Add(\"IMPORT_EXAMPLE[$($c.line)]\") }\n447\t+                continue\n448\t+            }\n449\t+            if ($c.name.EndsWith('\\scripts\\Run-Px.ps1', [StringComparison]::Ordinal)) { $wrappers++ } elseif ($c.name -cne 'px') { continue }\n450\t+            if (-not $PxActions.Contains($c.action)) { $bad.Add(\"EXAMPLE_ACTION[$($c.line)]\"); continue }\n451\t+            if ($c.action -cne 'help') { foreach ($k in 'ConfigPath', 'RepositoryRoot', 'TargetId') { if (-not $c.params.Contains($k)) { $bad.Add(\"EXAMPLE_TARGET_MISSING[$k $($c.line)]\") } } }\n452\t+            if ($c.params.Contains('Credential') -and $c.action -cne 'connect') { $bad.Add(\"CREDENTIAL_OUTSIDE_CONNECT[$($c.line)]\") }\n453\t+        }\n454\t+        if (-not $imports -or -not $wrappers) { $bad.Add(\"ENTRY_EXAMPLE_MISSING[import=$imports wrapper=$wrappers]\") }\n455\t+        $refs = @([regex]::Matches($Doc.text, '`((?:scripts|tests)/[A-Za-z0-9._-]+|config\\.example\\.json)`') | ForEach-Object { $_.Groups[1].Value })\n456\t+        foreach ($r in $refs) { if (-not [IO.File]::Exists((Join-Addon $Root $r))) { $bad.Add(\"BROKEN_REF[$r]\") } }\n457\t+        foreach ($r in 'scripts/ProximaControl.psd1', 'scripts/Run-Px.ps1', 'tests/ProximaManifest.Tests.ps1') { if ($refs -cnotcontains $r) { $bad.Add(\"REF_MISSING[$r]\") } }\n458\t+    }\n459\t+    $after = Get-Snapshot $Root; $v = $null\n460\t+    foreach ($k in $Before.Keys) { if (-not $after.TryGetValue($k, [ref]$v) -or $v -cne $Before[$k]) { $bad.Add($(if ($Legacy -ccontains $k) { \"S1S2_CHANGED[$k]\" } else { \"SOURCE_CHANGED_BY_RUN[$k]\" })) } }\n461\t+    foreach ($k in $after.Keys) { if (-not $Before.ContainsKey($k)) { $bad.Add(\"SOURCE_ADDED_BY_RUN[$k]\") } }\n462\t+    if ($bad.Count) { Stop-Case ($bad -join '; ') }\n463\t+    \"optional/excluded publication stated; $(@($DocCommands).Count) example lines valid; file refs resolve; $($Before.Count) add-on files byte-identical before/after\"\n464\t+}\n465\t+$required = @($Ids) + @($(if ($Counterexamples) { $CxCases | ForEach-Object { $_.id } })); $Report.required_ids = $required\n466\t+$missing = @($required | Where-Object { $want1 = $_; @($Results | Where-Object { $_.id -ceq $want1 }).Count -ne 1 })\n467\t+if ($missing.Count) { throw \"IDs not executed exactly once: $($missing -join ',')\" }\n468\t+Complete-Run $(if (@($Results | Where-Object { $_.outcome -ceq 'setup_error' }).Count) { 2 } elseif (@($Results | Where-Object { $_.outcome -cne 'passed' }).Count) { 1 } else { 0 })\n469\t"}]},"parent_tool_use_id":null,"session_id":"e1e04ee9-2119-4e46-af04-4c82507c84cb","uuid":"3e19e789-cc33-4c67-9d71-9847658cb600","timestamp":"2026-11-09T02:01:57.558Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/scratch/proxima-rest-20261108/S3-Claude5-entire-product.diff","content":"diff --git a/.agents/skills/proxima-control/SKILL.md b/.agents/skills/proxima-control/SKILL.md\nnew file mode 100644\nindex 0000000..88f0376\n--- /dev/null\n+++ b/.agents/skills/proxima-control/SKILL.md\n@@ -0,0 +1,64 @@\n+---\n+name: proxima-control\n+description: Điều khiển MỘT đích Proxima khai báo tường minh qua px hoặc Run-Px.ps1 (trợ giúp, cấu hình, trạng thái, model, hỏi, start/stop/restart, connect/disconnect), luôn kèm ConfigPath, RepositoryRoot, TargetId và dùng -WhatIf để xem trước.\n+version: 2.0.0\n+---\n+## Phạm vi (Scope)\n+- Add-on tùy chọn, độc lập, chỉ công bố trong repository để dễ tìm: không tự cài, không tự kích hoạt, không đổi endpoint, dịch vụ,\n+  tài khoản hay profile. `.agents/` nằm trong `_RELEASE_EXCLUDE_DIRS` của bộ đóng gói lõi nên add-on KHÔNG vào gói Package của\n+  tra-luat; xoá thư mục add-on thì skill lõi vẫn nguyên vẹn.\n+- Thành phần: `scripts/ProximaConfig.psm1` (S1, đọc cấu hình), `scripts/ProximaControl.psm1` + `scripts/Run-Px.ps1` (S2) và\n+  `scripts/ProximaControl.psd1` (S3, manifest dữ liệu thuần); `config.example.json` chỉ chứa giá trị giả.\n+- Câu trả lời từ model, AI hay web là dữ liệu CHƯA tin cậy; trích nguyên văn pháp luật vẫn theo [SKILL.md gốc](../../../SKILL.md) và nguồn\n+  đã kiểm chứng. Quy trình packet, review, land: [protocol](../../../docs/PROTOCOL_DA_PHIEN.md) (không chép lại ở đây).\n+\n+## Điểm vào (Entry points)\n+Đường dẫn tính từ gốc repository; `<RepoRoot>` là chỗ giữ:\n+```powershell\n+Import-Module -Name '<RepoRoot>\\.agents\\skills\\proxima-control\\scripts\\ProximaControl.psd1' -DisableNameChecking\n+px help\n+& '<RepoRoot>\\.agents\\skills\\proxima-control\\scripts\\Run-Px.ps1' help\n+```\n+- Manifest chỉ khai `RootModule` là `ProximaControl.psm1` và đúng hai hàm `px`, `Invoke-ProximaOperation`; không nạp sẵn S1.\n+  Hỗ trợ Windows PowerShell 5.1 (Desktop) và PowerShell 7 (Core).\n+- Trạng thái (session, model đã chọn) chỉ sống trong tiến trình hiện tại; tiến trình mới luôn bắt đầu chưa kết nối.\n+- Wrapper chỉ tái dùng module đã nạp nếu đường dẫn của nó đúng là `scripts/ProximaControl.psm1` bên cạnh (cùng instance, giữ trạng thái);\n+  nạp từ chỗ khác, hoặc runtime báo đường dẫn khác, thì dừng với `ProximaControl.ModuleConflict`, không reset, không nạp đè.\n+- Đừng `Import-Module -Force` lần nữa (mất session và lựa chọn). Gỡ bằng `Remove-Module ProximaControl`: đóng session do module\n+  sở hữu và mất toàn bộ trạng thái.\n+\n+## Mục tiêu (Target)\n+Mọi hành động trừ `help` cần đủ `-ConfigPath`, `-RepositoryRoot`, `-TargetId` (khớp Ordinal với tệp cấu hình). Không đích mặc định,\n+không dò môi trường hay thư mục hiện hành, không tự kết nối. Giá trị trong `<...>` là chỗ giữ:\n+```powershell\n+px config -ConfigPath '<ConfigPath>' -RepositoryRoot '<RepoRoot>' -TargetId '<TargetId>'\n+px models '<provider>' -ConfigPath '<ConfigPath>' -RepositoryRoot '<RepoRoot>' -TargetId '<TargetId>'\n+px use '<provider>' '<provider>/<model>' -ConfigPath '<ConfigPath>' -RepositoryRoot '<RepoRoot>' -TargetId '<TargetId>'\n+px ask '<provider>' 'Nội dung câu hỏi' -ConfigPath '<ConfigPath>' -RepositoryRoot '<RepoRoot>' -TargetId '<TargetId>'\n+px connect -ConfigPath '<ConfigPath>' -RepositoryRoot '<RepoRoot>' -TargetId '<TargetId>' -Credential (Get-Credential)\n+```\n+- Chỉ `connect` nhận `-Credential` (PSCredential); hành động khác không hỏi và không đọc thông tin đăng nhập.\n+- Không suy diễn: `ask` khi chưa `use` (và không có `-Model`) báo `NoModelSelected`; model không được quảng bá báo\n+  `ModelNotAdvertised`. Không fallback sang model hay đích khác, không tự thử lại.\n+\n+## Xem trước (WhatIf)\n+`px` gọi ShouldProcess TRƯỚC mọi tác động, kể cả truy vấn `status`/`models`; mọi hành động có `-WhatIf` và `-Confirm`, wrapper chuyển\n+tiếp đúng hai cờ ấy. `-Force` chỉ vượt chốt \"còn yêu cầu đang chờ\" của `stop`/`restart`, KHÔNG BAO GIỜ vượt `-WhatIf`:\n+```powershell\n+px restart -ConfigPath '<ConfigPath>' -RepositoryRoot '<RepoRoot>' -TargetId '<TargetId>' -Force -WhatIf\n+& '<RepoRoot>\\.agents\\skills\\proxima-control\\scripts\\Run-Px.ps1' stop -ConfigPath '<ConfigPath>' -RepositoryRoot '<RepoRoot>' -TargetId '<TargetId>' -WhatIf\n+```\n+\n+## Phiên bản (Versions)\n+Ba miền danh tính tách biệt, không suy miền này từ miền kia:\n+1. Add-on trong repository: `ModuleVersion` 2.0.0 của manifest, cộng commit và tree Git chứa nó. Major 2 tách khỏi module 1.0.1\n+   đã thấy ở P0; không khẳng định module trên máy chủ đã được cập nhật.\n+2. Module điều khiển đã cài trên endpoint: cặp băm `moduleSha256` + `configModuleSha256` do handshake trả về khi `connect`.\n+3. Gateway runtime: `FileVersion` của `Proxima.exe` là NOT_MEASURED ở S2/S3; đo nó thuộc quan sát P4, không lén thêm vào S2.\n+   `status`/`models` không xác lập phiên bản runtime, quota, xác thực hay danh tính model upstream.\n+\n+## Giới hạn (Limits)\n+- Kiểm listener là ảnh chụp và kiểm băm rồi mới import cũng vậy: đổi tiến trình/cổng/tệp chen giữa là race đã khai. Xác thực WinRM\n+  thật chưa được đo; băm chỉ ràng tương thích mã, không chứng thực máy chủ; dịch vụ bọc (kiểu NSSM) bị từ chối.\n+- Kiểm thử: `tests/ProximaManifest.Tests.ps1` (manifest, tài liệu), `tests/ProximaControl.Tests.ps1` (S2), `tests/ProximaConfig.Tests.ps1`\n+  (S1). Một lượt xanh không chứng minh bản đã triển khai trên máy nào.\ndiff --git a/.agents/skills/proxima-control/scripts/ProximaControl.psd1 b/.agents/skills/proxima-control/scripts/ProximaControl.psd1\nnew file mode 100644\nindex 0000000..6acb20d\n--- /dev/null\n+++ b/.agents/skills/proxima-control/scripts/ProximaControl.psd1\n@@ -0,0 +1,13 @@\n+# ProximaControl.psd1 - wp1285 r1 (PROXIMA-P1-S3). Pure data manifest for the sibling ProximaControl.psm1 (S2): nine keys only.\n+# No NestedModules/RequiredModules/ScriptsToProcess: S1 ProximaConfig.psm1 is still loaded only by the S2 hash-before-import guard.\n+@{\n+    RootModule           = 'ProximaControl.psm1'\n+    ModuleVersion        = '2.0.0'\n+    GUID                 = '7f7055d6-51e3-4fb8-bbeb-7851a739bfb6'\n+    PowerShellVersion    = '5.1'\n+    CompatiblePSEditions = @('Desktop', 'Core')\n+    FunctionsToExport    = @('px', 'Invoke-ProximaOperation')\n+    CmdletsToExport      = @()\n+    VariablesToExport    = @()\n+    AliasesToExport      = @()\n+}\ndiff --git a/.agents/skills/proxima-control/tests/ProximaManifest.Tests.ps1 b/.agents/skills/proxima-control/tests/ProximaManifest.Tests.ps1\nnew file mode 100644\nindex 0000000..27b6836\n--- /dev/null\n+++ b/.agents/skills/proxima-control/tests/ProximaManifest.Tests.ps1\n@@ -0,0 +1,373 @@\n+# ProximaManifest.Tests.ps1 - wp1285 r1 (PROXIMA-P1-S3): self-contained harness (no Pester) for scripts/ProximaControl.psd1 (M1) + SKILL.md (M2).\n+#   powershell.exe|pwsh.exe -NoProfile -NonInteractive -File <copy>\\ProximaManifest.Tests.ps1 -AddonRoot <tree>\\.agents\\skills\\proxima-control `\n+#     -ScratchRoot <existing dir outside the repository> -ReportPath <json outside the add-on> [-Counterexamples]\n+# rc 0: PM01..PM07 (+CX00..CX04) passed, evidence re-verified. rc 1: a property failed (no manifest/SKILL => all seven run and fail\n+# MANIFEST_ABSENT/SKILL_ABSENT). rc 2: setup error or unavailable runtime only. PM01/PM02 judge the manifest STATICALLY (AST + SafeGetValue);\n+# Fresh children call help only: 'runtime' = PM03+PM06, 'tamper' = PM04. Evidence is retained and re-hashed; children inherit policy.\n+using namespace System.Management.Automation.Language\n+[CmdletBinding()]\n+param([Parameter(Mandatory = $true)][string]$AddonRoot, [Parameter(Mandatory = $true)][string]$ScratchRoot,\n+    [Parameter(Mandatory = $true)][string]$ReportPath, [switch]$Counterexamples)\n+Set-StrictMode -Version 3.0\n+$ErrorActionPreference = 'Stop'\n+$Ids = 'PM01', 'PM02', 'PM03', 'PM04', 'PM05', 'PM06', 'PM07'\n+$Want = @{ RootModule = 'ProximaControl.psm1'; ModuleVersion = '2.0.0'; GUID = '7f7055d6-51e3-4fb8-bbeb-7851a739bfb6'; PowerShellVersion = '5.1' }\n+$WantArrays = [ordered]@{ CompatiblePSEditions = @('Desktop', 'Core'); FunctionsToExport = @('px', 'Invoke-ProximaOperation'); CmdletsToExport = @()\n+    VariablesToExport = @(); AliasesToExport = @() }\n+$KeySet = [Collections.Generic.HashSet[string]]::new([string[]](@($Want.Keys) + @($WantArrays.Keys)), [StringComparer]::Ordinal)\n+$PxActions = [Collections.Generic.HashSet[string]]::new([string[]]('help config status models use ask start stop restart connect disconnect' -split ' '), [StringComparer]::Ordinal)\n+$Legacy = 'scripts/ProximaConfig.psm1', 'scripts/ProximaControl.psm1', 'scripts/Run-Px.ps1', 'config.example.json', 'tests/ProximaConfig.Tests.ps1', 'tests/ProximaControl.Tests.ps1'\n+$Tags = 'Scope', 'Entry points', 'Target', 'WhatIf', 'Versions', 'Limits'\n+$Utf8 = [Text.UTF8Encoding]::new($false, $true); $Sha = [Security.Cryptography.SHA256]::Create(); $Inv = [Globalization.CultureInfo]::InvariantCulture\n+$Results = [Collections.Generic.List[object]]::new(); $Artifacts = [Collections.Generic.List[object]]::new(); $Children = [Collections.Generic.List[object]]::new()\n+$Report = [ordered]@{ schema = 'proxima_manifest_tests.v1'; ps_version = \"$($PSVersionTable.PSVersion)\"; ps_edition = \"$($PSVersionTable.PSEdition)\"\n+    culture = [Globalization.CultureInfo]::CurrentCulture.Name; ui_culture = [Globalization.CultureInfo]::CurrentUICulture.Name; launch = $null; addon_root = $AddonRoot\n+    harness_sha256 = $null; git_head = 'not_measured (no git in harness; the operator records H/tree)'; source_hashes = $null; manifest_state = 'unknown'\n+    skill_state = 'unknown'; setup_error = $null; required_ids = @(); total = 0; passed = 0; failed_ids = @(); setup_error_ids = @(); runtime_children = 0; tamper = $null\n+    cases = $Results; children = $Children; counterexamples = [Collections.Generic.List[object]]::new(); evidence = [ordered]@{ dir = $null; artifacts = $Artifacts; check = $null }; cleanup = $null }\n+$Run = $null; $Completing = $false\n+function Get-FileSha([string]$P) { if ([IO.File]::Exists($P)) { ([BitConverter]::ToString($Sha.ComputeHash([IO.File]::ReadAllBytes($P))) -replace '-', '').ToLowerInvariant() } }\n+function Join-Addon([string]$Base, [string]$Rel) { [IO.Path]::Combine($Base, $Rel.Replace([char]'/', [IO.Path]::DirectorySeparatorChar)) }\n+function Test-Inside([string]$Path, [string]$Dir) { $s = [IO.Path]::DirectorySeparatorChar; ($Path.TrimEnd($s) + $s).StartsWith($Dir.TrimEnd($s) + $s, [StringComparison]::OrdinalIgnoreCase) }\n+function Add-Artifact([string]$Role, [string]$Path) { $Artifacts.Add([ordered]@{ role = $Role; path = $Path; sha256 = (Get-FileSha $Path) }) }\n+function Save-Text([string]$Role, [string]$Path, [string]$Text) { [IO.File]::WriteAllText($Path, $Text, $Utf8); Add-Artifact $Role $Path }\n+# Property failures carry a marker; any other exception inside a case is a setup/runtime error (rc 2), never a test outcome.\n+function Stop-Case([string]$Reason) { $e = [Exception]::new($Reason); $e.Data['pm'] = 1; throw $e }\n+function Invoke-Case([string]$Id, [scriptblock]$Body) {\n+    $caseRec = [ordered]@{ id = $Id; outcome = 'passed'; reason = $null; detail = $null }\n+    try { $caseRec.detail = & $Body } catch { $caseRec.reason = \"$($_.Exception.Message)\"; $caseRec.outcome = $(if ($_.Exception.Data.Contains('pm')) { 'failed' } else { 'setup_error' }) }\n+    $Results.Add([pscustomobject]$caseRec)\n+}\n+function Get-Snapshot([string]$Base) {\n+    $map = [Collections.Generic.SortedDictionary[string, string]]::new([StringComparer]::Ordinal); $todo = [Collections.Generic.Stack[string]]::new(); $todo.Push($Base)\n+    while ($todo.Count) {\n+        foreach ($p in [IO.Directory]::GetFileSystemEntries($todo.Pop())) {\n+            $a = [int][IO.File]::GetAttributes($p); $rel = $p.Substring($Base.Length + 1).Replace([char]'\\', [char]'/')\n+            if ($a -band 0x400) { $map[$rel] = 'reparse' } elseif ($a -band 0x10) { $todo.Push($p) } else { $map[$rel] = Get-FileSha $p }\n+        }\n+    }\n+    return , $map\n+}\n+function ConvertTo-ArgText([string]$T) { if ($T -cmatch '^[A-Za-z0-9_.:/\\\\-]+$') { return $T }; '\"' + (($T -replace '(\\\\*)\"', '$1$1\\\"') -replace '(\\\\+)$', '$1$1') + '\"' }\n+function Start-Child([string]$Role, [string[]]$ArgList, [int]$TimeoutSec) {\n+    $base = [IO.Path]::Combine($Run, ('child{0:d2}-{1}' -f $Children.Count, $Role))\n+    $psi = [Diagnostics.ProcessStartInfo]::new($SelfExe); $psi.Arguments = @($ArgList | ForEach-Object { ConvertTo-ArgText $_ }) -join ' '\n+    $psi.UseShellExecute = $false; $psi.CreateNoWindow = $true; $psi.WorkingDirectory = $Run; foreach ($n in 'Input', 'Output', 'Error') { $psi.\"RedirectStandard$n\" = $true }\n+    $ch = [ordered]@{ role = $Role; exe = $SelfExe; argv = $ArgList; arguments = $psi.Arguments; cwd = $Run; started_utc = [DateTime]::UtcNow.ToString('o', $Inv)\n+        ended_utc = $null; rc = $null; timed_out = $false; stdout = \"$base.stdout.bin\"; stderr = \"$base.stderr.bin\" }\n+    $Children.Add($ch); $so = [IO.MemoryStream]::new(); $se = [IO.MemoryStream]::new(); $proc = [Diagnostics.Process]::Start($psi)\n+    try {\n+        $proc.StandardInput.Close(); $t1 = $proc.StandardOutput.BaseStream.CopyToAsync($so); $t2 = $proc.StandardError.BaseStream.CopyToAsync($se)\n+        if (-not $proc.WaitForExit($TimeoutSec * 1000)) { $ch.timed_out = $true; try { $proc.Kill() } catch { $null = $_ }; $null = $proc.WaitForExit(30000) }\n+        $null = $t1.Wait(30000); $null = $t2.Wait(30000); if ($proc.HasExited) { $ch.rc = $proc.ExitCode }\n+    } finally { $proc.Dispose(); [IO.File]::WriteAllBytes($ch.stdout, $so.ToArray()); [IO.File]::WriteAllBytes($ch.stderr, $se.ToArray()) }\n+    $ch.ended_utc = [DateTime]::UtcNow.ToString('o', $Inv); Add-Artifact \"$Role-stdout\" $ch.stdout; Add-Artifact \"$Role-stderr\" $ch.stderr\n+    Save-Text \"$Role-command\" \"$base.command.json\" ($ch | ConvertTo-Json -Depth 4)\n+    if ($ch.timed_out) { throw \"child $Role timed out after $TimeoutSec s (killed; partial output kept)\" }; return $ch\n+}\n+function Read-Skill([string]$Path) {\n+    $doc = [ordered]@{ text = ''; decode = 'ok'; fm = $null; sections = [Collections.Generic.List[object]]::new(); code = [Collections.Generic.List[string]]::new() }\n+    try { $doc.text = [IO.File]::ReadAllText($Path, $Utf8) } catch { $doc.decode = 'invalid_utf8' }\n+    $lines = @($doc.text -split \"`r?`n\"); $i = 0; $cur = $null; $lang = $null\n+    if ($lines[0] -ceq '---') {\n+        $fm = [ordered]@{}\n+        for ($i = 1; $i -lt $lines.Count -and $lines[$i] -cne '---'; $i++) { if ($lines[$i] -cmatch '^([a-z]+):\\s*(.*)$') { $fm[$Matches[1]] = $Matches[2].Trim() } }\n+        if ($i -lt $lines.Count) { $doc.fm = $fm; $i++ } else { $i = 0 }\n+    }\n+    for (; $i -lt $lines.Count; $i++) {\n+        $l = $lines[$i]\n+        if ($l -cmatch '^```(\\S*)') { $lang = $(if ($null -eq $lang) { $Matches[1] }); continue }\n+        if ($null -eq $lang -and $l -cmatch '^## (?:.*\\(([^()]+)\\)\\s*|.*)$') { $cur = [pscustomobject]@{ tag = \"$($Matches[1])\"; body = [Collections.Generic.List[string]]::new() }; $doc.sections.Add($cur); continue }\n+        if ($lang -ceq 'powershell') { $doc.code.Add($l) }\n+        if ($null -ne $cur) { $cur.body.Add($l) }\n+    }\n+    return [pscustomobject]$doc\n+}\n+function Get-Section([string]$Tag) { (@($Doc.sections | Where-Object { $_.tag -ceq $Tag } | ForEach-Object { $_.body }) -join \"`n\") }\n+function Get-DocCommands {\n+    foreach ($line in $Doc.code) {\n+        if (-not $line.Trim() -or $line.TrimStart().StartsWith('#')) { continue }\n+        $tk = $null; $er = $null; $cmd = [Parser]::ParseInput($line, [ref]$tk, [ref]$er).Find({ param($n) $n -is [CommandAst] }, $true)\n+        $item = [pscustomobject]@{ line = $line; errors = @($er).Count; name = ''; action = ''; params = @{} }\n+        if ($null -eq $cmd) { $item; continue }\n+        $el = @($cmd.CommandElements); $item.name = \"$($cmd.GetCommandName())\"\n+        if ($el.Count -gt 1 -and $el[1] -is [StringConstantExpressionAst]) { $item.action = $el[1].Value }\n+        for ($j = 1; $j -lt $el.Count; $j++) {\n+            if ($el[$j] -isnot [CommandParameterAst]) { continue }\n+            $nx = $(if ($j + 1 -lt $el.Count -and $el[$j + 1] -isnot [CommandParameterAst]) { $el[$j + 1] })\n+            $item.params[$el[$j].ParameterName] = $(if ($nx -is [StringConstantExpressionAst]) { $nx.Value } elseif ($null -ne $nx) { $nx.Extent.Text })\n+        }\n+        $item\n+    }\n+}\n+function Complete-Run([int]$Rc) {\n+    if ($script:Completing) { exit 2 }\n+    $script:Completing = $true; $errs = [Collections.Generic.List[string]]::new(); $n = 0\n+    try {\n+        $nested = @(foreach ($cx in $Report.counterexamples) { if ([IO.File]::Exists($cx.report_path)) { ([IO.File]::ReadAllText($cx.report_path, $Utf8) | ConvertFrom-Json).evidence.artifacts } })\n+        foreach ($a in @($Artifacts) + $nested) { $n++; if (-not $a.sha256 -or (Get-FileSha ([string]$a.path)) -cne [string]$a.sha256) { $errs.Add(\"EVIDENCE_MISSING_OR_CHANGED[$($a.role) $($a.path)]\") } }\n+    } catch { $errs.Add(\"EVIDENCE_CHECK_ERROR $($_.Exception.Message)\") }\n+    $Report.evidence.check = [ordered]@{ status = $(if ($errs.Count) { 'failed' } else { 'ok' }); verified = $n; errors = @($errs); scope = 'own + nested CX artifacts, after all cases' }\n+    $Report.cleanup = [ordered]@{ status = 'ok'; policy = 'retain_all: this run deletes nothing; evidence is re-hashed instead'; deleted = 0; retained_dir = $Run }; if ($errs.Count) { $Rc = 2 }\n+    foreach ($oc in 'failed', 'setup_error') { $Report[\"$($oc)_ids\"] = @($Results | Where-Object { $_.outcome -ceq $oc } | ForEach-Object { $_.id }) }\n+    $Report.passed = @($Results | Where-Object { $_.outcome -ceq 'passed' }).Count; $Report.total = $Results.Count; $Report.harness_sha256 = Get-FileSha $PSCommandPath\n+    $Report.runtime_children = @($Children | Where-Object { $_.role -ceq 'runtime' -or $_.role -ceq 'tamper' }).Count\n+    try { [IO.File]::WriteAllText($ReportPath, ($Report | ConvertTo-Json -Depth 8), $Utf8) } catch { Write-Host \"REPORT_WRITE_ERROR $($_.Exception.Message)\"; $Rc = 2 }\n+    Write-Host ('RESULT {0}/{1} passed; failed_ids=[{2}]; setup_error_ids=[{3}]; manifest={4}; skill={5}; setup_error={6}; evidence={7}; rc={8}' -f $Report.passed, $Report.total,\n+        ($Report.failed_ids -join ','), ($Report.setup_error_ids -join ','), $Report.manifest_state, $Report.skill_state, $Report.setup_error, $Report.evidence.check.status, $Rc)\n+    exit $Rc\n+}\n+trap { $Report.setup_error = \"$($_.Exception.Message)\"; Write-Host \"SETUP_ERROR $($Report.setup_error)\"; Complete-Run 2 }\n+$ChildScript = @'\n+# runtime (PM03+PM06): Test-ModuleManifest, manifest import, px help, then the UNCHANGED Run-Px.ps1 help in this same process with a test-owned\n+# in-memory sentinel in the module. tamper (PM04): import a private copy whose ProximaConfig.psm1 has a harmless sentinel line; S2 must reject it.\n+param([string]$Mode, [string]$ManifestPath, [string]$SentinelPath, [string]$OutPath)\n+Set-StrictMode -Version 3.0; $ErrorActionPreference = 'Stop'\n+$r = [ordered]@{ mode = $Mode; ps_version = \"$($PSVersionTable.PSVersion)\"; ps_edition = \"$($PSVersionTable.PSE