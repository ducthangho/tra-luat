xActions = [Collections.Generic.HashSet[string]]::new([string[]]@('help', 'config', 'status', 'models', 'use', 'ask', 'start', 'stop', 'restart', 'connect', 'disconnect'), [StringComparer]::Ordinal)\n44:function Get-PxcSha256([byte[]]$Bytes) {\n49:function New-PxcError([string]$Code) {\n53:function Stop-Pxc([string]$Code) { $ex = [Exception]::new(\"ProximaControl.$Code\"); $ex.Data['PxcCode'] = $Code; throw $ex }\n55:function Invoke-PxcStep([string]$PxcStepCode, [scriptblock]$PxcStepBody) {\n58:function Resolve-PxcError($Err) {\n71:if (-not $cfgOk) { throw (New-PxcError 'DependencyMismatch') }\n72:try { $script:CfgMod = Import-Module -Name $script:CfgPath -PassThru -DisableNameChecking -ErrorAction Stop } catch { throw (New-PxcError 'DependencyMismatch') }\n74:if ($null -eq $script:ReadConfig) { throw (New-PxcError 'DependencyMismatch') }\n76:function Test-PxcPath([string]$P) { return [bool](& $script:CfgMod { param($x) Test-PxPathSyntax $x } $P) }\n77:function Join-PxcPath([string]$Base, [string]$Rel) { if ($Base.Length -eq 3) { return $Base + $Rel }; return $Base + '\\' + $Rel }\n78:function Test-PxcProvider([string]$P) { return $P.Length -gt 0 -and $P.IndexOf([char]'/') -lt 0 }\n79:function Test-PxcEncodable([string]$S) { try { $null = $script:Utf8.GetBytes($S); return $true } catch { return $false } }\n80:function New-PxcCtx {\n84:function Close-PxcCtx($Ctx) { for ($i = $Ctx.Held.Count - 1; $i -ge 0; $i--) { try { $Ctx.Held[$i].Dispose() } catch { $null = $_ } } }\n85:function Get-PxcS1Code($Err) { if ($Err.Exception.Data.Contains('PxCode')) { return [string]$Err.Exception.Data['PxCode'] }; return '' }\n88:function Write-PxcField($Ms, $Value) {\n94:function Get-PxcFingerprint($Cfg) {\n103:function Get-PxcSelectionKey($Cfg, [string]$Fp) { return $Fp }\n104:function New-PxcResult([string]$Action, $Fp, $Mode, [bool]$DryRun, [bool]$Dispatched, [string]$Outcome, $Data) {\n110:function Read-PxcSmallFile([string]$Path, [int]$Max) {\n119:function Read-PxcJsonObject([byte[]]$Bytes) {\n124:function ConvertTo-PxcJsonString([string]$S) {\n134:function ConvertTo-PxcRecordJson($Rec) { return '{' + (@(foreach ($k in $Rec.Keys) { (ConvertTo-PxcJsonString $k) + ':' + (ConvertTo-PxcJsonString ([string]$Rec[$k])) }) -join ',') + '}' }\n137:function Get-PxcProp($Obj, [string]$Name) {\n145:function Get-PxcGateway([string]$Base) {\n190:function Get-PxcInt($V) {\n195:function Invoke-PxcHttp([string]$Url, [string]$Method, [string]$Path, $Body, [int]$Timeout, [bool]$Auth) {\n201:function Get-PxcAdvertised([string]$Url) {\n213:function Test-PxcModel($Ids, [string]$Provider, [string]$Model) {\n220:function Open-PxcDir([string]$Path, $Ctx) { return (& $script:CfgMod { param($p, $c) Open-PxChain $p $false 'PxcMissing' $c 0 } $Path $Ctx) }\n223:function Assert-PxcOutside($Node, $Prot, $Ctx) {\n227:function Open-PxcJournal([string]$Base, [string]$Protected, [bool]$Create, $Ctx) {\n243:function New-PxcRecordStream([string]$Base, $Dir, $Ctx) {\n253:function Write-PxcRecord($Fs, $Rec) {\n257:function Test-PxcRecordDone([string]$P) {\n265:function Get-PxcPending([string]$Base, [string]$Protected) {\n279:function Invoke-PxcAsk([string]$Base, [string]$Fp, [string]$Protected, [string]$Provider, [string]$Model, [string]$Prompt) {\n312:function Assert-PxcNoLoginUi {\n317:function Assert-PxcService([string]$Base) {\n329:function Invoke-PxcService([string]$Action, [string]$Base, [string]$Fp, [string]$Protected, [bool]$Force) {\n342:function Invoke-PxcCore([string]$Action, [string]$Base, [string]$Fp, [string]$Protected, [string]$Provider, [string]$Model, [string]$Prompt, [bool]$Force) {\n366:    $names = 'Action', 'BasePath', 'Provider', 'Model', 'Prompt', 'Force', 'TargetFingerprint', 'WhatIf', 'ModuleSha256', 'ConfigModuleSha256', 'ProtocolVersion'\n377:    foreach ($k in 'TargetFingerprint', 'ModuleSha256', 'ConfigModuleSha256') { if ($v[$k] -isnot [string] -or $v[$k] -cnotmatch '^[0-9a-f]{64}\\z') { & $fail 'RequestInvalid' } }\n392:    $files = @(\"$ctl\\ProximaControl.psm1\", \"$ctl\\ProximaConfig.psm1\"); $want = @($v['ModuleSha256'], $v['ConfigModuleSha256'])\n398:    $m = Import-Module -Name $files[0] -PassThru -DisableNameChecking -ErrorAction Stop\n405:function Invoke-PxcRemoteCall($Session, [string]$Base, [string]$Fp, [string]$Action, [string]$Provider, [string]$Model, [string]$Prompt, [bool]$Force) {\n407:        WhatIf = [bool]$WhatIfPreference; ModuleSha256 = $script:SelfSha; ConfigModuleSha256 = $script:ConfigSha; ProtocolVersion = $script:Protocol }\n421:function Invoke-PxcDispatch($Cfg, [string]$Fp, [string]$Action, [string]$Protected, [string]$Provider, [string]$Model, [string]$Prompt, [bool]$Force) {\n431:function Connect-PxcTarget($Cfg, [string]$Fp, $Credential) {\n452:function Disconnect-PxcTarget([string]$Fp) {\n464:function px {\n466:    param([Parameter(Position = 0)][string]$Action = 'help', [Parameter(Position = 1)][string]$Provider, [Parameter(Position = 2)][string]$Value,\n470:        if ($Action -ceq 'help') { return (New-PxcResult 'help' $null $null $false $false 'ok' $script:Help) }\n508:function Invoke-ProximaOperation {\n522:function Invoke-PxcHttpDefault($Req) {\n559:Export-ModuleMember -Function 'px', 'Invoke-ProximaOperation'\nrefs/metadata/wp1296-spec:ops/specs/wp1296-r1.md:14:Fix WP1285-R7-F01/P3 manifest-requires-guard-comment-regex, relatedhistoricalWP1285-R1-F01. Replace culture-sensitive commentregex with complete parsersemantic requirements validation BEFORE SchemaOk/Data or any import/child. Inspect ScriptBlockAst.ScriptRequirements/non-AST metadata safely PS51/7 StrictMode. Empty/default requirements allowed, meaningful requirement metadata rejected independent of spelling/culture. Missing/unexpected unsupported executablemetadata failclosed without rejecting ordinarycomments/literalstringcharacters. Preserve exactASTshape/node/childedge/bool/background/rootnamedblock/trap/parseerror protections and allPM01..07/CX00..04 behavior. No evaluating manifest todiscover requirements, no regexblacklist as soleauthority, no speculative ImportPowerShellDataFile dependency. Do not assume every nonnull requirements object ismeaningful; realruntime defaults mustbe inspected.\nrefs/metadata/wp1296-spec:ops/specs/wp1296-r2.md:14:Fix WP1285-R7-F01/P3 manifest-requires-guard-comment-regex, relatedhistoricalWP1285-R1-F01. Replace culture-sensitive commentregex with complete parsersemantic requirements validation BEFORE SchemaOk/Data or any import/child. Inspect ScriptBlockAst.ScriptRequirements/non-AST metadata safely PS51/7 StrictMode. Empty/default requirements allowed, meaningful requirement metadata rejected independent of spelling/culture. Missing/unexpected unsupported executablemetadata failclosed without rejecting ordinarycomments/literalstringcharacters. Preserve exactASTshape/node/childedge/bool/background/rootnamedblock/trap/parseerror protections and allPM01..07/CX00..04 behavior. No evaluating manifest todiscover requirements, no regexblacklist as soleauthority, no speculative ImportPowerShellDataFile dependency. Do not assume every nonnull requirements object ismeaningful; realruntime defaults mustbe inspected.\nrefs/metadata/wp1296-spec:ops/specs/wp1296-r3.md:14:Fix WP1285-R7-F01/P3 manifest-requires-guard-comment-regex, relatedhistoricalWP1285-R1-F01. Replace culture-sensitive commentregex with complete parsersemantic requirements validation BEFORE SchemaOk/Data or any import/child. Inspect ScriptBlockAst.ScriptRequirements/non-AST metadata safely PS51/7 StrictMode. Empty/default requirements allowed, meaningful requirement metadata rejected independent of spelling/culture. Missing/unexpected unsupported executablemetadata failclosed without rejecting ordinarycomments/literalstringcharacters. Preserve exactASTshape/node/childedge/bool/background/rootnamedblock/trap/parseerror protections and allPM01..07/CX00..04 behavior. No evaluating manifest todiscover requirements, no regexblacklist as soleauthority, no speculative ImportPowerShellDataFile