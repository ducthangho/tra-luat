{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python -B - <<'PY'\nfrom pathlib import Path, PureWindowsPath as WP\nimport json,hashlib,zipfile,subprocess,collections,re,csv\nE=Path('/workspace/scratch/proxima-remainder-20261109/r2');B='91be484a05ab40adf6573f11ef6ec0264fc9a3aa';H='15ad82f56924a0ccc99833ec73eec078ce00b726'; MT='.agents/skills/proxima-control/tests/ProximaManifest.Tests.ps1';MF='.agents/skills/proxima-control/scripts/ProximaControl.psd1'\nsha=lambda b:hashlib.sha256(b).hexdigest()\ndef load(p):return json.loads(p.read_text(encoding='utf-8-sig'))\ndef gitblob(h,p):return subprocess.check_output(['git','--no-optional-locks','show',h+':'+p])\nblobs={}; counts=collections.Counter(); allph=[]; sessions={}; archive_rows=[]\ndef blob(h,p):\n if (h,p) not in blobs:blobs[h,p]=gitblob(h,p)\n return blobs[h,p]\nfor stem,rootname,win,termrc in [('H2-native-first','H2-native-first-extracted','wp1296-H2-native',2),('H2-native-completion','H2-native-completion-extracted','wp1296-H2-completion',0),('literal-first','literal-first-extracted','wp1296-H2-literals',2),('literal-remaining','literal-remaining-extracted','wp1296-H2-literals-remaining',0)]:\n root=E/rootname; zpath=E/(stem+'-original.zip'); index=load(root/'source-byte-manifest.json'); wr=WP('C:/tl-win')/win\n def loc(s):return root.joinpath(*WP(s).relative_to(wr).parts)\n with zipfile.ZipFile(zpath) as z:\n  assert set(z.namelist())==set(index)|{'source-byte-manifest.json'}\n  for p,item in index.items():\n   data=z.read(p);assert len(data)==item['bytes'] and sha(data)==item['sha256'] and data==(root/p).read_bytes(),p\n  assert z.read('source-byte-manifest.json')==(root/'source-byte-manifest.json').read_bytes()\n cmds=[json.loads(s) for s in (root/'command-receipts.jsonl').read_text().splitlines()];cmdmap={c['label']:c for c in cmds};assert len(cmdmap)==len(cmds)\n for cmd in cmds:assert sha((root/'logs'/(cmd['label']+'.log')).read_bytes())==cmd['log_sha256']\n m=load(root/'operator-inputs/manifest.json');assert m['candidate']==H and m['baseline']==B and m['tree']=='50fbceb65cea60cc62222c3cd3a3651a6dd13981'\n for kind,h in [('base',B),('candidate',H)]:\n  for p,dig in m[kind+'_files'].items():assert sha(blob(h,p))==dig==sha((root/'operator-inputs'/kind/p).read_bytes())\n for f,hp in [('ProximaManifest.Tests.ps1',MT),('ProximaControl.Tests.ps1','.agents/skills/proxima-control/tests/ProximaControl.Tests.ps1')]:assert (root/'harness'/f).read_bytes()==blob(H,hp)\n norm=lambda s:s.replace('\\\\r\\\\n','\\\\n').lstrip('\\\\ufeff')\n rollback=(root/'harness/rollback-requirements-only.ps1').read_text(encoding='utf-8-sig')\n assert norm(rollback)==norm(blob(H,MT).decode()).replace('    Assert-NoScriptRequirements \"'$ast'\"','    # operator private rollback: requirements call intentionally removed')\n assert load(root/'terminal.json')['rc']==termrc and load(root/'lock-release.json')['released'] and load(root/'lock-release.json')['after']==''\n sid=load(root/'lock-release.json')['session']; sessions[rootname]=sid\n ph=load(root/'phase-progress.json')['phases']\n if (root/'measurement.json').exists():assert load(root/'measurement.json')['passed'] and ph==load(root/'measurement.json')['phases']\n for label,row in ph.items():\n  rr=load(root/'reports'/(label+'.json'));assert rr==row['report'] and row['rc']==cmdmap[label]['rc']\n  assert not rr['setup_error'] and not rr['setup_error_ids'] and len(rr['cases'])==rr['total'] and rr['passed']==sum(c['outcome']=='passed' for c in rr['cases'])\n  assert rr['ps_version']==('5.1.26100.9711' if row['shell']=='ps51' else '7.6.9')\n  if not label.startswith('legacy-'):\n   assert row['parser']==load(root/'reports'/(label+'-parser.json'))\n   assert row['parser']['culture']==row['culture']==rr['culture'] and rr['evidence']['check']['status']=='ok'\n   assert rr['runtime_children']==sum(c['role'] in ['runtime','tamper'] for c in rr['children'])\n   assert len(rr['required_ids'])==rr['total'] and set(rr['required_ids'])=={c['id'] for c in rr['cases']}\n   fh=loc(rr['addon_root'])/'scripts/ProximaControl.psd1';assert sha(fh.read_bytes())==row['manifest_sha256']\n   h=B if label.startswith('baseline-') else H; origin=norm(blob(h,MF).decode()); actual=norm(fh.read_text(encoding='utf-8-sig'))\n   if label.startswith('literal-'):expected=origin.replace(\\\"'ProximaControl.psm1'\\\",\\\"'#REQUIRES -Version 5.1'\\\")\n   elif row['shape']:\n    expected=origin.rstrip()+' &\\\\n' if row['shape']=='background' else 'end {\\\\n'+origin+'\\\\n}\\\\n'+(\\\"clean { 'WP1296_CLEAN_CONTROL' }\\\\n\\\" if row['shape']=='end-clean' else '')\n   else:expected=row['prefix']+origin\n   assert actual==expected,(label,'fixture')\n   hs=loc(rr['launch']['command_line'].split(' -File ')[1].split(' -AddonRoot ')[0].strip('\\\"')) if False else None\n   expectedh=sha(blob(B,MT)) if label.startswith('baseline-') else sha((root/'harness/rollback-requirements-only.ps1').read_bytes()) if label.startswith('rollback-') else sha(blob(H,MT))\n   assert row['source_harness_sha256']==rr['harness_sha256']==expectedh\n   marker=f\\\"RESULT {rr['passed']}/{rr['total']} passed;\\\"\n   log=(root/'logs'/(label+'.log')).read_text(encoding='utf-8-sig');assert marker in log and f\\\"rc={row['rc']}\\\" in log\n  allph.append((rootname,root,label,row));counts['phase_observations']+=1\n counts['sourcefiles']+=len(index);counts['commands']+=len(cmds);archive_rows.append((stem,sha(zpath.read_bytes()),len(index),len(cmds),len(ph),termrc))\nprint('ARCHIVE_RECOMPUTATION',archive_rows)\ncore={label:row for _,_,label,row in allph if not label.startswith('literal-')};assert len(core)==88 and len(allph)==95\npm=lambda r,id:next(c for c in r['report']['cases'] if c['id']==id)\nfor label,row in core.items():\n rr=row['report']\n if label.startswith(('normal-','comment-','CX-','legacy-')):\n  n=12 if label.startswith('CX-') else 26 if label.startswith('legacy-') else 7\n  assert row['rc']==0 and rr['passed']==rr['