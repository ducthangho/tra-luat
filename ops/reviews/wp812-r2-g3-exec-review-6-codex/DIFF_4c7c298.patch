+def _che_do_0054(root: Path, spec: bytes) -> bool:
+    """Đúng MỘT dòng khai + ba phép đo land-OID của ADR-0052 (đường dẫn ADR-0054) + đã kích hoạt; không đo được ⇒ False."""
