+    oid, m = khai[0].decode(), "refs/remotes/origin/master"
+    chuoi, a55, pr = _git_do(root, "rev-list", "--first-parent", m), _git_do(root, "show", f"{m}:{ADR0055_TEP}"), _git_do(root, "show", f"{m}:docs/PROTOCOL_DA_PHIEN.md")
