{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python -B - <<'PY'\nimport json,pathlib,collections\nfor f in ['remaining-prior-results.json','frontier/results.json','frontier2/results.json']:\n p=pathlib.Path('.review')/f;r=json.loads(p.read_text()); print(f,len(r),r[-1].get('label',r[-1].get('name')))\nfor f in ['prior1/registry-details.json','prior2/registry-details.json']:\n d=json.loads((pathlib.Path('.review')/f).read_text());print(f,{k:v for k,v in d.items() if k\"'!='\"'a9_inner_error'})\nPY\nnl -ba ops/ci_provenance.py | sed -n '150,220p' && nl -ba ops/ci_provenance_test.py | sed -n '535,555p'\"","aggregated_output":"remaining-prior-results.json 9 extra-adapted\nfrontier/results.json 50 log_close_ignore_prefix\nfrontier2/results.json 11 name_only_last_rest\nprior1/registry-details.json {'normal': [[], 25, 25], 'removed': [['test sống chưa đăng ký: ops/ci_provenance_test.py'], 25, 24], 'ruff_contract': [[], 3], 'same_regex_precedent': True, 'accepts_suite': True, 'rejects_bad': {'unequal': False, 'zero': False, 'red': True}}\nprior2/registry-details.json {'normal': [[], 25, 25], 'removed': [['test sống chưa đăng ký: ops/ci_provenance_test.py'], 25, 24], 'ruff_contract': [[], 3], 'same_regex_precedent': True, 'accepts_suite': True, 'rejects_bad': {'unequal': True, 'zero': True, 'red': True}}\n   150\t    except (OSError, subprocess.SubprocessError, UnicodeDecodeError):\n   151\t        return None\n   152\t\n   153\tdef _env_chan(v):   # `env:` không phải dict (biểu thức) hoặc có khoá `CI_DANG_KY_*` ⇒ không biết chế độ\n   154\t    return v is not None and (type(v) is not dict or any(str(k).startswith(\"CI_DANG_KY_\") for k in v))\n   155\t\n   156\tdef doc_wf(van):\n   157\t    \"\"\"Workflow tại SHA (`yaml.safe_load`); hỏng, không phải dict hay `jobs` không phải dict ⇒ None.\"\"\"\n   158\t    try:\n   159\t        wf = yaml.safe_load(van)\n   160\t    except (yaml.YAMLError, RecursionError):\n   161\t        return None\n   162\t    return wf if type(wf) is dict and type(wf.get(\"jobs\")) is dict else None\n   163\t\n   164\tdef ghep_job(ten, wf):\n   165\t    \"\"\"r4 (d): khoá DUY NHẤT `k` mà tên job REST bằng `k`, bằng `name:` nguyên văn (không `${{`), hoặc là `<k|name> (<…>)`.\"\"\"\n   166\t    khop = [k for k, j in wf[\"jobs\"].items() if type(ten) is str and type(j) is dict and any(\n   167\t        type(x) is str and x and \"${{\" not in x and re.fullmatch(re.escape(x) + r\"(?: \\(.*\\))?\", ten) for x in (k, j.get(\"name\")))]\n   168\t    return khop[0] if len(khop) == 1 else None\n   169\t\n   170\tdef ten_du_kien(s):   # tên REST mà bước YAML phải mang: `name:` nguyên văn, không thì `Run <dòng đầu run:>` / `Run <uses>`\n   171\t    if \"name\" in s:\n   172\t        return s[\"name\"] if _chuoi(s[\"name\"]) and \"${{\" not in s[\"name\"] else None\n   173\t    v = s.get(\"run\", s.get(\"uses\"))\n   174\t    return \"Run \" + v.split(\"\\n\")[0] if _chuoi(v) else None\n   175\t\n   176\tdef _gio(v):   # `YYYY-MM-DDTHH:MM:SSZ` → datetime; sai dạng HAY sai lịch ⇒ None. Header log cắt về giây TRƯỚC khi gọi\n   177\t    try:\n   178\t        return datetime.datetime.strptime(v[:19], \"%Y-%m-%dT%H:%M:%S\") if type(v) is str and RE_GIO.fullmatch(v) else None\n   179\t    except ValueError:\n   180\t        return None\n   181\t\n   182\tdef ghep_buoc(job, buoc, wf, ly_do_wf):\n   183\t    \"\"\"r4 F02: ĐỊNH DANH bước của nhóm log — job REST → MỘT job YAML (d); nhóm i → bước REST đã chạy thứ i → bước YAML cùng vị trí,\n   184\t    kèm (a) số đếm ba mức · (b) tên · (c) giờ cắt về giây ∈ [started_at, completed_at]. Vế hỏng ⇒ CẢ job không marker (`None`).\"\"\"\n   185\t    def hong(ly_do):\n   186\t        return {\"trang_thai\": \"not_measured\", \"ly_do\": ly_do, \"so_buoc\": len(buoc)}, None\n   187\t    if wf is None:\n   188\t        return hong(ly_do_wf)\n   189\t    k, st = ghep_job(job.get(\"name\"), wf), job.get(\"steps\")\n   190\t    sy = wf[\"jobs\"][k].get(\"steps\") if k else None\n   191\t    if k is None or \"uses\" in wf[\"jobs\"][k] or type(sy) is not list or not all(type(s) is dict for s in sy):   # Q8: job gọi lại\n   192\t        return hong(\"d_job_yaml_khong_duy_nhat\")\n   193\t    if not (type(st) is list and all(type(s) is dict and _so(s.get(\"number\"), 1) for s in st)\n   194\t            and len({s[\"number\"] for s in st}) == len(st)):\n   195\t        return hong(\"steps_rest_sai_dang\")\n   196\t    ung = [s for s in sorted(st, key=lambda s: s[\"number\"]) if s.get(\"name\") not in (\"Set up job\", \"Complete job\")\n   197\t           and not str(s.get(\"name\")).startswith(\"Post \")]\n   198\t    chay = [i for i, s in enumerate(ung) if s.get(\"conclusion\") != \"skipped\"]\n   199\t    if len(buoc) != len(chay):\n   200\t        return hong(\"a_so_nhom_khac_so_buoc_rest_chay\")\n   201\t    if len(ung) != len(sy):\n   202\t        return hong(\"a_so_buoc_rest_khac_so_buoc_yaml\")\n   203\t    if any(not _chuoi(s.get(\"name\")) or s.get(\"name\") != ten_du_kien(y) for s, y in zip(ung, sy)):\n   204\t        return hong(\"b_ten_buoc_lech\")\n   205\t    if not all((a := _gio(ung[i].get(\"started_at\"))) and (z := _gio(ung[i].get(\"completed_at\")))\n   206\t               and (h := _gio(b[\"gio\"][:19] + \"Z\")) and a <= h <= z for b, i in zip(buoc, chay)):\n   207\t        return hong(\"c_gio_header_ngoai_cua_so\")\n   208\t    return {\"trang_thai\": \"passed\", \"so_buoc\": len(buoc)}, [(k, i) for i in chay]\n   209\t\n   210\tdef chan_buoc(wf, k, i):\n   211\t    \"\"\"r4 Q7: chặn chế độ của CHÍNH bước `i` job `k`: khoá ngoài `KHOA_BUOC`, `shell:` lạ, `defaults:`/`env:` lạ mức job/workflow, `run:`\n   212\t    ĐỨNG TRƯỚC trong CÙNG job nhắc `GITHUB_ENV`/`GITHUB_PATH`. Bước `uses:` đứng trước là giới hạn khai, không chặn.\"\"\"\n   213\t    j, s = wf[\"jobs\"][k], wf[\"jobs\"][k][\"steps\"][i]\n   214\t    return bool(\"defaults\" in wf or _env_chan(wf.get(\"env\")) or \"defaults\" in j or _env_chan(j.get(\"env\")) or set(s) - KHOA_BUOC\n   215\t                or s.get(\"shell\", \"bash\") not in (\"bash\", \"pwsh\", \"sh\")\n   216\t                or any(re.search(\"GITHUB_(ENV|PATH)\", str(t.get(\"run\", \"\"))) for t in j[\"steps\"][:i]))\n   217\t\n   218\tdef than(dong):\n   219\t    m = RE_DONG.match(dong)\n   220\t    return RE_ANSI.sub(\"\", m.group(2) if m else dong)\n   535\t    for w, sua, mong, *wr in ((wf_tu(X), list.reverse, \"passed\"), (wf_tu(X), lambda st: st[2].update(number=2), \"steps_rest_sai_dang\"),\n   536\t                              (wf_tu(\"\\n\" + X), None, \"passed\"), (wf_tu(X, buoc_them={\"name\": \"${{ x }}\"}), None, \"b_ten_buoc_lech\"),\n   537\t                              (wf_tu(X + \"  \"), None, \"passed\"), (wf_tu(X, buoc_them={\"name\": \"\"}), None, \"b_ten_buoc_lech\"),\n   538\t                              (wf_tu(X, buoc_them={\"name\": \"Postgres\"}), None, \"passed\"),\n   539\t                              (wf_tu(X), lambda st: st[2].update(conclusion=\"failure\"), \"passed\"),\n   540\t                              (wf_tu(X, buoc_them={\"run\": 5}), ten(\"Run 5\"), \"b_ten_buoc_lech\", wf_tu(X)),\n   541\t                              (wf_tu(X, buoc_them={\"run\": 5}), ten(None), \"b_ten_buoc_lech\", wf_tu(X))):\n   542\t        bang(ghep(g1(w, buoc(X, \"THU: 4/4 dat\"), sua=sua, w_rest=(wr or [None])[0])) == mong, f\"F10 chốt tên/thứ tự: {w!r} mong {mong}\")\n   543\t\n   544\t@ca\n   545\tdef c38_ghep_lech_gio():   # A22 (c): giờ header ngoài cửa sổ, hoặc started_at/completed_at thiếu/sai dạng ⇒ not_measured, không ném\n   546\t    for sua in ({\"started_at\": \"2026-10-19T23:45:05Z\", \"completed_at\": \"2026-10-19T23:45:06Z\"}, {\"started_at\": None},\n   547\t                {\"completed_at\": \"2026-10-19T23:45:04.9Z\"}, {\"started_at\": 5}, {\"completed_at\": \"2026-10-19T23:45:03Z\"},\n   548\t                {\"started_at\": \"2026-02-30T00:00:00Z\"}, {\"completed_at\": \"2026-13-01T00:00:00Z\"}, {\"completed_at\": \"2026-10-19T24:00:00Z\"},\n   549\t                {\"completed_at\": \"2026-10-19T23:99:00Z\"}, {\"completed_at\": \"2026-10-19T23:45:99Z\"}, {\"completed_at\": \"2026-10-19T23:45:04+00:00\"},\n   550\t                {\"completed_at\": \"2026-10-19T23:45:04Zx\"}):\n   551\t        try:\n   552\t            p = g1(wf_tu(X), buoc(X, \"THU: 4/4 dat\"), sua=lambda st, d=sua: st[2].update(d))\n   553\t        except Exception as e:   # ném ra ngoài CHÍNH LÀ điều ca này đo (vế c phải hỏng êm)\n   554\t            bang(False, f\"giờ {sua}: công cụ ném {type(e).__name__}\")\n   555\t        khong_marker(p, f\"giờ {sua}\", ghep=\"not_measured\")\n","exit_code":0,"status":"completed"}}
