{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"sed -n '340,450p' ops/ci_provenance.py && cat .review/proof5.json && cat .review-input/r4-luot4/prove_frontier.py .review-input/r4-luot4/prove_last.py\"","aggregated_output":"               r.get(\"head_sha\"), \"loi_khai_rest_path\": r.get(\"path\"), \"check_suite_id\": r.get(\"check_suite_id\"), \"nguon\": f\"{goc}/runs/{run}\"}\n    thieu = [k for k, hop_le in RUN_BAT_BUOC.items() if not hop_le(r.get(k))]\n    lech = [k for k, v in ((\"id\", run), (\"run_attempt\", attempt)) if k not in thieu and r.get(k) != v]\n    moc_run |= {\"thieu\": thieu, \"lech\": lech, \"trang_thai\": \"failed\" if lech else \"not_measured\" if thieu else \"passed\"}\n    tep = {\"run.json\": byte_run, \"jobs.json\": json.dumps(jobs, ensure_ascii=False, indent=1).encode()}\n    co, gate, log = [], [], {}\n    for j in jobs[\"jobs\"]:\n        if j.get(\"conclusion\") == \"skipped\" or j.get(\"runner_id\") == 0:\n            co.append({\"job_id\": j[\"id\"], \"name\": j.get(\"name\"), \"trang_thai\": \"skipped\" if j.get(\"conclusion\") == \"skipped\" else \"not_run\"})\n            gate.append(moc_gate(j, [], moi, xanh))\n            continue\n        byte = lay(goi, f\"{goc}/jobs/{j['id']}/logs\")\n        dong = byte.decode(\"utf-8\", \"replace\").splitlines()\n        co.append({\"job_id\": j[\"id\"], \"name\": j.get(\"name\")} | moc_checkout(doc_sha_checkout(dong), r.get(\"event\"), r.get(\"head_sha\"), git))\n        sha = co[-1].get(\"sha\") if co[-1][\"trang_thai\"] == \"passed\" else None   # CHỈ SHA checkout đã đo, không `head_sha`\n        van = wf(sha, r[\"path\"]) if sha and RUN_BAT_BUOC[\"path\"](r.get(\"path\")) else None\n        g = moc_gate(j, dong, moi, xanh, doc_wf(van) if van is not None else None,\n                     \"sha_checkout_chua_do\" if not sha else \"workflow_tai_sha_khong_doc_duoc\")\n        gate.append(g)\n        khop = {k for x in g.get(\"dau_duong\", []) for k in x.get(\"dong_khop\", [])}\n        trich = [d for i, d in enumerate(dong) if than(d).startswith((\"##[group]Run \", \"Image: \")) or than(d) in khop\n                 or RE_SHA.match(d) or (i + 1 < len(dong) and RE_SHA.match(dong[i + 1]))]\n        tep[f\"jobs/{j['id']}.trich.txt\"] = (\"\\n\".join(trich) + \"\\n\").encode()\n        log[j[\"id\"]] = {\"sha256\": hashlib.sha256(byte).hexdigest(), \"bytes\": len(byte), \"trich\": f\"jobs/{j['id']}.trich.txt\"}\n    prov = {\"schema\": \"ci_provenance/1\", \"cong_cu\": \"ops/ci_provenance.py\", \"nguon\": \"REST\", \"attempt_yeu_cau\": attempt,\n            \"moc\": {\"run\": moc_run, \"checkout\": co,\n                    \"gate_output\": {\"jobs\": gate, \"tap_jobs\": tap(jobs, \"jobs\"), \"tap_artifacts\": tap(arts, \"artifacts\", ART_BAT_BUOC), \"artifacts\": [\n                        {k: a.get(k) for k in (\"id\", \"name\", \"digest\", \"size_in_bytes\", \"expired\")} for a in arts[\"artifacts\"]]},\n                    \"workflow_definition\": {\"trang_thai\": \"not_measured\", \"ly_do\": LY_DO_WD, \"loi_khai_rest_path\": r.get(\"path\")}},\n            \"log_day_du\": log}\n    tep[\"provenance.yaml\"] = yaml.safe_dump(prov, sort_keys=False, allow_unicode=True).encode()\n    return prov, tep\n\ndef ghi_tep(p, byte):\n    p.parent.mkdir(parents=True, exist_ok=True)\n    p.write_bytes(byte)\n\ndef ghi_nguyen_tu(out, tep):\n    \"\"\"Ghi vào thư mục tạm CÙNG CẤP rồi `os.replace`: lỗi giữa chừng ⇒ `out` vắng hoặc giữ nguyên bản trước.\"\"\"\n    out = Path(out).resolve()\n    out.parent.mkdir(parents=True, exist_ok=True)\n    tam = Path(tempfile.mkdtemp(prefix=f\".{out.name}.tam-\", dir=out.parent))\n    cu = out.parent / f\"{tam.name}.cu\"\n    try:\n        for ten, byte in tep.items():\n            ghi_tep(tam / ten, byte)\n        if out.exists():\n            os.replace(out, cu)\n        os.replace(tam, out)\n    except BaseException:\n        if cu.exists() and not out.exists():\n            os.replace(cu, out)\n        shutil.rmtree(tam, ignore_errors=True)\n        raise\n    shutil.rmtree(cu, ignore_errors=True)\n\ndef cac_trang_thai(prov):\n    m = prov[\"moc\"]\n    g = m[\"gate_output\"]\n    return ([m[\"run\"][\"trang_thai\"], m[\"workflow_definition\"][\"trang_thai\"], g[\"tap_jobs\"][\"trang_thai\"],\n             g[\"tap_artifacts\"][\"trang_thai\"]] + [x[\"trang_thai\"] for x in m[\"checkout\"]] + [x[\"trang_thai\"] for x in g[\"jobs\"]])\n\ndef main(argv=None, goi=goi_that, git=git_cuc_bo, moi_tu=CI_DANG_KY, wf=git_blob):\n    p = argparse.ArgumentParser(prog=\"ci_provenance.py\", description=__doc__.split(\"\\n\")[0])\n    sub = p.add_subparsers(dest=\"lenh\", required=True)\n    t = sub.add_parser(\"thu\", help=\"thu provenance của MỘT run/attempt bằng REST\")\n    t.add_argument(\"--repo\", required=True, help=\"owner/repo\")\n    t.add_argument(\"--run\", required=True, type=int, help=\"id workflow run\")\n    t.add_argument(\"--attempt\", required=True, type=int, help=\"run_attempt phải đo\")\n    t.add_argument(\"--out\", required=True, help=\"thư mục đầu ra (ghi nguyên tử)\")\n    try:\n        a = p.parse_args(argv)\n    except SystemExit as e:\n        if e.code == 0:\n            return 0\n        print(KHONG_SINH)\n        return 2\n    if not RE_REPO.fullmatch(a.repo) or a.run <= 0 or a.attempt <= 0:\n        print(f\"SAI_DOI_SO: --repo owner/repo, --run/--attempt nguyên dương (được {a.repo!r} {a.run} {a.attempt})\\n{KHONG_SINH}\")\n        return 2\n    try:\n        prov, tep = thu(a.repo, a.run, a.attempt, goi, git, moi_tu, wf)\n    except LoiRest as e:\n        print(f\"REST_LOI: HTTP {e.ma} {e.url}\\n{KHONG_SINH}\")\n        return 3\n    except Exception:   # lưới cuối M7: lỗi thu ngoài hợp đồng vẫn in dòng đếm, rồi NỔI LÊN (không nuốt, không bịa rc)\n        print(KHONG_SINH)\n        raise\n    try:\n        ghi_nguyen_tu(a.out, tep)\n    except OSError as e:   # không có provenance ⇒ vẫn in dòng đếm, rồi để lỗi I/O nổi lên (rc 1, không bịa mã mới)\n        print(f\"LOI_GHI: {e}\\n{KHONG_SINH}\")\n        raise\n    m = prov[\"moc\"]\n    print(f\"RUN: {m['run']['trang_thai']} (run_attempt {m['run']['run_attempt']}, yeu cau {a.attempt})\")\n    for c, g in zip(m[\"checkout\"], m[\"gate_output\"][\"jobs\"]):\n        print(f\"JOB {c['job_id']} {c['name']}: checkout={c['trang_thai']} {c.get('sha', '-')} gate={g['trang_thai']}\")\n    print(f\"WORKFLOW_DEFINITION: {m['workflow_definition']['trang_thai']} ({LY_DO_WD})\")\n    tt = cac_trang_thai(prov)\n    print(f\"provenance.yaml sha256 {hashlib.sha256(tep['provenance.yaml']).hexdigest()}\")\n    print(f\"NOT_MEASURED: {tt.count('not_measured')}\")\n    return 12 if \"failed\" in tt else 0\n\nif __name__ == \"__main__\":\n    raise SystemExit(main(sys.argv[1:]))\n{\n  \"command\": [\n    \"python\",\n    \"-B\",\n    \".review/prove5.py\"\n  ],\n  \"returncode\": 0,\n  \"seconds\": 3.407660722732544,\n  \"stdout\": {\n    \"path\": \"/tmp/claude-0/-home-user-tra-luat/eaf2a577-1c02-5642-8186-a4b48145f1ca/scratchpad/r4review5/ws/.review/proof5.stdout.txt\",\n    \"bytes\": 255,\n    \"sha256\": \"b3b25b63a9de85cce8010026a4e15dc026466b539e08edc81ee68123e41c9308\"\n  },\n  \"stderr\": {\n    \"path\": \"/tmp/claude-0/-home-user-tra-luat/eaf2a577-1c02-5642-8186-a4b48145f1ca/scratchpad/r4review5/ws/.review/proof5.stderr.txt\",\n    \"bytes\": 0,\n    \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n  }\n}from pathlib import Path\nimport os,sys,json,subprocess\nR=Path(__file__).resolve().parent\npairs=[('run_rstrip_all','run_trailing_space'),('metadata_post_anywhere','metadata_post_infix'),('log_shell_suffix','shell_prefix_space_missing'),('mode_defaults_job_truthy','defaults_job_empty'),('mode_defaults_wf_truthy','defaults_wf_empty'),('mode_env_truthy','env_job_false'),('mode_env_string_only','env_wf_list'),('rest_number_bool','number_bool_metadata'),('rest_number_float','number_float'),('job_alias_exact_drop'