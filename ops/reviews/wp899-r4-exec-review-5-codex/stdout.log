on.')\n text+=f\\\"|{z['name']}|{grade}|{note}|\\\\n\\\"\ntext+='\\\\nCác P3 trên: owner đề xuất \"'`ducthangho`; giữ nợ/quyết định trước khi có revision chốt miền, không tự sửa tiêu chuẩn nghiệm thu. Không coi chúng là ca phải giết để làm đẹp tổng. F10 P1 vẫn chặn approval riêng.'\"\\\\n\\\\n**Toàn bộ inventory, gồm mutant bị giết và TÍN DỤNG GIẢ.** [MUTANTS.md](MUTANTS.md) là danh sách từng ID với phân hạng/ca đích/scope và nguồn JSON, thuộc gói verdict này. Các lần đo trùng neo/thay được giữ provenance, không cộng thành số mutant độc lập. Phân bố từng producer:\\\\n\\\\n| producer | phân hạng thật |\\\\n|---|---|\\\\n'\nfor n,c in summary.items():text+=f\\\"|{n}|{c}|\\\\n\\\"\ntext+='\\\\n**Read-only và bàn giao.** \"'`snapshot-start.json`/`snapshot-end.json` và `snapshot-comparison5.json` so hash/bytes toàn bộ tracked/untracked/ignored ngoài `.review/`, HEAD/tree/diff/index; không có delta quan sát được, `git status --short` sạch. Chỉ chứng minh hai mốc, không chứng minh lịch sử chưa từng ghi rồi hoàn nguyên. Repo nguồn ngoài checkout không nằm trong phạm vi quan sát. `evidence-manifest5.json` băm các hiện vật sau khi mọi writer test kết thúc, không tự chứng nhận runtime/transport sau phiên. Không có quyền approve/merge/land/LIVE từ verdict này.'\"\\\\n'\n(R/'VERDICT.md').write_text(text)\n# Full list is directly reviewable; failed mutations never get a severity on the product.\nmd='# Inventory đột biến — wp899 r4 lượt 5\\\\n\\\\nReviewed SHA: \"'`22da28c738e651361274c1264e681a52461dad1e`. GIET chỉ từ rc3/DO đúng ca; không cộng setup/import/permission.'\"\\\\n'\nfor n,rows in sets.items():\n md+=f'\\\\n## {n}\\\\n\\\\nNguồn chi tiết: [{n}/results.json]({n}/results.json).\\\\n\\\\n| mutant | phân hạng | hạng finding | ca đích / giới hạn |\\\\n|---|---|---|---|\\\\n'\n for z in rows:\n  name=z['name'];rank=z['rank'];grade='—'\n  if rank in ('SONG_SOT','SONG'):grade=('P3' if name in p3 or name=='log_nested_after_only' else 'P1/F10')\n  if rank=='HONG_NEO':grade='— không tạo mutant, không tính sống'\n  if n=='mutants' and z.get('expected')\"'!='\"'GIET':grade='— tự kiểm có chủ ý'\n  cases=z.get('killed') or [z.get('case','')];md+=f\\\"|{name.replace('|','&#124;')}|{rank}|{grade}|{', '.join(cases[:3])}; lỗi vô can: {len(z.get('other_errors',[]))}|\\\\n\\\"\nmd+='\\\\n## n_goi_strip_run\\\\n\\\\nP1/F10; SONG_SOT48/48, baseline0 → mutant3 đúng ca. Xem norm-full5.json và norm-head/norm-mutant stdout.\\\\n'\n(R/'MUTANTS.md').write_text(md)\nprint('VERDICT changes_requested',len(p1)+1,'P1 mutant survivors;',len(surv)-len(p1),'P3 survivors; rows',sum(map(len,sets.values())))\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
