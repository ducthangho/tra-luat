.append({'position':position,'same_output':pair[0]==pair[1],'gate':pair[0]})\nassert all(x['same_output'] for x in equal)\n(R/'remaining-survivor-details.json').write_text(json.dumps({'rows':rows,'nested_equivalence':equal},ensure_ascii=False,indent=2))\nfor r in rows:print(r['mutant'],[(x['gate']['ghep_buoc'],x['gate']['kich_ban']['buoc_xac_thuc'],x['gate']['dau_duong']) for x in r['observed']])\nprint('nested equivalence',len(equal),'/',len(equal))\n.review/frontier5:\n\n.review/prior-results:\nprior1-calendar_cases.py.stderr\nprior1-calendar_cases.py.stdout\nprior1-classifier_negative.py.stderr\nprior1-classifier_negative.py.stdout\nprior1-new_probes_r4.py.stderr\nprior1-new_probes_r4.py.stdout\nprior1-old1-probes.py.stderr\nprior1-old1-probes.py.stdout\nprior1-old1-r4_compare.py.stderr\nprior1-old1-r4_compare.py.stdout\nprior1-old1-r4_compare_current.py.stderr\nprior1-old1-r4_compare_current.py.stdout\nprior1-old2-boundary_case.py.stderr\nprior1-old2-boundary_case.py.stdout\nprior1-old2-composite_case.py.stderr\nprior1-old2-composite_case.py.stdout\nprior1-old2-new_probes.py.stderr\nprior1-old2-new_probes.py.stdout\nprior1-old2-probes.py.stderr\nprior1-old2-probes.py.stdout\nprior1-old2-r4_compare.py.stderr\nprior1-old2-r4_compare.py.stdout\nprior1-preflight.py.stderr\nprior1-preflight.py.stdout\nprior1-q1_time_detail.py.stderr\nprior1-q1_time_detail.py.stdout\nprior1-run_old.py.stderr\nprior1-run_old.py.stdout\nprior2-calendar_cases.py.stderr\nprior2-calendar_cases.py.stdout\nprior2-new_probes_r4.py.stderr\nprior2-new_probes_r4.py.stdout\nprior2-old1-probes.py.stderr\nprior2-old1-probes.py.stdout\nprior2-old1-r4_compare.py.stderr\nprior2-old1-r4_compare.py.stdout\nprior2-old1-r4_compare_current.py.stderr\nprior2-old1-r4_compare_current.py.stdout\nprior2-preflight.py.stderr\nprior2-preflight.py.stdout\nprior2-q1_time_detail.py.stderr\nprior2-q1_time_detail.py.stdout\nprior2-run_old.py.stderr\nprior2-run_old.py.stdout\n","exit_code":0,"status":"completed"}}
