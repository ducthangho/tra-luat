{"type":"item.started","item":{"id":"item_141","type":"command_execution","command":"/bin/bash -lc \"python -B - <<'PY'\nfrom pathlib import Path\nimport subprocess,json,hashlib,datetime\nR=Path('.review').resolve();root=R.parent\ncmds=[['git','rev-parse','HEAD','HEAD\"'^{tree}'\"'],['git','status','--short'],['git','diff','--check','ba222ffd1615f0d74b59985b9612f725211b62f5','HEAD']]\nchecks=[]\nfor c in cmds:\n p=subprocess.run(c,capture_output=True);checks.append({'command':c,'rc':p.returncode,'stdout':p.stdout.decode(),'stderr':p.stderr.decode()});assert p.returncode==0\nassert checks[0]['stdout'].splitlines()==['22da28c738e651361274c1264e681a52461dad1e','22da0a84e0a0f908664ceec22fe917f3166c29be'] and not checks[1]['stdout']\n(R/'final-check5.json').write_text(json.dumps({'checks':checks,'verdict_sha256':hashlib.sha256((R/'VERDICT.md').read_bytes()).hexdigest(),'observed_readonly':'snapshot-comparison5.json; no file byte delta outside .review'},ensure_ascii=False,indent=2))\nrows=[]\nfor p in sorted(R.rglob('*')):\n if not p.is_file() or p.name=='evidence-manifest5.json':continue\n rel=p.relative_to(R);b=p.read_bytes();h=hashlib.sha256(b).hexdigest();z={'path':str(rel),'bytes':len(b),'sha256':h}\n if rel.parts and rel.parts[0] in ('prior1','prior2'):\n  old=root/'.review-input/r4-luot4'/rel\n  z['matches_seeded_input_bytes']=old.is_file() and hashlib.sha256(old.read_bytes()).hexdigest()==h\n rows.append(z)\nmanifest={'reviewed_sha':'22da28c738e651361274c1264e681a52461dad1e','reviewed_tree':'22da0a84e0a0f908664ceec22fe917f3166c29be','files':rows,'scope':'Review scratch, including frozen historical scaffold; primary current receipts indexed in README.md. Manifest is not a runtime or delivery attestation.'}\np=R/'evidence-manifest5.json';p.write_text(json.dumps(manifest,ensure_ascii=False,indent=2))\nassert all(hashlib.sha256((R/z['path']).read_bytes()).hexdigest()==z['sha256'] for z in rows)\nprint('MANIFEST',len(rows),'files verified; VERDICT',hashlib.sha256((R/'VERDICT.md').read_bytes()).hexdigest());print('HEAD/tree exact; git status clean; diff-check rc0')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
