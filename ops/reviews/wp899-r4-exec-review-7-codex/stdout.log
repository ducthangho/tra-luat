")\n\n@ca\ndef c17_ghi_nguyen_tu():\n    m, dem = nap(), []\n    goc_ghi = m.ghi_tep\n\n    def ghi_hong(p, b):\n        dem.append(p)\n        if len(dem) == 2:\n            raise OSError(\"giữa chừng\")\n        goc_ghi(p, b)\n    for co_cu in (False, True):\n        dem.clear()\n        with tempfile.TemporaryDirectory() as thu, mock.patch.object(m, \"ghi_tep\", ghi_hong):\n            o = Path(thu) / \"out\"\n            if co_cu:\n                o.mkdir()\n                (o / \"cu.txt\").write_text(\"ban truoc\", encoding=\"utf-8\")\n            with contextlib.suppress(OSError):\n                m.ghi_nguyen_tu(o, {\"provenance.yaml\": b\"a\", \"jobs/1.trich.txt\": b\"b\", \"run.json\": b\"c\"})\n            sau = sorted(x.name for x in o.iterdir()) if o.exists() else None\ndef c47_bien_ghep():   # biên của ghép + xác thực khối: mỗi biến thể một chốt; ca cần marker thì đòi MARKER, không chỉ đòi ghép\n    dd = lambda p: [(x[\"trang_thai\"], x.get(\"ly_do\")) for x in gate(p)[\"dau_duong\"]]  # noqa: E731\n    ok, e, b = [(\"passed\", None)], \"echo A=1 >> $GITHUB_ENV\", buoc(X, \"THU: 4/4 dat\")\n    for ten, p, mong in ((\"number bool\", g1(wf_tu(X), b, sua=lambda st: st[0].update(number=True)), \"steps_rest_sai_dang\"),\n                         (\"number float\", g1(wf_tu(X), b, sua=lambda st: st[2].update(number=2.5)), \"steps_rest_sai_dang\"),\n                         (\"alias name:\", g1(wf_job(j=({\"name\": \"Build\"}, None)), b, ten=\"Build\"), \"passed\"),\n                         (\"ma trận rỗng\", g1(wf_tu(X), b, ten=\"j ()\"), \"passed\"),\n                         (\"ma trận xuống dòng\", g1(wf_tu(X), b, ten=\"j (a\\nb)\"), \"d_job_yaml_khong_duy_nhat\"),\n                         (\"Post ở giữa tên\", g1(wf_tu(X, buoc_them={\"name\": \"Chay Post x\"}), b), \"passed\")):\n        bang(ghep(p) == mong, f\"{ten}: {ghep(p)} ≠ {mong}\")\n    w0 = yaml.safe_dump({\"jobs\": {\"j\": {\"runs-on\": \"x\", \"steps\": [{\"run\": e + \"\\n\"}, {\"run\": X + \"\\n\"}]}}})\n    for ten, p, mong in ((\"khoảng trắng cuối run:\", g1(wf_tu(X + \"  \"), buoc(X + \"  \", \"THU: 4/4 dat\")), ok),\n                         (\"hai dòng trùng\", g1(wf_tu(X + \"\\n\" + X), khoi([X, X], \"THU: 4/4 dat\")), ok),\n                         (\"GITHUB_ENV ở bước ĐẦU\", g1(w0, buoc(e), b, nen=LINUX_KHONG_SETUP), CHAN),\n                         (\"GITHUB_ENV cách một bước\", g1(wf_tu(e, \"echo b\", X), buoc(e), buoc(\"echo b\"), b), CHAN),\n                         (\"##[endgroup] có đuôi\", g1(wf_tu(X), b[:3] + [f\"{T} ##[endgroup]x\"] + b[4:]), []),\n                         (\"shell: thiếu dấu cách\", g1(wf_tu(X), b[:2] + [f\"{T} shell:/usr/bin/bash\"] + b[3:]), [])):\n        bang(dd(p) == mong and ghep(p) == \"passed\", f\"{ten}: {dd(p)} ≠ {mong} (ghép {ghep(p)})\")\n    w = yaml.safe_load(wf_tu(X))\n    w[\"jobs\"][\"j\"][\"steps\"][1] = {\"name\": \"K\", \"run\": 5}\n    try:   # `run:` không phải chuỗi mà khối in lại trùng str(run) ⇒ không marker, KHÔNG ném\n        p = g1(yaml.safe_dump(w), buoc(\"5\", \"THU: 4/4 dat\"), sua=lambda st: st[2].update(name=\"K\"), w_rest=wf_tu(X))\n    except Exception as ex:   # ném ra ngoài CHÍNH LÀ điều vế này đo\n        bang(False, f\"run: 5 ⇒ công cụ ném {type(ex).__name__}\")\n    bang(dd(p) == [] and ghep(p) == \"passed\", f\"run: 5: {dd(p)}\")\n\ndef bien_dang(x):   # mọi biến dạng \"gần\" của một hằng chuỗi: hậu tố, bớt ký tự cuối, hoa/thường, khoảng trắng hai đầu\n    return list(dict.fromkeys(v for v in (x + \"x\", x[:-1], x.upper(), x.lower(), x.swapcase(), \" \" + x, x + \" \") if v != x))\n    return loi, len(song), len(registry)\n\n\ndef bang_chung_xanh(text, mau):\n    m = re.search(mau, text, re.M)\n    if not m:\n        return False\n    return not m.groups() or len(m.groups()) != 2 or (int(m.group(1)) > 0 and m.group(1) == m.group(2))\n\n\ndef moi_truong_hien_tai(env=os.environ):\n    \"\"\"Chỉ nhận diện khi cả hai dấu hiệu runner chuẩn cùng khớp.\"\"\"\n    if env.get(\"GITHUB_ACTIONS\") == \"true\" and env.get(\"RUNNER_OS\") in (\"Linux\", \"Windows\"):\n        return f\"github-actions/{env['RUNNER_OS'].lower()}\"\n    return None\n\n\ndef nen_la_windows(ten_nen=None):\n    \"\"\"Nen CHAY THAT cua tien trinh nay — KHONG phai nen CI khai trong bien moi truong.\n\n    Phai hoi `os.name`, dung hoi `moi_truong_hien_tai()`: bo test con chay CUNG mot OS\n    voi so dang ky nay, va no quyet dinh in dong Windows theo `os.name`. Neu hoi bien CI\n    thi mot luot chay TAY tren may Windows (khong co GITHUB_ACTIONS) se bi coi la\n    khong-Windows, va dong hop le cua no bi cham DO — do la lam tron XUONG, cung ho voi\n    loi lam tron LEN ma `dem_la_do` sinh ra de chan.\n    \"\"\"\n    return (os.name if ten_nen is None else ten_nen) == \"nt\"\n\n\ndef mau_theo_nen(path, mau, la_windows):\n    \"\"\"Tap mau duoc chap nhan cho `path` tren nen dang chay.\n\n    Windows dung tap THAY THE trong `MOI_WINDOWS` — KHONG kem `mau` goc. Co chu dich:\n    tap ay da chua dang Linux (sieu chat hon), nen A3 \"dong Linux tren nen Windows van\nfrom pathlib import Path\nimport ast,re,json,sys,os,subprocess,concurrent.futures,collections\nR=Path(__file__).resolve().parent;root=R.parent\nops={x['name']:x for x in json.loads((R/'operators6/results.json').read_text())};base={c:(rc,o) for c,rc,o in json.loads((R/'frontier6/baseline.json').read_text())}\njobs=[]\nfor line in (root/'.review-input/tu-dot-bien/kq8.txt').read_text().splitlines():\n m=re.fullmatch(r'(.*?) GIET\\+NEM (.*)',line)\n if not m:continue\n killed,errors=ast.literal_eval(m[2]);assert m[1] in ops\n for c in errors:jobs.append((m[1],c,ops[m[1]]['source']))\ndef one(v):\n name,c,src=v;assert base[c][0]==0\n cmd=[sys.executable,'-B',str(root/'ops/ci_provenance_test.py'),'--mot-ca',c];q=subprocess.run(cmd,capture_output=True,env=dict(os.environ,CI_PROVENANCE_MA=src,PYTHONDONTWRITEBYTECODE='1'),timeout=300);o=(q.stdout+q.stderr).decode()\n return {'name':name,'case':c,'source':src,'command':cmd,'baseline':{'source':'frontier6/baseline.json','rc':base[c][0]},'rc':q.returncode,'output':o,'rank':'TIN_DUNG_GIA' if q.returncode==4 else 'GIET_DUNG_CA' if q.returncode==3 and o.startswith('DO:'+c+':') else 'KHAC','scope':'only error cases listed in supplied kq8.txt, max3 per operator'}\nrows=[]\nwith concurrent.futures.ThreadPoolExecutor(3) as ex:\n for r in ex.map(one,jobs):\n  rows.append(r);(R/'operator-errors6-results.json').write_text(json.dumps(rows,ensure_ascii=False,indent=2));print(r['name'],r['case'],r['rank'],flush=True)\nprint('OPERATORS',len(set(z['name'] for z in rows)),'CASES',len(rows),collections.Counter(z['rank'] for z in rows))\n","exit_code":0,"status":"completed"}}
