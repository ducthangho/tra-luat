{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'nl -ba ops/ci_provenance.py'","aggregated_output":"     1\t#!/usr/bin/env python3\n     2\t\"\"\"Thu provenance CI §10.2.2 từ REST và log job — packet #899 (wp899 P-A), đặc tả `ops/specs/wp899-r4.md` (thay r3).\n     3\t\n     4\t`thu --repo o/r --run ID --attempt N --out DIR` ghi bốn mốc TÁCH BẠCH (Run · Checkout · Gate output · Workflow definition)\n     5\tvào `DIR/provenance.yaml`. Chỉ REST; mọi lời gọi mạng đi qua MỘT hàm tiêm vào `goi(url) -> (mã HTTP, byte)` để test chạy\n     6\toffline. Năm trạng thái §10.2.3: thiếu dữ liệu là `not_measured`, không bao giờ là `passed`. Mốc Workflow definition luôn\n     7\t`not_measured` (GraphQL bị chặn trong phiên Claude; việc của P-B). SHA checkout đọc từ LOG, không lấy `head_sha` của REST.\n     8\tr3 (F02): kịch bản của bước lấy từ `run:` của workflow tại SHA checkout ĐÃ ĐO (`git cat-file blob <sha>:<path REST>`). r4 (F02):\n     9\tbước của mỗi nhóm log được ĐỊNH DANH qua REST `steps[]` + vị trí (`ghep_buoc`), không tìm ứng viên trùng chữ trên toàn workflow. Gốc tin là nội dung tại SHA ấy — workflow tại SHA vốn quyết định được mọi output, công cụ không chống nó.\n    10\tThoát: 0 không mốc nào `failed` · 12 có `failed` · 2 sai đối số · 3 REST khác 2xx (in nguyên mã). LUÔN in `NOT_MEASURED: <n>`;\n    11\trc 2/3 không sinh provenance nên cả bốn mốc là chưa đo (`NOT_MEASURED: 4` kèm `PROVENANCE: khong_sinh`).\n    12\t\"\"\"\n    13\timport argparse, datetime, hashlib, importlib.util, json, os, re, shutil, subprocess, sys, tempfile, urllib.error, urllib.request\n    14\tfrom pathlib import Path\n    15\t\n    16\timport yaml\n    17\t\n    18\tfor _s in (sys.stdout, sys.stderr):\n    19\t    if hasattr(_s, \"reconfigure\"):\n    20\t        _s.reconfigure(encoding=\"utf-8\", errors=\"backslashreplace\")\n    21\t\n    22\tROOT = Path(__file__).resolve().parent.parent\n    23\tCI_DANG_KY = ROOT / \".claude/dev/ci_dang_ky_test.py\"\n    24\tAPI = \"https://api.github.com\"\n    25\tTRANG = 100\n    26\tTRANG_TOI_DA = 1000\n    27\tTS = r\"\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z\"\n    28\tRE_DONG = re.compile(rf\"^({TS}) ?(.*)$\")\n    29\tRE_SHA = re.compile(rf\"^{TS} ([0-9a-f]{{40}})$\")\n    30\tRE_GIO = re.compile(r\"\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ\")\n    31\tRE_ANSI = re.compile(r\"\\x1b\\[[0-9;]*m\")\n    32\tRE_HEX40 = re.compile(r\"^[0-9a-f]{40}$\")\n    33\tRE_REPO = re.compile(r\"^[\\w.-]+/[\\w.-]+$\")\n    34\tLY_DO_WD = \"graphql_bi_chan_trong_phien_claude; cho P-B\"\n    35\tKET_BUOC = (\"success\", \"failure\", \"cancelled\", \"skipped\", \"neutral\")\n    36\tLOI_JOB = (\"failure\", \"cancelled\", \"timed_out\", \"action_required\", \"startup_failure\", \"stale\")\n    37\tRE_CHECK_RUN = re.compile(r\"^https://api\\.github\\.com/repos/[\\w.-]+/[\\w.-]+/check-runs/[1-9]\\d*$\")\n    38\t# Lời gọi python DUY NHẤT tính là bằng chứng (danh sách CHO PHÉP): cả dòng logic là `[VAR=… ]python[ver] [cờ không đối số…]\n    39\t# [./]<script>.py` — KHÔNG đối số sau script (r3 Q4), không nháy/toán tử/chú thích. Nhóm 1 = tiền tố `VAR=` (⇒ chặn chế độ).\n    40\tRE_LOI_GOI = re.compile(r\"^((?:[A-Za-z_]\\w*=[\\w./:-]*\\s+)*)(?:[\\w./-]*/)?python(?:\\d+(?:\\.\\d+)*)?(?:\\s+-[BuIsSEOqb]+)*\"\n    41\t                        r\"\\s+(?:\\./)?([\\w.-]+(?:/[\\w.-]+)*\\.py)$\")\n    42\tKHOA_BUOC = {\"name\", \"id\", \"if\", \"run\", \"shell\", \"timeout-minutes\", \"continue-on-error\"}   # CHO PHÉP; env/working-directory… ⇒ chặn\n    43\t\n    44\tdef _so(v, nho=0):\n    45\t    return type(v) is int and v >= nho   # `bool` là con của `int`: `type(...) is int` loại True/False\n    46\t\n    47\tdef _chuoi(v):\n    48\t    return type(v) is str and v.strip() != \"\"\n    49\t\n    50\tRUN_BAT_BUOC = {\"id\": lambda v: _so(v, 1), \"run_attempt\": lambda v: _so(v, 1), \"event\": _chuoi, \"path\": _chuoi,\n    51\t                \"head_sha\": lambda v: _chuoi(v) and bool(RE_HEX40.fullmatch(v)), \"check_suite_id\": lambda v: _so(v, 1)}\n    52\tJOB_BAT_BUOC = {\"name\": _chuoi, \"runner_id\": lambda v: _so(v, 1), \"runner_name\": _chuoi, \"conclusion\": lambda v: v == \"success\",\n    53\t                \"labels\": lambda v: type(v) is list and bool(v) and all(_chuoi(x) for x in v),\n    54\t                \"check_run_url\": lambda v: _chuoi(v) and bool(RE_CHECK_RUN.fullmatch(v)), \"steps\": lambda v: type(v) is list and bool(v)\n    55\t                and all(type(b) is dict and _chuoi(b.get(\"name\")) and b.get(\"conclusion\") in KET_BUOC for b in v)}\n    56\tART_BAT_BUOC = {\"name\": _chuoi, \"size_in_bytes\": _so, \"expired\": lambda v: type(v) is bool,\n    57\t                \"digest\": lambda v: v is None or (_chuoi(v) and v.startswith(\"sha256:\"))}\n    58\tKHONG_SINH = \"NOT_MEASURED: 4\\nPROVENANCE: khong_sinh (ca bon moc chua do)\"\n    59\t\n    60\tclass LoiRest(Exception):\n    61\t    def __init__(self, ma, url):\n    62\t        super().__init__(f\"REST {ma} {url}\")\n    63\t        self.ma, self.url = ma, url\n    64\t\n    65\tclass _KhongChuyenHuong(urllib.request.HTTPRedirectHandler):\n    66\t    def redirect_request(self, *a, **k):\n    67\t        return None\n    68\t\n    69\tdef goi_that(url):\n    70\t    \"\"\"GET REST. Log job trả 302 sang kho blob: theo TAY và KHÔNG mang token sang host khác.\"\"\"\n    71\t    tk = next((os.environ[k] for k in (\"GITHUB_PAT\", \"GH_TOKEN\", \"GITHUB_TOKEN\") if os.environ.get(k)), None)\n    72\t    hd = {\"Accept\": \"application/vnd.github+json\", \"X-GitHub-Api-Version\": \"2022-11-28\"}\n    73\t    if tk:\n    74\t        hd[\"Authorization\"] = f\"Bearer {tk}\"\n    75\t    yeu_cau, mo = urllib.request.Request(url, headers=hd), urllib.request.build_opener(_KhongChuyenHuong).open\n    76\t    for _ in range(2):   # lượt 2 (nếu có) là URL chuyển hướng: cùng hợp đồng lỗi, chuỗi trần nên không có header token\n    77\t        try:\n    78\t            with mo(yeu_cau, timeout=120) as r:\n    79\t                return r.status, r.read()\n    80\t        except urllib.error.HTTPError as e:\n    81\t            loc = e.headers.get(\"Location\") if e.code in (301, 302, 303, 307, 308) else None\n    82\t            if not loc or mo is urllib.request.urlopen:\n    83\t                return e.code, b\"\"\n    84\t            yeu_cau, mo = loc, urllib.request.urlopen\n    85\t        except (urllib.error.URLError, OSError) as e:\n    86\t            raise LoiRest(f\"khong_ket_noi ({e})\", url)\n    87\t\n    88\tdef lay(goi, url):\n    89\t    ma, byte = goi(url)\n    90\t    if not (isinstance(ma, int) and 200 <= ma < 300):\n    91\t        raise LoiRest(ma, url)\n    92\t    return byte\n    93\t\n    94\tdef lay_json(goi, url):\n    95\t    \"\"\"(đối tượng, byte nguyên văn).\"\"\"\n    96\t    byte = lay(goi, url)\n    97\t    try:\n    98\t        return json.loads(byte), byte\n    99\t    except ValueError:\n   100\t        raise LoiRest(\"than_khong_phai_json\", url)\n   101\t\n   102\tdef lay_trang(goi, url, khoa):\n   103\t    \"\"\"Đọc tới trang NGẮN hơn `TRANG`. Đủ ⇔ số ID DUY NHẤT = `total_count` và total không đổi giữa trang; thiếu, trùng,\n   104\t    total đổi hay chạm `TRANG_TOI_DA` ⇒ `du: False` (không suy gì về phần thiếu; mốc tập hợp `not_measured`).\"\"\"\n   105\t    ds, ids, tong, trang, du = [], set(), None, 1, True\n   106\t    try:\n   107\t        while True:\n   108\t            d = lay_json(goi, f\"{url}?per_page={TRANG}&page={trang}\")[0]\n   109\t            if not (_so(d[\"total_count\"]) and type(d[khoa]) is list and all(type(x) is dict and _so(x[\"id\"], 1) for x in d[khoa])):\n   110\t                raise TypeError(f\"total_count/{khoa}/id sai kiểu\")\n   111\t            du, tong = du and tong in (None, d[\"total_count\"]), d[\"total_count\"]\n   112\t            for x in d[khoa]:\n   113\t                du = du and x[\"id\"] not in ids\n   114\t                if x[\"id\"] not in ids:\n   115\t                    ids.add(x[\"id\"])\n   116\t                    ds.append(x)\n   117\t            if len(d[khoa]) < TRANG or trang >= TRANG_TOI_DA:   # đọc tới trang NGẮN: total trang đầu có thể khai thấp\n   118\t                return {\"total_count\": tong, khoa: ds, \"du\": du and len(ids) == tong and len(d[khoa]) < TRANG}\n   119\t            trang += 1\n   120\t    except (KeyError, TypeError) as e:\n   121\t        raise LoiRest(f\"than_sai_dang ({e!r})\", url)\n   122\t\n   123\tdef tap(d, khoa, bat_buoc=None):\n   124\t    sai = sorted({k for x in d[khoa] for k, hop_le in (bat_buoc or {}).items() if not hop_le(x.get(k))})\n   125\t    return {\"trang_thai\": \"passed\" if d[\"du\"] and not sai else \"not_measured\", \"total_count\": d[\"total_count\"],\n   126\t            \"so_id\": len(d[khoa]), \"truong_sai\": sai}\n   127\t\n   128\tdef doc_moi(duong=CI_DANG_KY):\n   129\t    \"\"\"`MOI` và `bang_chung_xanh` đọc bằng IMPORT sổ đăng ký — một nguồn, không chép bảng.\"\"\"\n   130\t    spec = importlib.util.spec_from_file_location(\"ci_dang_ky_cho_provenance\", duong)\n   131\t    m = importlib.util.module_from_spec(spec)\n   132\t    spec.loader.exec_module(m)\n   133\t    return dict(m.MOI), m.bang_chung_xanh\n   134\t\n   135\tdef git_cuc_bo(sha, goc=ROOT):\n   136\t    \"\"\"parents/tree của commit trong kho cục bộ; không có object (hoặc không phải commit) ⇒ None.\"\"\"\n   137\t    try:\n   138\t        r = subprocess.run([\"git\", \"-C\", str(goc), \"cat-file\", \"-p\", sha], capture_output=True, text=True, timeout=60)\n   139\t    except (OSError, subprocess.SubprocessError):\n   140\t        return None\n   141\t    dau = r.stdout.split(\"\\n\\n\", 1)[0].splitlines() if r.returncode == 0 else []\n   142\t    tree = [x[5:] for x in dau if x.startswith(\"tree \")]\n   143\t    return {\"tree\": tree[0], \"parents\": [x[7:] for x in dau if x.startswith(\"parent \")]} if len(tree) == 1 else None\n   144\t\n   145\tdef git_blob(sha, path, goc=ROOT):\n   146\t    \"\"\"Văn bản blob `<sha>:<path>` trong kho cục bộ; thiếu object/tệp, không phải blob hay không UTF-8 ⇒ None.\"\"\"\n   147\t    try:\n   148\t        r = subprocess.run([\"git\", \"-C\", str(goc), \"cat-file\", \"blob\", f\"{sha}:{path}\"], capture_output=True, timeout=60)\n   149\t        return r.stdout.decode(\"utf-8\") if r.returncode == 0 else None\n   150\t    except (OSError, subprocess.SubprocessError, UnicodeDecodeError):\n   151\t        return None\n   152\t\n   153\tdef _env_chan(d):   # CÓ khoá `env:` mà giá trị không phải dict (biểu thức, null — D01) hoặc có khoá `CI_DANG_KY_*` ⇒ không biết chế độ\n   154\t    return \"env\" in d and (type(d[\"env\"]) is not dict or any(str(k).startswith(\"CI_DANG_KY_\") for k in d[\"env\"]))\n   155\t\n   156\tdef doc_wf(van):\n   157\t    \"\"\"Workflow tại SHA (`yaml.safe_load`); hỏng, không phải dict hay `jobs` không phải dict ⇒ None.\"\"\"\n   158\t    try:\n   159\t        wf = yaml.safe_load(van)\n   160\t    except (yaml.YAMLError, RecursionError):\n   161\t        return None\n   162\t    return wf if type(wf) is dict and type(wf.get(\"jobs\")) is dict else None\n   163\t\n   164\tdef ghep_job(ten, wf):\n   165\t    \"\"\"r4 (d): khoá DUY NHẤT `k` mà tên job REST bằng `k`, bằng `name:` nguyên văn (không `${{`), hoặc là `<k|name> (<…>)`.\"\"\"\n   166\t    khop = [k for k, j in wf[\"jobs\"].items() if type(ten) is str and type(j) is dict and any(\n   167\t        type(x) is str and x and \"${{\" not in x and re.fullmatch(re.escape(x) + r\"(?: \\(.*\\))?\", ten) for x in (k, j.get(\"name\")))]\n   168\t    return khop[0] if len(khop) == 1 else None\n   169\t\n   170\tdef ten_du_kien(s):   # tên REST mà bước YAML phải mang: `name:` nguyên văn, không thì `Run <dòng đầu run:>` / `Run <uses>`\n   171\t    if \"name\" in s:\n   172\t        return s[\"name\"] if _chuoi(s[\"name\"]) and \"${{\" not in s[\"name\"] else None\n   173\t    v = s.get(\"run\", s.get(\"uses\"))\n   174\t    return \"Run \" + v.split(\"\\n\")[0] if _chuoi(v) else None\n   175\t\n   176\tdef _gio(v):   # `YYYY-MM-DDTHH:MM:SSZ` → datetime; sai dạng HAY sai lịch ⇒ None. Header log cắt về giây TRƯỚC khi gọi\n   177\t    try:\n   178\t        return datetime.datetime.strptime(v[:19], \"%Y-%m-%dT%H:%M:%S\") if type(v) is str and RE_GIO.fullmatch(v) else None\n   179\t    except ValueError:\n   180\t        return None\n   181\t\n   182\tdef ghep_buoc(job, buoc, wf, ly_do_wf):\n   183\t    \"\"\"r4 F02: ĐỊNH DANH bước của nhóm log — job REST → MỘT job YAML (d); nhóm i → bước REST đã chạy thứ i → bước YAML cùng vị trí,\n   184\t    kèm (a) số đếm ba mức · (b) tên · (c) giờ cắt về giây ∈ [started_at, completed_at]. Vế hỏng ⇒ CẢ job không marker (`None`).\"\"\"\n   185\t    def hong(ly_do):\n   186\t        return {\"trang_thai\": \"not_measured\", \"ly_do\": ly_do, \"so_buoc\": len(buoc)}, None\n   187\t    if wf is None:\n   188\t        return hong(ly_do_wf)\n   189\t    k, st = ghep_job(job.get(\"name\"), wf), job.get(\"steps\")\n   190\t    sy = wf[\"jobs\"][k].get(\"steps\") if k else None\n   191\t    if k is None or \"uses\" in wf[\"jobs\"][k] or type(sy) is not list or not all(type(s) is dict for s in sy):   # Q8: job gọi lại\n   192\t        return hong(\"d_job_yaml_khong_duy_nhat\")\n   193\t    if not (type(st) is list and all(type(s) is dict and _so(s.get(\"number\"), 1) for s in st)\n   194\t            and len({s[\"number\"] for s in st}) == len(st)):\n   195\t        return hong(\"steps_rest_sai_dang\")\n   196\t    ung = [s for s in sorted(st, key=lambda s: s[\"number\"]) if s.get(\"name\") not in (\"Set up job\", \"Complete job\")\n   197\t           and not str(s.get(\"name\")).startswith(\"Post \")]\n   198\t    chay = [i for i, s in enumerate(ung) if s.get(\"conclusion\") != \"skipped\"]\n   199\t    if len(buoc) != len(chay):\n   200\t        return hong(\"a_so_nhom_khac_so_buoc_rest_chay\")\n   201\t    if len(ung) != len(sy):\n   202\t        return hong(\"a_so_buoc_rest_khac_so_buoc_yaml\")\n   203\t    if any(not _chuoi(s.get(\"name\")) or s.get(\"name\") != ten_du_kien(y) for s, y in zip(ung, sy)):\n   204\t        return hong(\"b_ten_buoc_lech\")\n   205\t    if not all((a := _gio(ung[i].get(\"started_at\"))) and (z := _gio(ung[i].get(\"completed_at\")))\n   206\t               and (h := _gio(b[\"gio\"])) and a <= h <= z for b, i in zip(buoc, chay)):\n   207\t        return hong(\"c_gio_header_ngoai_cua_so\")\n   208\t    return {\"trang_thai\": \"passed\", \"so_buoc\": len(buoc)}, [(k, i) for i in chay]\n   209\t\n   210\tdef chan_buoc(wf, k, i):\n   211\t    \"\"\"r4 Q7: chặn chế độ của CHÍNH bước `i` job `k`: khoá ngoài `KHOA_BUOC`, `shell:` lạ, `defaults:`/`env:` lạ mức job/workflow, `run:`\n   212\t    ĐỨNG TRƯỚC trong CÙNG job nhắc `GITHUB_ENV`/`GITHUB_PATH`. Bước `uses:` đứng trước là giới hạn khai, không chặn.\"\"\"\n   213\t    j, s = wf[\"jobs\"][k], wf[\"jobs\"][k][\"steps\"][i]\n   214\t    return bool(\"defaults\" in wf or _env_chan(wf) or \"defaults\" in j or _env_chan(j) or set(s) - KHOA_BUOC\n   215\t                or s.get(\"shell\", \"bash\") not in (\"bash\", \"pwsh\", \"sh\")\n   216\t                or any(re.search(\"GITHUB_(ENV|PATH)\", str(t.get(\"run\", \"\"))) for t in j[\"steps\"][:i]))\n   217\t\n   218\tdef than(dong):\n   219\t    m = RE_DONG.match(dong)\n   220\t    return RE_ANSI.sub(\"\", m.group(2) if m else dong)\n   221\t\n   222\tdef doc_sha_checkout(dong):\n   223\t    \"\"\"Dòng ngay sau lệnh git có đuôi ` log -1 --format=%H`, khớp NGUYÊN dòng `<timestamp> <40 hex>`.\"\"\"\n   224\t    sha = []\n   225\t    for i, d in enumerate(dong[:-1]):\n   226\t        t = than(d)\n   227\t        if t.startswith(\"[command]\") and t.endswith(\" log -1 --format=%H\"):\n   228\t            k = RE_SHA.fullmatch(dong[i + 1])\n   229\t            if k:\n   230\t                sha.append(k.group(1))\n   231\t    return sha\n   232\t\n   233\tdef moc_checkout(sha_ds, event, head, git):\n   234\t    r = {\"dong_sha\": sha_ds}\n   235\t    if not sha_ds:\n   236\t        return r | {\"trang_thai\": \"not_measured\", \"ly_do\": \"khong_co_dong_sha_checkout\"}\n   237\t    if len(set(sha_ds)) > 1:\n   238\t        return r | {\"trang_thai\": \"failed\", \"ly_do\": \"nhieu_sha_checkout_khac_nhau\"}\n   239\t    sha = sha_ds[0]\n   240\t    obj = git(sha)\n   241\t    r |= {\"sha\": sha, \"parents\": obj[\"parents\"] if obj else \"not_measured\", \"tree\": obj[\"tree\"] if obj else \"not_measured\"}\n   242\t    if not (RUN_BAT_BUOC[\"event\"](event) and RUN_BAT_BUOC[\"head_sha\"](head)):\n   243\t        return r | {\"trang_thai\": \"not_measured\", \"ly_do\": \"REST_thieu_event_hoac_head_sha\"}\n   244\t    if sha == head:\n   245\t        return r | {\"trang_thai\": \"passed\", \"doi_chieu\": \"sha_bang_head_sha\"}\n   246\t    if event == \"pull_request\":\n   247\t        if not obj:\n   248\t            return r | {\"trang_thai\": \"not_measured\", \"ly_do\": \"khong_co_object_de_doi_chieu_parents\"}\n   249\t        if head in obj[\"parents\"]:\n   250\t            return r | {\"trang_thai\": \"passed\", \"doi_chieu\": \"head_sha_trong_parents_merge_tong_hop\"}\n   251\t    return r | {\"trang_thai\": \"failed\", \"ly_do\": f\"sha_checkout_lech_head_sha ({event})\"}\n   252\t\n   253\tdef tach_buoc(dong):\n   254\t    \"\"\"[{lenh, gio, in_lai, hop_le, phan}]: nhóm = từ `##[group]Run <lệnh>` tới trước `##[group]Run` kế; `gio` = timestamp header.\n   255\t    `gio` cắt về giây. `in_lai` = dòng `36;1m` LIỀN sau header, bỏ ANSI — CHỈ để đối chiếu, KHÔNG làm kịch bản (M10). `hop_le` = cấu trúc đo trên 226/226\n   256\t    nhóm thật (màu đầu = header, kế khối màu là `shell: `, không màu sau đó, có `##[endgroup]`, r4: không `##[group]` lồng trong vùng\n   257\t    nhóm đang mở). `phan` = sau `##[endgroup]`, nơi duy nhất đo marker.\"\"\"\n   258\t    buoc = []\n   259\t    for d in dong:\n   260\t        t = than(d)\n   261\t        if t.startswith(\"##[group]Run \"):\n   262\t            buoc.append({\"lenh\": t[len(\"##[group]Run \"):], \"in_lai\": [], \"phan\": [], \"mo\": True, \"ok\": True, \"tien_to\": True,\n   263\t                         \"gio\": d[:19] + \"Z\"})\n   264\t        elif buoc and (b := buoc[-1])[\"mo\"]:\n   265\t            mau = \"\\x1b[36;1m\" in d\n   266\t            if t == \"##[endgroup]\":   # nguyên văn: 753/753 dòng đóng trên 37 log thật (đo 25-10-2026)\n   267\t                b[\"mo\"] = False\n   268\t            elif mau and b[\"tien_to\"]:\n   269\t                b[\"in_lai\"].append(t)\n   270\t            else:\n   271\t                b[\"ok\"], b[\"tien_to\"] = b[\"ok\"] and not mau and not t.startswith(\"##[group]\") and (  # r4 Q6: nhóm lồng ⇒ hỏng\n   272\t                    not b[\"tien_to\"] or t.startswith(\"shell: \")), False\n   273\t        elif buoc:\n   274\t            buoc[-1][\"phan\"].append(t)\n   275\t    return [b | {\"hop_le\": not b[\"mo\"] and b[\"ok\"] and not b[\"tien_to\"] and b[\"in_lai\"][:1] == [b[\"lenh\"]]} for b in buoc]\n   276\t\n   277\tdef dong_logic(lenh):\n   278\t    \"\"\"Nối dòng kết thúc bằng `\\\\` thành MỘT dòng logic — một đối số nằm ở dòng nối không thành lệnh riêng.\"\"\"\n   279\t    ra, noi = [], \"\"\n   280\t    for d in lenh:\n   281\t        noi += d[:-1] + \" \" if d.endswith(\"\\\\\") else d\n   282\t        if not d.endswith(\"\\\\\"):\n   283\t            ra.append(noi.strip())\n   284\t            noi = \"\"\n   285\t    return ra + ([noi.strip()] if noi else [])\n   286\t\n   287\tdef do_dau_duong(buoc, moi, xanh, wf, ghep):\n   288\t    \"\"\"(kết quả, số bước XÁC THỰC). Nhóm i chỉ xét qua bước YAML `ghep` ĐỊNH DANH cho nó (r4): `run:` là chuỗi, KHÔNG `uses:` (Q8),\n   289\t    khối in lại hợp lệ BẰNG NGUYÊN VĂN `run:` của CHÍNH bước ấy, TOÀN KHỐI là lời gọi tối giản. `chan_buoc` hoặc `VAR=` ⇒ lời gọi\n   290\t    `MOI` ra `not_measured` (`che_do_khong_xac_dinh`); còn lại áp ĐÚNG regex `MOI` lên phần log của CHÍNH nhóm ấy.\"\"\"\n   291\t    kq, so = [], 0\n   292\t    for b, (k, i) in zip(buoc, ghep or []):\n   293\t        s = wf[\"jobs\"][k][\"steps\"][i]\n   294\t        run = s.get(\"run\") if \"uses\" not in s else None\n   295\t        if not (type(run) is str and b[\"hop_le\"] and run.rstrip(\"\\n\") == \"\\n\".join(b[\"in_lai\"])):\n   296\t            continue\n   297\t        so += 1\n   298\t        goi = [RE_LOI_GOI.fullmatch(d) for d in dong_logic(run.rstrip(\"\\n\").split(\"\\n\")) if d]\n   299\t        chan = chan_buoc(wf, k, i) or any(g and g[1] for g in goi)\n   300\t        for duong in dict.fromkeys([g[2] for g in goi] if goi and all(goi) else []):\n   301\t            muc = {\"lenh\": b[\"lenh\"], \"duong_dan\": duong}\n   302\t            if duong not in moi or chan:\n   303\t                kq.append(muc | {\"trang_thai\": \"not_measured\", \"ly_do\": \"khong_co_trong_MOI\" if duong not in moi else \"che_do_khong_xac_dinh\"})\n   304\t            else:\n   305\t                van = \"\\n\".join(b[\"phan\"]) + \"\\n\"\n   306\t                k = re.search(moi[duong], van, re.M) if (ok := xanh(van, moi[duong])) else None\n   307\t                kq.append(muc | {\"trang_thai\": \"passed\" if ok else \"failed\", \"dong_khop\": k.group(0).splitlines() if k else []})\n   308\t    return kq, so\n   309\t\n   310\tdef moc_gate(job, dong, moi, xanh, wf=None, ly_do_wf=\"\"):\n   311\t    hop = {k: hop_le(job.get(k)) for k, hop_le in JOB_BAT_BUOC.items()}   # chiếu CHỈ trường đã hợp lệ: không ném với kiểu lạ\n   312\t    r = {\"job_id\": job[\"id\"], \"name\": job.get(\"name\"), \"check_run_id\": job[\"check_run_url\"].rsplit(\"/\", 1)[-1] if hop[\"check_run_url\"]\n   313\t         else None, \"labels\": job.get(\"labels\"), \"runner_id\": job.get(\"runner_id\"), \"runner_name\": job.get(\"runner_name\"),\n   314\t         \"conclusion\": job.get(\"conclusion\"),\n   315\t         \"buoc\": [{\"name\": s[\"name\"], \"conclusion\": s[\"conclusion\"]} for s in job[\"steps\"]] if hop[\"steps\"] else \"not_measured\"}\n   316\t    if job.get(\"conclusion\") == \"skipped\":\n   317\t        return r | {\"trang_thai\": \"skipped\"}\n   318\t    if job.get(\"runner_id\") == 0:\n   319\t        return r | {\"trang_thai\": \"not_run\"}\n   320\t    anh = [than(d)[len(\"Image: \"):] for d in dong if than(d).startswith(\"Image: \")]\n   321\t    gh, ghep = ghep_buoc(job, buoc := tach_buoc(dong), wf, ly_do_wf)\n   322\t    dau, so = do_dau_duong(buoc, moi, xanh, wf, ghep)\n   323\t    thieu = [k for k, ok in hop.items() if not ok]\n   324\t    r |= {\"image\": anh[0] if anh else \"not_measured\", \"dau_duong\": dau, \"thieu\": thieu, \"ghep_buoc\": gh, \"kich_ban\": {\"buoc_xac_thuc\": so} | (\n   325\t        {\"trang_thai\": \"not_measured\", \"ly_do\": ly_do_wf} if wf is None else {\"trang_thai\": \"passed\", \"nguon\": \"run_tai_sha_checkout\"})}\n   326\t    tt = {x[\"trang_thai\"] for x in dau}\n   327\t    if job.get(\"conclusion\") in LOI_JOB or \"failed\" in tt:\n   328\t        return r | {\"trang_thai\": \"failed\"}\n   329\t    return r | {\"trang_thai\": \"not_measured\" if thieu or \"passed\" not in tt else \"passed\"}\n   330\t\n   331\tdef thu(repo, run, attempt, goi, git, moi_tu=CI_DANG_KY, wf=git_blob):\n   332\t    goc = f\"{API}/repos/{repo}/actions\"\n   333\t    r, byte_run = lay_json(goi, f\"{goc}/runs/{run}\")\n   334\t    if type(r) is not dict:\n   335\t        raise LoiRest(f\"than_sai_dang (run là {type(r).__name__})\", f\"{goc}/runs/{run}\")\n   336\t    jobs = lay_trang(goi, f\"{goc}/runs/{run}/attempts/{attempt}/jobs\", \"jobs\")\n   337\t    arts = lay_trang(goi, f\"{goc}/runs/{run}/artifacts\", \"artifacts\")\n   338\t    moi, xanh = doc_moi(moi_tu)\n   339\t    moc_run = {\"repo\": repo, \"run_id\": r.get(\"id\"), \"run_attempt\": r.get(\"run_attempt\"), \"event\": r.get(\"event\"), \"head_sha\":\n   340\t               r.get(\"head_sha\"), \"loi_khai_rest_path\": r.get(\"path\"), \"check_suite_id\": r.get(\"check_suite_id\"), \"nguon\": f\"{goc}/runs/{run}\"}\n   341\t    thieu = [k for k, hop_le in RUN_BAT_BUOC.items() if not hop_le(r.get(k))]\n   342\t    lech = [k for k, v in ((\"id\", run), (\"run_attempt\", attempt)) if k not in thieu and r.get(k) != v]\n   343\t    moc_run |= {\"thieu\": thieu, \"lech\": lech, \"trang_thai\": \"failed\" if lech else \"not_measured\" if thieu else \"passed\"}\n   344\t    tep = {\"run.json\": byte_run, \"jobs.json\": json.dumps(jobs, ensure_ascii=False, indent=1).encode()}\n   345\t    co, gate, log = [], [], {}\n   346\t    for j in jobs[\"jobs\"]:\n   347\t        if j.get(\"conclusion\") == \"skipped\" or j.get(\"runner_id\") == 0:\n   348\t            co.append({\"job_id\": j[\"id\"], \"name\": j.get(\"name\"), \"trang_thai\": \"skipped\" if j.get(\"conclusion\") == \"skipped\" else \"not_run\"})\n   349\t            gate.append(moc_gate(j, [], moi, xanh))\n   350\t            continue\n   351\t        byte = lay(goi, f\"{goc}/jobs/{j['id']}/logs\")\n   352\t        dong = byte.decode(\"utf-8\", \"replace\").splitlines()\n   353\t        co.append({\"job_id\": j[\"id\"], \"name\": j.get(\"name\")} | moc_checkout(doc_sha_checkout(dong), r.get(\"event\"), r.get(\"head_sha\"), git))\n   354\t        sha = co[-1].get(\"sha\") if co[-1][\"trang_thai\"] == \"passed\" else None   # CHỈ SHA checkout đã đo, không `head_sha`\n   355\t        van = wf(sha, r[\"path\"]) if sha and RUN_BAT_BUOC[\"path\"](r.get(\"path\")) else None\n   356\t        g = moc_gate(j, dong, moi, xanh, doc_wf(van) if van is not None else None,\n   357\t                     \"sha_checkout_chua_do\" if not sha else \"workflow_tai_sha_khong_doc_duoc\")\n   358\t        gate.append(g)\n   359\t        khop = {k for x in g.get(\"dau_duong\", []) for k in x.get(\"dong_khop\", [])}\n   360\t        trich = [d for i, d in enumerate(dong) if than(d).startswith((\"##[group]Run \", \"Image: \")) or than(d) in khop\n   361\t                 or RE_SHA.match(d) or (i + 1 < len(dong) and RE_SHA.match(dong[i + 1]))]\n   362\t        tep[f\"jobs/{j['id']}.trich.txt\"] = (\"\\n\".join(trich) + \"\\n\").encode()\n   363\t        log[j[\"id\"]] = {\"sha256\": hashlib.sha256(byte).hexdigest(), \"bytes\": len(byte), \"trich\": f\"jobs/{j['id']}.trich.txt\"}\n   364\t    prov = {\"schema\": \"ci_provenance/1\", \"cong_cu\": \"ops/ci_provenance.py\", \"nguon\": \"REST\", \"attempt_yeu_cau\": attempt,\n   365\t            \"moc\": {\"run\": moc_run, \"checkout\": co,\n   366\t                    \"gate_output\": {\"jobs\": gate, \"tap_jobs\": tap(jobs, \"jobs\"), \"tap_artifacts\": tap(arts, \"artifacts\", ART_BAT_BUOC), \"artifacts\": [\n   367\t                        {k: a.get(k) for k in (\"id\", \"name\", \"digest\", \"size_in_bytes\", \"expired\")} for a in arts[\"artifacts\"]]},\n   368\t                    \"workflow_definition\": {\"trang_thai\": \"not_measured\", \"ly_do\": LY_DO_WD, \"loi_khai_rest_path\": r.get(\"path\")}},\n   369\t            \"log_day_du\": log}\n   370\t    tep[\"provenance.yaml\"] = yaml.safe_dump(prov, sort_keys=False, allow_unicode=True).encode()\n   371\t    return prov, tep\n   372\t\n   373\tdef ghi_tep(p, byte):\n   374\t    p.parent.mkdir(parents=True, exist_ok=True)\n   375\t    p.write_bytes(byte)\n   376\t\n   377\tdef ghi_nguyen_tu(out, tep):\n   378\t    \"\"\"Ghi vào thư mục tạm CÙNG CẤP rồi `os.replace`: lỗi giữa chừng ⇒ `out` vắng hoặc giữ nguyên bản trước.\"\"\"\n   379\t    out = Path(out).resolve()\n   380\t    out.parent.mkdir(parents=True, exist_ok=True)\n   381\t    tam = Path(tempfile.mkdtemp(prefix=f\".{out.name}.tam-\", dir=out.parent))\n   382\t    cu = out.parent / f\"{tam.name}.cu\"\n   383\t    try:\n   384\t        for ten, byte in tep.items():\n   385\t            ghi_tep(tam / ten, byte)\n   386\t        if out.exists():\n   387\t            os.replace(out, cu)\n   388\t        os.replace(tam, out)\n   389\t    except BaseException:\n   390\t        if cu.exists() and not out.exists():\n   391\t            os.replace(cu, out)\n   392\t        shutil.rmtree(tam, ignore_errors=True)\n   393\t        raise\n   394\t    shutil.rmtree(cu, ignore_errors=True)\n   395\t\n   396\tdef cac_trang_thai(prov):\n   397\t    m = prov[\"moc\"]\n   398\t    g = m[\"gate_output\"]\n   399\t    return ([m[\"run\"][\"trang_thai\"], m[\"workflow_definition\"][\"trang_thai\"], g[\"tap_jobs\"][\"trang_thai\"],\n   400\t             g[\"tap_artifacts\"][\"trang_thai\"]] + [x[\"trang_thai\"] for x in m[\"checkout\"]] + [x[\"trang_thai\"] for x in g[\"jobs\"]])\n   401\t\n   402\tdef main(argv=None, goi=goi_that, git=git_cuc_bo, moi_tu=CI_DANG_KY, wf=git_blob):\n   403\t    p = argparse.ArgumentParser(prog=\"ci_provenance.py\", description=__doc__.split(\"\\n\")[0])\n   404\t    sub = p.add_subparsers(dest=\"lenh\", required=True)\n   405\t    t = sub.add_parser(\"thu\", help=\"thu provenance của MỘT run/attempt bằng REST\")\n   406\t    t.add_argument(\"--repo\", required=True, help=\"owner/repo\")\n   407\t    t.add_argument(\"--run\", required=True, type=int, help=\"id workflow run\")\n   408\t    t.add_argument(\"--attempt\", required=True, type=int, help=\"run_attempt phải đo\")\n   409\t    t.add_argument(\"--out\", required=True, help=\"thư mục đầu ra (ghi nguyên tử)\")\n   410\t    try:\n   411\t        a = p.parse_args(argv)\n   412\t    except SystemExit as e:\n   413\t        if e.code == 0:\n   414\t            return 0\n   415\t        print(KHONG_SINH)\n   416\t        return 2\n   417\t    if not RE_REPO.fullmatch(a.repo) or a.run <= 0 or a.attempt <= 0:\n   418\t        print(f\"SAI_DOI_SO: --repo owner/repo, --run/--attempt nguyên dương (được {a.repo!r} {a.run} {a.attempt})\\n{KHONG_SINH}\")\n   419\t        return 2\n   420\t    try:\n   421\t        prov, tep = thu(a.repo, a.run, a.attempt, goi, git, moi_tu, wf)\n   422\t    except LoiRest as e:\n   423\t        print(f\"REST_LOI: HTTP {e.ma} {e.url}\\n{KHONG_SINH}\")\n   424\t        return 3\n   425\t    except Exception:   # lưới cuối M7: lỗi thu ngoài hợp đồng vẫn in dòng đếm, rồi NỔI LÊN (không nuốt, không bịa rc)\n   426\t        print(KHONG_SINH)\n   427\t        raise\n   428\t    try:\n   429\t        ghi_nguyen_tu(a.out, tep)\n   430\t    except OSError as e:   # không có provenance ⇒ vẫn in dòng đếm, rồi để lỗi I/O nổi lên (rc 1, không bịa mã mới)\n   431\t        print(f\"LOI_GHI: {e}\\n{KHONG_SINH}\")\n   432\t        raise\n   433\t    m = prov[\"moc\"]\n   434\t    print(f\"RUN: {m['run']['trang_thai']} (run_attempt {m['run']['run_attempt']}, yeu cau {a.attempt})\")\n   435\t    for c, g in zip(m[\"checkout\"], m[\"gate_output\"][\"jobs\"]):\n   436\t        print(f\"JOB {c['job_id']} {c['name']}: checkout={c['trang_thai']} {c.get('sha', '-')} gate={g['trang_thai']}\")\n   437\t    print(f\"WORKFLOW_DEFINITION: {m['workflow_definition']['trang_thai']} ({LY_DO_WD})\")\n   438\t    tt = cac_trang_thai(prov)\n   439\t    print(f\"provenance.yaml sha256 {hashlib.sha256(tep['provenance.yaml']).hexdigest()}\")\n   440\t    print(f\"NOT_MEASURED: {tt.count('not_measured')}\")\n   441\t    return 12 if \"failed\" in tt else 0\n   442\t\n   443\tif __name__ == \"__main__\":\n   444\t    raise SystemExit(main(sys.argv[1:]))\n","exit_code":0,"status":"completed"}}
