{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc 'cat ops/ci_provenance.py'","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Thu provenance CI §10.2.2 từ REST và log job — packet #899 (wp899 P-A), đặc tả `ops/specs/wp899-r4.md` (thay r3).\n\n`thu --repo o/r --run ID --attempt N --out DIR` ghi bốn mốc TÁCH BẠCH (Run · Checkout · Gate output · Workflow definition)\nvào `DIR/provenance.yaml`. Chỉ REST; mọi lời gọi mạng đi qua MỘT hàm tiêm vào `goi(url) -> (mã HTTP, byte)` để test chạy\noffline. Năm trạng thái §10.2.3: thiếu dữ liệu là `not_measured`, không bao giờ là `passed`. Mốc Workflow definition luôn\n`not_measured` (GraphQL bị chặn trong phiên Claude; việc của P-B). SHA checkout đọc từ LOG, không lấy `head_sha` của REST.\nr3 (F02): kịch bản của bước lấy từ `run:` của workflow tại SHA checkout ĐÃ ĐO (`git cat-file blob <sha>:<path REST>`). r4 (F02):\nbước của mỗi nhóm log được ĐỊNH DANH qua REST `steps[]` + vị trí (`ghep_buoc`), không tìm ứng viên trùng chữ trên toàn workflow. Gốc tin là nội dung tại SHA ấy — workflow tại SHA vốn quyết định được mọi output, công cụ không chống nó.\nThoát: 0 không mốc nào `failed` · 12 có `failed` · 2 sai đối số · 3 REST khác 2xx (in nguyên mã). LUÔN in `NOT_MEASURED: <n>`;\nrc 2/3 không sinh provenance nên cả bốn mốc là chưa đo (`NOT_MEASURED: 4` kèm `PROVENANCE: khong_sinh`).\n\"\"\"\nimport argparse, datetime, hashlib, importlib.util, json, os, re, shutil, subprocess, sys, tempfile, urllib.error, urllib.request\nfrom pathlib import Path\n\nimport yaml\n\nfor _s in (sys.stdout, sys.stderr):\n    if hasattr(_s, \"reconfigure\"):\n        _s.reconfigure(encoding=\"utf-8\", errors=\"backslashreplace\")\n\nROOT = Path(__file__).resolve().parent.parent\nCI_DANG_KY = ROOT / \".claude/dev/ci_dang_ky_test.py\"\nAPI = \"https://api.github.com\"\nTRANG = 100\nTRANG_TOI_DA = 1000\nTS = r\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z\"   # ASCII: `\\d` khớp cả chữ số Unicode\nRE_DONG = re.compile(rf\"^({TS}) ?(.*)$\")\nRE_SHA = re.compile(rf\"^{TS} ([0-9a-f]{{40}})$\")\nRE_GIO = re.compile(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\")\nRE_ANSI = re.compile(r\"\\x1b\\[[0-9;]*m\")\nRE_HEX40 = re.compile(r\"^[0-9a-f]{40}$\")\nRE_REPO = re.compile(r\"^[\\w.-]+/[\\w.-]+$\")\nLY_DO_WD = \"graphql_bi_chan_trong_phien_claude; cho P-B\"\nKET_BUOC = (\"success\", \"failure\", \"cancelled\", \"skipped\", \"neutral\")\nLOI_JOB = (\"failure\", \"cancelled\", \"timed_out\", \"action_required\", \"startup_failure\", \"stale\")\nRE_CHECK_RUN = re.compile(r\"^https://api\\.github\\.com/repos/[\\w.-]+/[\\w.-]+/check-runs/[1-9]\\d*$\")\n# Lời gọi python DUY NHẤT tính là bằng chứng (danh sách CHO PHÉP): cả dòng logic là `[VAR=… ]python[ver] [cờ không đối số…]\n# [./]<script>.py` — KHÔNG đối số sau script (r3 Q4), không nháy/toán tử/chú thích. Nhóm 1 = tiền tố `VAR=` (⇒ chặn chế độ).\nRE_LOI_GOI = re.compile(r\"^((?:[A-Za-z_]\\w*=[\\w./:-]*\\s+)*)(?:[\\w./-]*/)?python(?:\\d+(?:\\.\\d+)*)?(?:\\s+-[BuIsSEOqb]+)*\"\n                        r\"\\s+(?:\\./)?([\\w.-]+(?:/[\\w.-]+)*\\.py)$\")\nKHOA_BUOC = {\"name\", \"id\", \"if\", \"run\", \"shell\", \"timeout-minutes\", \"continue-on-error\"}   # CHO PHÉP; env/working-directory… ⇒ chặn\n\ndef _so(v, nho=0):\n    return type(v) is int and v >= nho   # `bool` là con của `int`: `type(...) is int` loại True/False\n\ndef _chuoi(v):\n    return type(v) is str and v.strip() != \"\"\n\nRUN_BAT_BUOC = {\"id\": lambda v: _so(v, 1), \"run_attempt\": lambda v: _so(v, 1), \"event\": _chuoi, \"path\": _chuoi,\n                \"head_sha\": lambda v: _chuoi(v) and bool(RE_HEX40.fullmatch(v)), \"check_suite_id\": lambda v: _so(v, 1)}\nJOB_BAT_BUOC = {\"name\": _chuoi, \"runner_id\": lambda v: _so(v, 1), \"runner_name\": _chuoi, \"conclusion\": lambda v: v == \"success\",\n                \"labels\": lambda v: type(v) is list and bool(v) and all(_chuoi(x) for x in v),\n                \"check_run_url\": lambda v: _chuoi(v) and bool(RE_CHECK_RUN.fullmatch(v)), \"steps\": lambda v: type(v) is list and bool(v)\n                and all(type(b) is dict and _chuoi(b.get(\"name\")) and b.get(\"conclusion\") in KET_BUOC for b in v)}\nART_BAT_BUOC = {\"name\": _chuoi, \"size_in_bytes\": _so, \"expired\": lambda v: type(v) is bool,\n                \"digest\": lambda v: v is None or (_chuoi(v) and v.startswith(\"sha256:\"))}\nKHONG_SINH = \"NOT_MEASURED: 4\\nPROVENANCE: khong_sinh (ca bon moc chua do)\"\n\nclass LoiRest(Exception):\n    def __init__(self, ma, url):\n        super().__init__(f\"REST {ma} {url}\")\n        self.ma, self.url = ma, url\n\nclass _KhongChuyenHuong(urllib.request.HTTPRedirectHandler):\n    def redirect_request(self, *a, **k):\n        return None\n\ndef goi_that(url):\n    \"\"\"GET REST. Log job trả 302 sang kho blob: theo TAY và KHÔNG mang token sang host khác.\"\"\"\n    tk = next((os.environ[k] for k in (\"GITHUB_PAT\", \"GH_TOKEN\", \"GITHUB_TOKEN\") if os.environ.get(k)), None)\n    hd = {\"Accept\": \"application/vnd.github+json\", \"X-GitHub-Api-Version\": \"2022-11-28\"}\n    if tk:\n        hd[\"Authorization\"] = f\"Bearer {tk}\"\n    yeu_cau, mo = urllib.request.Request(url, headers=hd), urllib.request.build_opener(_KhongChuyenHuong).open\n    for _ in range(2):   # lượt 2 (nếu có) là URL chuyển hướng: cùng hợp đồng lỗi, chuỗi trần nên không có header token\n        try:\n            with mo(yeu_cau, timeout=120) as r:\n                return r.status, r.read()\n        except urllib.error.HTTPError as e:\n            loc = e.headers.get(\"Location\") if e.code in (301, 302, 303, 307, 308) else None\n            if not loc or mo is urllib.request.urlopen:\n                return e.code, b\"\"\n            yeu_cau, mo = loc, urllib.request.urlopen\n        except (urllib.error.URLError, OSError) as e:\n            raise LoiRest(f\"khong_ket_noi ({e})\", url)\n\ndef lay(goi, url):\n    ma, byte = goi(url)\n    if not (isinstance(ma, int) and 200 <= ma < 300):\n        raise LoiRest(ma, url)\n    return byte\n\ndef lay_json(goi, url):\n    \"\"\"(đối tượng, byte nguyên văn).\"\"\"\n    byte = lay(goi, url)\n    try:\n        return json.loads(byte), byte\n    except ValueError:\n        raise LoiRest(\"than_khong_phai_json\", url)\n\ndef lay_trang(goi, url, khoa):\n    \"\"\"Đọc tới trang NGẮN hơn `TRANG`. Đủ ⇔ số ID DUY NHẤT = `total_count` và total không đổi giữa trang; thiếu, trùng,\n    total đổi hay chạm `TRANG_TOI_DA` ⇒ `du: False` (không suy gì về phần thiếu; mốc tập hợp `not_measured`).\"\"\"\n    ds, ids, tong, trang, du = [], set(), None, 1, True\n    try:\n        while True:\n            d = lay_json(goi, f\"{url}?per_page={TRANG}&page={trang}\")[0]\n            if not (_so(d[\"total_count\"]) and type(d[khoa]) is list and all(type(x) is dict and _so(x[\"id\"], 1) for x in d[khoa])):\n                raise TypeError(f\"total_count/{khoa}/id sai kiểu\")\n            du, tong = du and tong in (None, d[\"total_count\"]), d[\"total_count\"]\n            for x in d[khoa]:\n                du = du and x[\"id\"] not in ids\n                if x[\"id\"] not in ids:\n                    ids.add(x[\"id\"])\n                    ds.append(x)\n            if len(d[khoa]) < TRANG or trang >= TRANG_TOI_DA:   # đọc tới trang NGẮN: total trang đầu có thể khai thấp\n                return {\"total_count\": tong, khoa: ds, \"du\": du and len(ids) == tong and len(d[khoa]) < TRANG}\n            trang += 1\n    except (KeyError, TypeError) as e:\n        raise LoiRest(f\"than_sai_dang ({e!r})\", url)\n\ndef tap(d, khoa, bat_buoc=None):\n    sai = sorted({k for x in d[khoa] for k, hop_le in (bat_buoc or {}).items() if not hop_le(x.get(k))})\n    return {\"trang_thai\": \"passed\" if d[\"du\"] and not sai else \"not_measured\", \"total_count\": d[\"total_count\"],\n            \"so_id\": len(d[khoa]), \"truong_sai\": sai}\n\ndef doc_moi(duong=CI_DANG_KY):\n    \"\"\"`MOI` và `bang_chung_xanh` đọc bằng IMPORT sổ đăng ký — một nguồn, không chép bảng.\"\"\"\n    spec = importlib.util.spec_from_file_location(\"ci_dang_ky_cho_provenance\", duong)\n    m = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(m)\n    return dict(m.MOI), m.bang_chung_xanh\n\ndef git_cuc_bo(sha, goc=ROOT):\n    \"\"\"parents/tree của commit trong kho cục bộ; không có object (hoặc không phải commit) ⇒ None.\"\"\"\n    try:\n        r = subprocess.run([\"git\", \"-C\", str(goc), \"cat-file\", \"-p\", sha], capture_output=True, text=True, timeout=60)\n    except (OSError, subprocess.SubprocessError):\n        return None\n    dau = r.stdout.split(\"\\n\\n\", 1)[0].splitlines() if r.returncode == 0 else []\n    tree = [x[5:] for x in dau if x.startswith(\"tree \")]\n    return {\"tree\": tree[0], \"parents\": [x[7:] for x in dau if x.startswith(\"parent \")]} if len(tree) == 1 else None\n\ndef git_blob(sha, path, goc=ROOT):\n    \"\"\"Văn bản blob `<sha>:<path>` trong kho cục bộ; thiếu object/tệp, không phải blob hay không UTF-8 ⇒ None.\"\"\"\n    try:\n        r = subprocess.run([\"git\", \"-C\", str(goc), \"cat-file\", \"blob\", f\"{sha}:{path}\"], capture_output=True, timeout=60)\n        return r.stdout.decode(\"utf-8\") if r.returncode == 0 else None\n    except (OSError, subprocess.SubprocessError, UnicodeDecodeError):\n        return None\n\ndef _env_chan(d):   # CÓ khoá `env:` mà giá trị không phải dict (biểu thức, null — D01) hoặc có khoá `CI_DANG_KY_*` ⇒ không biết chế độ\n    return \"env\" in d and (type(d[\"env\"]) is not dict or any(str(k).startswith(\"CI_DANG_KY_\") for k in d[\"env\"]))\n\ndef doc_wf(van):\n    \"\"\"Workflow tại SHA (`yaml.safe_load`); hỏng, không phải dict hay `jobs` không phải dict ⇒ None.\"\"\"\n    try:\n        wf = yaml.safe_load(van)\n    except (yaml.YAMLError, RecursionError):\n        return None\n    return wf if type(wf) is dict and type(wf.get(\"jobs\")) is dict else None\n\ndef ghep_job(ten, wf):\n    \"\"\"r4 (d): khoá DUY NHẤT `k` mà tên job REST bằng `k`, bằng `name:` nguyên văn (không `${{`), hoặc là `<k|name> (<…>)`.\"\"\"\n    khop = [k for k, j in wf[\"jobs\"].items() if type(ten) is str and type(j) is dict and any(\n        type(x) is str and x and \"${{\" not in x and re.fullmatch(re.escape(x) + r\"(?: \\(.*\\))?\", ten) for x in (k, j.get(\"name\")))]\n    return khop[0] if len(khop) == 1 else None\n\ndef ten_du_kien(s):   # tên REST mà bước YAML phải mang: `name:` nguyên văn, không thì `Run <dòng đầu run:>` / `Run <uses>`\n    if \"name\" in s:\n        return s[\"name\"] if _chuoi(s[\"name\"]) and \"${{\" not in s[\"name\"] else None\n    v = s.get(\"run\", s.get(\"uses\"))\n    return \"Run \" + v.split(\"\\n\")[0] if _chuoi(v) else None\n\ndef _gio(v):   # `YYYY-MM-DDTHH:MM:SSZ` → datetime; sai dạng HAY sai lịch ⇒ None. Header log cắt về giây TRƯỚC khi gọi\n    try:\n        return datetime.datetime.strptime(v[:19], \"%Y-%m-%dT%H:%M:%S\") if type(v) is str and RE_GIO.fullmatch(v) else None\n    except ValueError:\n        return None\n\ndef ghep_buoc(job, buoc, wf, ly_do_wf):\n    \"\"\"r4 F02: ĐỊNH DANH bước của nhóm log — job REST → MỘT job YAML (d); nhóm i → bước REST đã chạy thứ i → bước YAML cùng vị trí,\n    kèm (a) số đếm ba mức · (b) tên · (c) giờ cắt về giây ∈ [started_at, completed_at]. Vế hỏng ⇒ CẢ job không marker (`None`).\"\"\"\n    def hong(ly_do):\n        return {\"trang_thai\": \"not_measured\", \"ly_do\": ly_do, \"so_buoc\": len(buoc)}, None\n    if wf is None:\n        return hong(ly_do_wf)\n    k, st = ghep_job(job.get(\"name\"), wf), job.get(\"steps\")\n    sy = wf[\"jobs\"][k].get(\"steps\") if k else None\n    if k is None or \"uses\" in wf[\"jobs\"][k] or type(sy) is not list or not all(type(s) is dict for s in sy):   # Q8: job gọi lại\n        return hong(\"d_job_yaml_khong_duy_nhat\")\n    if not (type(st) is list and all(type(s) is dict and _so(s.get(\"number\"), 1) for s in st)\n            and len({s[\"number\"] for s in st}) == len(st)):\n        return hong(\"steps_rest_sai_dang\")\n    ung = [s for s in sorted(st, key=lambda s: s[\"number\"]) if s.get(\"name\") not in (\"Set up job\", \"Complete job\")\n           and not str(s.get(\"name\")).startswith(\"Post \")]\n    chay = [i for i, s in enumerate(ung) if s.get(\"conclusion\") != \"skipped\"]\n    if len(buoc) != len(chay):\n        return hong(\"a_so_nhom_khac_so_buoc_rest_chay\")\n    if len(ung) != len(sy):\n        return hong(\"a_so_buoc_rest_khac_so_buoc_yaml\")\n    if any(not _chuoi(s.get(\"name\")) or s.get(\"name\") != ten_du_kien(y) for s, y in zip(ung, sy)):\n        return hong(\"b_ten_buoc_lech\")\n    if not all((a := _gio(ung[i].get(\"started_at\"))) and (z := _gio(ung[i].get(\"completed_at\")))\n               and (h := _gio(b[\"gio\"])) and a <= h <= z for b, i in zip(buoc, chay)):\n        return hong(\"c_gio_header_ngoai_cua_so\")\n    return {\"trang_thai\": \"passed\", \"so_buoc\": len(buoc)}, [(k, i) for i in chay]\n\ndef chan_buoc(wf, k, i):\n    \"\"\"r4 Q7: chặn chế độ của CHÍNH bước `i` job `k`: khoá ngoài `KHOA_BUOC`, `shell:` lạ, `defaults:`/`env:` lạ mức job/workflow, `run:`\n    ĐỨNG TRƯỚC trong CÙNG job nhắc `GITHUB_ENV`/`GITHUB_PATH`. Bước `uses:` đứng trước là giới hạn khai, không chặn.\"\"\"\n    j, s = wf[\"jobs\"][k], wf[\"jobs\"][k][\"steps\"][i]\n    return bool(\"defaults\" in wf or _env_chan(wf) or \"defaults\" in j or _env_chan(j) or set(s) - KHOA_BUOC\n                or s.get(\"shell\", \"bash\") not in (\"bash\", \"pwsh\", \"sh\")\n                or any(re.search(\"GITHUB_(ENV|PATH)\", str(t.get(\"run\", \"\"))) for t in j[\"steps\"][:i]))\n\ndef than(dong):\n    m = RE_DONG.match(dong)\n    return RE_ANSI.sub(\"\", m.group(2) if m else dong)\n\ndef doc_sha_checkout(dong):\n    \"\"\"Dòng ngay sau lệnh git có đuôi ` log -1 --format=%H`, khớp NGUYÊN dòng `<timestamp> <40 hex>`.\"\"\"\n    sha = []\n    for i, d in enumerate(dong[:-1]):\n        t = than(d)\n        if t.startswith(\"[command]\") and t.endswith(\" log -1 --format=%H\"):\n            k = RE_SHA.fullmatch(dong[i + 1])\n            if k:\n                sha.append(k.group(1))\n    return sha\n\ndef moc_checkout(sha_ds, event, head, git):\n    r = {\"dong_sha\": sha_ds}\n    if not sha_ds:\n        return r | {\"trang_thai\": \"not_measured\", \"ly_do\": \"khong_co_dong_sha_checkout\"}\n    if len(set(sha_ds)) > 1:\n        return r | {\"trang_thai\": \"failed\", \"ly_do\": \"nhieu_sha_checkout_khac_nhau\"}\n    sha = sha_ds[0]\n    obj = git(sha)\n    r |= {\"sha\": sha, \"parents\": obj[\"parents\"] if obj else \"not_measured\", \"tree\": obj[\"tree\"] if obj else \"not_measured\"}\n    if not (RUN_BAT_BUOC[\"event\"](event) and RUN_BAT_BUOC[\"head_sha\"](head)):\n        return r | {\"trang_thai\": \"not_measured\", \"ly_do\": \"REST_thieu_event_hoac_head_sha\"}\n    if sha == head:\n        return r | {\"trang_thai\": \"passed\", \"doi_chieu\": \"sha_bang_head_sha\"}\n    if event == \"pull_request\":\n        if not obj:\n            return r | {\"trang_thai\": \"not_measured\", \"ly_do\": \"khong_co_object_de_doi_chieu_parents\"}\n        if head in obj[\"parents\"]:\n            return r | {\"trang_thai\": \"passed\", \"doi_chieu\": \"head_sha_trong_parents_merge_tong_hop\"}\n    return r | {\"trang_thai\": \"failed\", \"ly_do\": f\"sha_checkout_lech_head_sha ({event})\"}\n\ndef tach_buoc(dong):\n    \"\"\"[{lenh, gio, in_lai, hop_le, phan}]: nhóm = từ `##[group]Run <lệnh>` tới trước `##[group]Run` kế; `gio` = timestamp header.\n    `gio` cắt về giây. `in_lai` = dòng `36;1m` LIỀN sau header, bỏ ANSI — CHỈ để đối chiếu, KHÔNG làm kịch bản (M10). `hop_le` = cấu trúc đo trên 226/226\n    nhóm thật (màu đầu = header, kế khối màu là `shell: `, không màu sau đó, có `##[endgroup]`, r4: không `##[group]` lồng trong vùng\n    nhóm đang mở). `phan` = sau `##[endgroup]`, nơi duy nhất đo marker.\"\"\"\n    buoc = []\n    for d in dong:\n        t = than(d)\n        if t.startswith(\"##[group]Run \"):\n            buoc.append({\"lenh\": t[len(\"##[group]Run \"):], \"in_lai\": [], \"phan\": [], \"mo\": True, \"ok\": True, \"tien_to\": True,\n                         \"gio\": d[:19] + \"Z\"})\n        elif buoc and (b := buoc[-1])[\"mo\"]:\n            mau = \"\\x1b[36;1m\" in d\n            if t == \"##[endgroup]\":   # nguyên văn: 753/753 dòng đóng trên 37 log thật (đo 25-10-2026)\n                b[\"mo\"] = False\n            elif mau and b[\"tien_to\"]:\n                b[\"in_lai\"].append(t)\n            else:\n                b[\"ok\"], b[\"tien_to\"] = b[\"ok\"] and not mau and not t.startswith(\"##[group]\") and (  # r4 Q6: nhóm lồng ⇒ hỏng\n                    not b[\"tien_to\"] or t.startswith(\"shell: \")), False\n        elif buoc:\n            buoc[-1][\"phan\"].append(t)\n    return [b | {\"hop_le\": not b[\"mo\"] and b[\"ok\"] and not b[\"tien_to\"] and b[\"in_lai\"][:1] == [b[\"lenh\"]]} for b in buoc]\n\ndef dong_logic(lenh):\n    \"\"\"Nối dòng kết thúc bằng `\\\\` thành MỘT dòng logic — một đối số nằm ở dòng nối không thành lệnh riêng.\"\"\"\n    ra, noi = [], \"\"\n    for d in lenh:\n        noi += d[:-1] + \" \" if d.endswith(\"\\\\\") else d\n        if not d.endswith(\"\\\\\"):\n            ra.append(noi.strip())\n            noi = \"\"\n    return ra + ([noi.strip()] if noi else [])\n\ndef do_dau_duong(buoc, moi, xanh, wf, ghep):\n    \"\"\"(kết quả, số bước XÁC THỰC). Nhóm i chỉ xét qua bước YAML `ghep` ĐỊNH DANH cho nó (r4): `run:` là chuỗi, KHÔNG `uses:` (Q8),\n    khối in lại hợp lệ BẰNG NGUYÊN VĂN `run:` của CHÍNH bước ấy, TOÀN KHỐI là lời gọi tối giản. `chan_buoc` hoặc `VAR=` ⇒ lời gọi\n    `MOI` ra `not_measured` (`che_do_khong_xac_dinh`); còn lại áp ĐÚNG regex `MOI` lên phần log của CHÍNH nhóm ấy.\"\"\"\n    kq, so = [], 0\n    for b, (k, i) in zip(buoc, ghep or []):\n        s = wf[\"jobs\"][k][\"steps\"][i]\n        run = s.get(\"run\") if \"uses\" not in s else None\n        if not (type(run) is str and b[\"hop_le\"] and run.rstrip(\"\\n\") == \"\\n\".join(b[\"in_lai\"])):\n            continue\n        so += 1\n        goi = [RE_LOI_GOI.fullmatch(d) for d in dong_logic(run.rstrip(\"\\n\").split(\"\\n\")) if d]\n        chan = chan_buoc(wf, k, i) or any(g and g[1] for g in goi)\n        for duong in dict.fromkeys([g[2] for g in goi] if goi and all(goi) else []):\n            muc = {\"lenh\": b[\"lenh\"], \"duong_dan\": duong}\n            if duong not in moi or chan:\n                kq.append(muc | {\"trang_thai\": \"not_measured\", \"ly_do\": \"khong_co_trong_MOI\" if duong not in moi else \"che_do_khong_xac_dinh\"})\n            else:\n                van = \"\\n\".join(b[\"phan\"]) + \"\\n\"\n                k = re.search(moi[duong], van, re.M) if (ok := xanh(van, moi[duong])) else None\n                kq.append(muc | {\"trang_thai\": \"passed\" if ok else \"failed\", \"dong_khop\": k.group(0).splitlines() if k else []})\n    return kq, so\n\ndef moc_gate(job, dong, moi, xanh, wf=None, ly_do_wf=\"\"):\n    hop = {k: hop_le(job.get(k)) for k, hop_le in JOB_BAT_BUOC.items()}   # chiếu CHỈ trường đã hợp lệ: không ném với kiểu lạ\n    r = {\"job_id\": job[\"id\"], \"name\": job.get(\"name\"), \"check_run_id\": job[\"check_run_url\"].rsplit(\"/\", 1)[-1] if hop[\"check_run_url\"]\n         else None, \"labels\": job.get(\"labels\"), \"runner_id\": job.get(\"runner_id\"), \"runner_name\": job.get(\"runner_name\"),\n         \"conclusion\": job.get(\"conclusion\"),\n         \"buoc\": [{\"name\": s[\"name\"], \"conclusion\": s[\"conclusion\"]} for s in job[\"steps\"]] if hop[\"steps\"] else \"not_measured\"}\n    if job.get(\"conclusion\") == \"skipped\":\n        return r | {\"trang_thai\": \"skipped\"}\n    if job.get(\"runner_id\") == 0:\n        return r | {\"trang_thai\": \"not_run\"}\n    anh = [than(d)[len(\"Image: \"):] for d in dong if than(d).startswith(\"Image: \")]\n    gh, ghep = ghep_buoc(job, buoc := tach_buoc(dong), wf, ly_do_wf)\n    dau, so = do_dau_duong(buoc, moi, xanh, wf, ghep)\n    thieu = [k for k, ok in hop.items() if not ok]\n    r |= {\"image\": anh[0] if anh else \"not_measured\", \"dau_duong\": dau, \"thieu\": thieu, \"ghep_buoc\": gh, \"kich_ban\": {\"buoc_xac_thuc\": so} | (\n        {\"trang_thai\": \"not_measured\", \"ly_do\": ly_do_wf} if wf is None else {\"trang_thai\": \"passed\", \"nguon\": \"run_tai_sha_checkout\"})}\n    tt = {x[\"trang_thai\"] for x in dau}\n    if job.get(\"conclusion\") in LOI_JOB or \"failed\" in tt:\n        return r | {\"trang_thai\": \"failed\"}\n    return r | {\"trang_thai\": \"not_measured\" if thieu or \"passed\" not in tt else \"passed\"}\n\ndef thu(repo, run, attempt, goi, git, moi_tu=CI_DANG_KY, wf=git_blob):\n    goc = f\"{API}/repos/{repo}/actions\"\n    r, byte_run = lay_json(goi, f\"{goc}/runs/{run}\")\n    if type(r) is not dict:\n        raise LoiRest(f\"than_sai_dang (run là {type(r).__name__})\", f\"{goc}/runs/{run}\")\n    jobs = lay_trang(goi, f\"{goc}/runs/{run}/attempts/{attempt}/jobs\", \"jobs\")\n    arts = lay_trang(goi, f\"{goc}/runs/{run}/artifacts\", \"artifacts\")\n    moi, xanh = doc_moi(moi_tu)\n    moc_run = {\"repo\": repo, \"run_id\": r.get(\"id\"), \"run_attempt\": r.get(\"run_attempt\"), \"event\": r.get(\"event\"), \"head_sha\":\n               r.get(\"head_sha\"), \"loi_khai_rest_path\": r.get(\"path\"), \"check_suite_id\": r.get(\"check_suite_id\"), \"nguon\": f\"{goc}/runs/{run}\"}\n    thieu = [k for k, hop_le in RUN_BAT_BUOC.items() if not hop_le(r.get(k))]\n    lech = [k for k, v in ((\"id\", run), (\"run_attempt\", attempt)) if k not in thieu and r.get(k) != v]\n    moc_run |= {\"thieu\": thieu, \"lech\": lech, \"trang_thai\": \"failed\" if lech else \"not_measured\" if thieu else \"passed\"}\n    tep = {\"run.json\": byte_run, \"jobs.json\": json.dumps(jobs, ensure_ascii=False, indent=1).encode()}\n    co, gate, log = [], [], {}\n    for j in jobs[\"jobs\"]:\n        if j.get(\"conclusion\") == \"skipped\" or j.get(\"runner_id\") == 0:\n            co.append({\"job_id\": j[\"id\"], \"name\": j.get(\"name\"), \"trang_thai\": \"skipped\" if j.get(\"conclusion\") == \"skipped\" else \"not_run\"})\n            gate.append(moc_gate(j, [], moi, xanh))\n            continue\n        byte = lay(goi, f\"{goc}/jobs/{j['id']}/logs\")\n        dong = byte.decode(\"utf-8\", \"replace\").splitlines()\n        co.append({\"job_id\": j[\"id\"], \"name\": j.get(\"name\")} | moc_checkout(doc_sha_checkout(dong), r.get(\"event\"), r.get(\"head_sha\"), git))\n        sha = co[-1].get(\"sha\") if co[-1][\"trang_thai\"] == \"passed\" else None   # CHỈ SHA checkout đã đo, không `head_sha`\n        van = wf(sha, r[\"path\"]) if sha and RUN_BAT_BUOC[\"path\"](r.get(\"path\")) else None\n        g = moc_gate(j, dong, moi, xanh, doc_wf(van) if van is not None else None,\n                     \"sha_checkout_chua_do\" if not sha else \"workflow_tai_sha_khong_doc_duoc\")\n        gate.append(g)\n        khop = {k for x in g.get(\"dau_duong\", []) for k in x.get(\"dong_khop\", [])}\n        trich = [d for i, d in enumerate(dong) if than(d).startswith((\"##[group]Run \", \"Image: \")) or than(d) in khop\n                 or RE_SHA.match(d) or (i + 1 < len(dong) and RE_SHA.match(dong[i + 1]))]\n        tep[f\"jobs/{j['id']}.trich.txt\"] = (\"\\n\".join(trich) + \"\\n\").encode()\n        log[j[\"id\"]] = {\"sha256\": hashlib.sha256(byte).hexdigest(), \"bytes\": len(byte), \"trich\": f\"jobs/{j['id']}.trich.txt\"}\n    prov = {\"schema\": \"ci_provenance/1\", \"cong_cu\": \"ops/ci_provenance.py\", \"nguon\": \"REST\", \"attempt_yeu_cau\": attempt,\n            \"moc\": {\"run\": moc_run, \"checkout\": co,\n                    \"gate_output\": {\"jobs\": gate, \"tap_jobs\": tap(jobs, \"jobs\"), \"tap_artifacts\": tap(arts, \"artifacts\", ART_BAT_BUOC), \"artifacts\": [\n                        {k: a.get(k) for k in (\"id\", \"name\", \"digest\", \"size_in_bytes\", \"expired\")} for a in arts[\"artifacts\"]]},\n                    \"workflow_definition\": {\"trang_thai\": \"not_measured\", \"ly_do\": LY_DO_WD, \"loi_khai_rest_path\": r.get(\"path\")}},\n            \"log_day_du\": log}\n    tep[\"provenance.yaml\"] = yaml.safe_dump(prov, sort_keys=False, allow_unicode=True).encode()\n    return prov, tep\n\ndef ghi_tep(p, byte):\n    p.parent.mkdir(parents=True, exist_ok=True)\n    p.write_bytes(byte)\n\ndef ghi_nguyen_tu(out, tep):\n    \"\"\"Ghi vào thư mục tạm CÙNG CẤP rồi `os.replace`: lỗi giữa chừng ⇒ `out` vắng hoặc giữ nguyên bản trước.\"\"\"\n    out = Path(out).resolve()\n    out.parent.mkdir(parents=True, exist_ok=True)\n    tam = Path(tempfile.mkdtemp(prefix=f\".{out.name}.tam-\", dir=out.parent))\n    cu = out.parent / f\"{tam.name}.cu\"\n    try:\n        for ten, byte in tep.items():\n            ghi_tep(tam / ten, byte)\n        if out.exists():\n            os.replace(out, cu)\n        os.replace(tam, out)\n    except BaseException:\n        if cu.exists() and not out.exists():\n            os.replace(cu, out)\n        shutil.rmtree(tam, ignore_errors=True)\n        raise\n    shutil.rmtree(cu, ignore_errors=True)\n\ndef cac_trang_thai(prov):\n    m = prov[\"moc\"]\n    g = m[\"gate_output\"]\n    return ([m[\"run\"][\"trang_thai\"], m[\"workflow_definition\"][\"trang_thai\"], g[\"tap_jobs\"][\"trang_thai\"],\n             g[\"tap_artifacts\"][\"trang_thai\"]] + [x[\"trang_thai\"] for x in m[\"checkout\"]] + [x[\"trang_thai\"] for x in g[\"jobs\"]])\n\ndef main(argv=None, goi=goi_that, git=git_cuc_bo, moi_tu=CI_DANG_KY, wf=git_blob):\n    p = argparse.ArgumentParser(prog=\"ci_provenance.py\", description=__doc__.split(\"\\n\")[0])\n    sub = p.add_subparsers(dest=\"lenh\", required=True)\n    t = sub.add_parser(\"thu\", help=\"thu provenance của MỘT run/attempt bằng REST\")\n    t.add_argument(\"--repo\", required=True, help=\"owner/repo\")\n    t.add_argument(\"--run\", required=True, type=int, help=\"id workflow run\")\n    t.add_argument(\"--attempt\", required=True, type=int, help=\"run_attempt phải đo\")\n    t.add_argument(\"--out\", required=True, help=\"thư mục đầu ra (ghi nguyên tử)\")\n    try:\n        a = p.parse_args(argv)\n    except SystemExit as e:\n        if e.code == 0:\n            return 0\n        print(KHONG_SINH)\n        return 2\n    if not RE_REPO.fullmatch(a.repo) or a.run <= 0 or a.attempt <= 0:\n        print(f\"SAI_DOI_SO: --repo owner/repo, --run/--attempt nguyên dương (được {a.repo!r} {a.run} {a.attempt})\\n{KHONG_SINH}\")\n        return 2\n    try:\n        prov, tep = thu(a.repo, a.run, a.attempt, goi, git, moi_tu, wf)\n    except LoiRest as e:\n        print(f\"REST_LOI: HTTP {e.ma} {e.url}\\n{KHONG_SINH}\")\n        return 3\n    except Exception:   # lưới cuối M7: lỗi thu ngoài hợp đồng vẫn in dòng đếm, rồi NỔI LÊN (không nuốt, không bịa rc)\n        print(KHONG_SINH)\n        raise\n    try:\n        ghi_nguyen_tu(a.out, tep)\n    except OSError as e:   # không có provenance ⇒ vẫn in dòng đếm, rồi để lỗi I/O nổi lên (rc 1, không bịa mã mới)\n        print(f\"LOI_GHI: {e}\\n{KHONG_SINH}\")\n        raise\n    m = prov[\"moc\"]\n    print(f\"RUN: {m['run']['trang_thai']} (run_attempt {m['run']['run_attempt']}, yeu cau {a.attempt})\")\n    for c, g in zip(m[\"checkout\"], m[\"gate_output\"][\"jobs\"]):\n        print(f\"JOB {c['job_id']} {c['name']}: checkout={c['trang_thai']} {c.get('sha', '-')} gate={g['trang_thai']}\")\n    print(f\"WORKFLOW_DEFINITION: {m['workflow_definition']['trang_thai']} ({LY_DO_WD})\")\n    tt = cac_trang_thai(prov)\n    print(f\"provenance.yaml sha256 {hashlib.sha256(tep['provenance.yaml']).hexdigest()}\")\n    print(f\"NOT_MEASURED: {tt.count('not_measured')}\")\n    return 12 if \"failed\" in tt else 0\n\nif __name__ == \"__main__\":\n    raise SystemExit(main(sys.argv[1:]))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '1370,1582p' ops/ci_provenance_test.py && git diff 9b329bf HEAD -- ops/ci_provenance.py && sed -n '195,230p' .review-input/wp899-r2.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '1370,1582p' ops/ci_provenance_test.py && git diff 9b329bf HEAD -- ops/ci_provenance.py && sed -n '195,230p' .review-input/wp899-r2.md\"","aggregated_output":"TU_KIEM = (   # (tên, gốc, thay, ca đích, hạng mong đợi)\n    (\"vo_can_AttributeError_qua_except_doi_kieu\", \"def than(dong):\\n\",\n     \"def than(dong):\\n    try:\\n        raise AttributeError('vo can')\\n    except Exception as e:\\n\"\n     \"        raise AssertionError(f'doi kieu {type(e).__name__}')\\n\", \"c03\", \"TIN_DUNG_GIA\"),\n    (\"chi_them_chu_thich\", \"TRANG = 100\\n\", \"TRANG = 100  # vo hai\\n\", \"c20\", \"SONG_SOT\"),\n)\n\ndef chay_con(ten_ca, ma):\n    r = subprocess.run([sys.executable, \"-B\", str(HERE / \"ci_provenance_test.py\"), \"--mot-ca\", ten_ca], capture_output=True,\n                       env=dict(os.environ, CI_PROVENANCE_MA=str(ma), PYTHONDONTWRITEBYTECODE=\"1\"), timeout=300)\n    return r.returncode, (r.stdout + r.stderr).decode(\"utf-8\", \"replace\")\n\ndef phan_hang(rc, ra, ten_ca):\n    if rc == 0:\n        return \"SONG_SOT\"\n    if rc == 3:\n        return \"GIET\" if f\"DO:{ten_ca}:\" in ra else \"TIN_DUNG_GIA\"\n    return \"TIN_DUNG_GIA\" if rc == 4 else \"HONG\"\n\ndef chay_dot_bien(ten, cu, moi, tien_to):\n    khop = [c for c in CA if c.split(\"_\")[0] == tien_to]\n    if len(khop) != 1:\n        return \"HONG\", f\"tiền tố ca đích {tien_to!r} phải khớp ĐÚNG MỘT ca, khớp {khop}\"\n    ten_ca = khop[0]\n    goc = (HERE / \"ci_provenance.py\").read_text(encoding=\"utf-8\")\n    if goc.count(cu) != 1 or cu == moi:\n        return \"HONG\", f\"neo phải xuất hiện đúng 1 lần và đột biến phải đổi mã (thấy {goc.count(cu)})\"\n    with tempfile.TemporaryDirectory(prefix=\"cip_db_\") as thu:\n        ban_goc, ban_db = Path(thu) / \"goc.py\", Path(thu) / f\"db_{ten}.py\"\n        ban_goc.write_text(goc, encoding=\"utf-8\")\n        ban_db.write_text(goc.replace(cu, moi), encoding=\"utf-8\")\n        rc, ra = chay_con(ten_ca, ban_goc)\n        if rc != 0:\n            return \"HONG\", f\"ca đích không xanh trên bản gốc (rc={rc}): {ra[-200:]}\"\n        rc, ra = chay_con(ten_ca, ban_db)\n        return phan_hang(rc, ra, ten_ca), ra.strip()[-200:]\n\ndef chay_ca(ten):\n    \"\"\"(rc, dòng): 0 đạt · 3 `DO:<ca>:` (chỉ `TinHieuChotCa`) · 4 lỗi vô can — KHÔNG đổi lỗi vô can thành tín hiệu chốt.\"\"\"\n    try:\n        CA[ten]()\n    except TinHieuChotCa as e:\n        return 3, f\"DO:{ten}:{e}\"\n    except Exception as e:\n        return 4, f\"HONG:{ten}:{type(e).__name__}: {e}\"\n    return 0, \"\"\n\nHAM_DONG = (\"_env_chan\", \"doc_wf\", \"ghep_job\", \"ten_du_kien\", \"_gio\", \"ghep_buoc\", \"chan_buoc\", \"tach_buoc\", \"do_dau_duong\")\nDOI_SO_SANH = {ast.Eq: [ast.NotEq], ast.NotEq: [ast.Eq], ast.Lt: [ast.LtE, ast.Gt], ast.LtE: [ast.Lt, ast.GtE], ast.Gt: [ast.GtE, ast.Lt],\n               ast.GtE: [ast.Gt, ast.LtE], ast.In: [ast.NotIn], ast.NotIn: [ast.In], ast.Is: [ast.IsNot], ast.IsNot: [ast.Is]}\nTUONG_DUONG = {   # mã đột biến tập đóng → chứng minh vì sao KHÔNG đầu vào nào phân biệt được (bị giết ⇒ lời khai SAI ⇒ ĐỎ)\n    \"ghep_job#24:-1\": \"`khop[-1]` thay `khop[0]` chỉ được tính khi `len(khop) == 1`, mà danh sách một phần tử có [0] và [-1] là cùng một phần tử\",\n    \"chan_buoc#103:bo_doi_so1\": \"`str(t.get('run'))` thay `str(t.get('run', ''))` chỉ khác ở bước KHÔNG có `run:`: chuỗi tìm là 'None' thay vì '' — \"\n                                \"cả hai đều không chứa `GITHUB_ENV`/`GITHUB_PATH`, nên `re.search` cùng trả None\",\n    **{f\"tach_buoc#173:chuoi{k}\": \"chuỗi chỉ đứng trong `len('##[group]Run ')`: biến dạng hoa/thường/đảo hoa giữ NGUYÊN độ dài 13 nên lát \"\n       \"cắt `lenh` không đổi (biến dạng đổi độ dài — hậu tố, bớt ký tự, khoảng trắng, rỗng — bị giết)\" for k in (2, 3, 4)},\n    \"do_dau_duong#127:bo_ve0\": \"bỏ vế `goi and`: khi `goi` rỗng thì `all(goi)` là True nhưng `[g[2] for g in goi]` cũng rỗng ⇒ vòng lặp \"\n                               \"không chạy lần nào, y như nhánh `else []`\",\n    **{f\"do_dau_duong#306:chuoi{k}\": \"`run.rstrip('')` (cả hai mã cùng một nguồn đột biến) chỉ để lại các `\\\\n` cuối ⇒ `split` sinh thêm \"\n       \"đoạn RỖNG ở đuôi; `dong_logic` biến đoạn rỗng thành '' (hoặc nối vào dòng `\\\\` đang dở rồi `strip()` ra cùng chuỗi), và \"\n       \"`if d` bỏ ''. Phép so khối `run.rstrip(\\\"\\\\n\\\") == …` đứng TRƯỚC không đổi\" for k in (1, 4)},\n}\n\ndef _thay(x, y):   # đổi nút x thành nút y tại chỗ\n    x.__class__ = y.__class__\n    x.__dict__.clear()\n    x.__dict__.update(y.__dict__)\n\ndef _toan_tu(n):   # bảng toán tử CỐ ĐỊNH của tập đóng: (tên, hàm sửa nút tại chỗ trên bản sao)\n    if isinstance(n, ast.Compare):\n        for k, op in enumerate(n.ops):\n            for moi in DOI_SO_SANH.get(type(op), []):\n                yield f\"so{k}->{moi.__name__}\", lambda x, k=k, moi=moi: x.ops.__setitem__(k, moi())\n    elif isinstance(n, ast.BoolOp):\n        yield \"and<->or\", lambda x: setattr(x, \"op\", ast.Or() if isinstance(x.op, ast.And) else ast.And())\n        for k in range(len(n.values)):\n            yield f\"bo_ve{k}\", lambda x, k=k: x.values.pop(k) if len(x.values) > 2 else _thay(x, x.values[1 - k])\n    elif isinstance(n, ast.UnaryOp) and isinstance(n.op, ast.Not):\n        yield \"bo_not\", lambda x: _thay(x, x.operand)\n    elif isinstance(n, ast.Constant) and type(n.value) is bool:\n        yield \"bool\", lambda x: setattr(x, \"value\", not x.value)\n    elif isinstance(n, ast.Constant) and type(n.value) is int:\n        yield \"+1\", lambda x: setattr(x, \"value\", x.value + 1)\n        yield \"-1\", lambda x: setattr(x, \"value\", x.value - 1)\n    elif isinstance(n, ast.Constant) and type(n.value) is str and n.value:\n        for k, w in enumerate(bien_dang(n.value) + [\"\"]):\n            yield f\"chuoi{k}\", lambda x, w=w: setattr(x, \"value\", w)\n    elif isinstance(n, ast.IfExp):\n        yield \"ifexp_than\", lambda x: _thay(x, x.body)\n        yield \"ifexp_khac\", lambda x: _thay(x, x.orelse)\n    elif isinstance(n, ast.If):\n        yield \"if_dung\", lambda x: setattr(x, \"test\", ast.Constant(True))\n        yield \"if_sai\", lambda x: setattr(x, \"test\", ast.Constant(False))\n    elif isinstance(n, ast.comprehension):\n        for k in range(len(n.ifs)):\n            yield f\"bo_loc{k}\", lambda x, k=k: x.ifs.pop(k)\n    elif isinstance(n, ast.Call) and len(n.args) > 1:\n        for k in range(len(n.args)):\n            yield f\"bo_doi_so{k}\", lambda x, k=k: x.args.pop(k)\n    elif isinstance(n, ast.Return) and n.value is not None:\n        yield \"tra_None\", lambda x: setattr(x, \"value\", ast.Constant(None))\n\ndef sinh_dot_bien_dong(src):\n    \"\"\"TẬP ĐÓNG (quyết định chủ kho #899 sau lượt 7): MỌI đột biến bậc một của MỌI nút trong `HAM_DONG` theo `_toan_tu`, trừ\n    docstring. Trả [(mã, nguồn)]; mã = `<hàm>#<thứ tự nút trong ast.walk>:<toán tử>` — ổn định khi mã NGOÀI hàm đổi.\"\"\"\n    goc, ra = ast.parse(src), {}\n    for ham in [n for n in goc.body if isinstance(n, ast.FunctionDef) and n.name in HAM_DONG]:\n        doc = {id(x.value) for x in ast.walk(ham) if isinstance(x, ast.Expr) and isinstance(x.value, ast.Constant)}\n        for j, n in enumerate(list(ast.walk(ham))[1:]):\n            if id(n) in doc:\n                continue\n            for ten, sua in _toan_tu(n):\n                cay = ast.parse(src)\n                dich = list(ast.walk(next(h for h in cay.body if isinstance(h, ast.FunctionDef) and h.name == ham.name)))[1:][j]\n                sua(dich)\n                try:\n                    moi = ast.unparse(ast.fix_missing_locations(cay))\n                    compile(moi, \"<db>\", \"exec\")\n                except (SyntaxError, ValueError, TypeError, IndexError):\n                    continue\n                if moi != ast.unparse(goc):\n                    ra[f\"{ham.name}#{j}:{ten}\"] = moi\n    return list(ra.items())\n\ndef _tat_ca_ca(ma):   # chạy MỌI ca trên bản `ma` trong một tiến trình con: [(ca, rc, dòng)]\n    r = subprocess.run([sys.executable, \"-B\", str(HERE / \"ci_provenance_test.py\"), \"--tat-ca-ca\"], capture_output=True, timeout=1800,\n                       env=dict(os.environ, CI_PROVENANCE_MA=str(ma), PYTHONDONTWRITEBYTECODE=\"1\"))\n    try:\n        return json.loads(r.stdout.decode(\"utf-8\", \"replace\").strip().splitlines()[-1])\n    except (ValueError, IndexError):\n        return [(\"nap\", 4, r.stderr.decode(\"utf-8\", \"replace\")[-300:])]\n\ndef chay_dot_bien_dong(song_song):\n    \"\"\"Hạng mỗi đột biến: GIET (≥ 1 ca chết bởi `TinHieuChotCa` của CHÍNH nó) · SONG · TIN_DUNG_GIA (chỉ chết vì lỗi vô can).\n    Đạt ⇔ 0 SONG ngoài `TUONG_DUONG`, 0 TIN_DUNG_GIA, và KHÔNG mục `TUONG_DUONG` nào bị giết (giết ⇒ chứng minh sai).\"\"\"\n    from concurrent.futures import ThreadPoolExecutor\n    goc = (HERE / \"ci_provenance.py\").read_text(encoding=\"utf-8\")\n    dsach = sinh_dot_bien_dong(goc)\n    with tempfile.TemporaryDirectory(prefix=\"cip_dong_\") as thu:\n        nen = Path(thu) / \"goc.py\"\n        nen.write_text(goc, encoding=\"utf-8\")\n        bad = [x for x in _tat_ca_ca(nen) if x[1] != 0]\n        if bad:\n            print(f\"DOT BIEN DONG: KHONG DO DUOC — ca khong xanh tren ban goc: {bad[:2]}\")\n            return 1\n        def mot(m):\n            ma, src = m\n            p = Path(thu) / f\"db_{len(ma)}_{abs(hash(ma))}.py\"\n            p.write_text(src, encoding=\"utf-8\")\n            kq = _tat_ca_ca(p)\n            giet = [c for c, rc, d in kq if rc == 3 and d.startswith(f\"DO:{c}:\")]\n            return ma, \"GIET\" if giet else \"TIN_DUNG_GIA\" if any(rc for _, rc, _ in kq) else \"SONG\", giet[:2]\n        tiep = {}   # `CIP_DONG_TIEP=<tệp stdout lượt trước>`: dùng lại hạng đã đo cho CÙNG mã + CÙNG băm nguồn đột biến\n        for d in Path(os.environ[\"CIP_DONG_TIEP\"]).read_text(encoding=\"utf-8\").splitlines() if os.environ.get(\"CIP_DONG_TIEP\") else []:\n            if d.startswith(\"[KQ] \"):\n                ma, bam, h = d[5:].rsplit(\" \", 2)\n                tiep[(ma, bam)] = h\n        def mot_co_ghi(m):\n            bam = hashlib.sha256(m[1].encode()).hexdigest()[:16]\n            r = (m[0], tiep[(m[0], bam)], []) if (m[0], bam) in tiep else mot(m)\n            print(f\"[KQ] {r[0]} {bam} {r[1]}\", flush=True)\n            return r\n        with ThreadPoolExecutor(song_song) as ex:\n            kq = list(ex.map(mot_co_ghi, dsach))\n    hang = collections.Counter(h for _, h, _ in kq)\n    song = [ma for ma, h, _ in kq if h == \"SONG\" and ma not in TUONG_DUONG]\n    tdg = [ma for ma, h, _ in kq if h == \"TIN_DUNG_GIA\"]\n    sai_td = [ma for ma, h, _ in kq if h == \"GIET\" and ma in TUONG_DUONG] + [ma for ma in TUONG_DUONG if ma not in dict((m, 1) for m, _ in dsach)]\n    for ma in song + tdg + sai_td:\n        print(f\"[DOT BIEN DONG] {ma}: {dict((m, h) for m, h, _ in kq).get(ma, 'KHONG_CON_TRONG_TAP')}\")\n    print(f\"DOT BIEN DONG: {hang['GIET']}/{len(kq)} giet · {len(TUONG_DUONG)} tuong duong co chung minh · {len(song)} song · {len(tdg)} tin dung gia\"\n          f\" · {len(sai_td)} chung minh tuong duong sai\")\n    ok = len(kq) > 0 and not song and not tdg and not sai_td\n    print(f\"TONG DONG: {'DAT' if ok else 'DO'}\")\n    return 0 if ok else 1\n\ndef main(argv):\n    if len(argv) == 2 and argv[0] == \"--mot-ca\" and argv[1] in CA:\n        rc, dong = chay_ca(argv[1])\n        print(dong)\n        return rc\n    if argv == [\"--tat-ca-ca\"]:   # ca nhẹ trước, ca bảng/oracle sau; dừng ở ca ĐẦU TIÊN chết bởi `TinHieuChotCa` (đã đủ để xếp GIET)\n        kq = []\n        for c in sorted(CA, key=lambda c: c.split(\"_\")[0] in (\"c22\", \"c46\", \"c48\", \"c49\")):\n            kq.append((c, *chay_ca(c)))\n            if kq[-1][1] == 3:\n                break\n        print(json.dumps(kq, ensure_ascii=False))\n        return 0\n    if argv[:1] == [\"--dot-bien-dong\"] and len(argv) <= 2:\n        return chay_dot_bien_dong(int(argv[1]) if len(argv) == 2 else 8)\n    if argv:\n        print(\"dung: ci_provenance_test.py [--mot-ca TEN | --dot-bien-dong [SONG_SONG]]\", file=sys.stderr)\n        return 2\n    kq = [chay_ca(ten) for ten in CA]\n    print(\"\".join(f\"[{dong}]\\n\" for rc, dong in kq if rc), end=\"\")\n    dat = sum(rc == 0 for rc, _ in kq)\n    print(f\"CA: {dat}/{len(CA)} dat\")\n    xau = [f\"{ten}: {h} {ct}\" for ten, cu, moi, dich in DOT_BIEN for h, ct in [chay_dot_bien(ten, cu, moi, dich)] if h != \"GIET\"]\n    for x in xau:\n        print(f\"[DOT BIEN KHONG BI GIET DUNG] {x}\")\n    print(f\"DOT BIEN: {len(DOT_BIEN) - len(xau)}/{len(DOT_BIEN)} bi giet dung ly do\")\n    loi_tk = [f\"{ten}: mong {mong}, duoc {h}\" for ten, cu, moi, dich, mong in TU_KIEM\n              for h in [chay_dot_bien(ten, cu, moi, dich)[0]] if h != mong]\n    for x in loi_tk:\n        print(f\"[TU KIEM] {x}\")\n    print(f\"TU KIEM PHAN HANG: {'DAT' if not loi_tk else 'DO'} ({len(TU_KIEM)} dot bien)\")\n    ok = dat == len(CA) > 0 and len(DOT_BIEN) > 0 and not xau and not loi_tk\n    print(f\"TONG: {'DAT' if ok else 'DO'}\")\n    return 0 if ok else 1\n\nif __name__ == \"__main__\":\n    raise SystemExit(main(sys.argv[1:]))\ndiff --git a/ops/ci_provenance.py b/ops/ci_provenance.py\nindex d750397..117a362 100644\n--- a/ops/ci_provenance.py\n+++ b/ops/ci_provenance.py\n@@ -24,10 +24,10 @@ CI_DANG_KY = ROOT / \".claude/dev/ci_dang_ky_test.py\"\n API = \"https://api.github.com\"\n TRANG = 100\n TRANG_TOI_DA = 1000\n-TS = r\"\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z\"\n+TS = r\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z\"   # ASCII: `\\d` khớp cả chữ số Unicode\n RE_DONG = re.compile(rf\"^({TS}) ?(.*)$\")\n RE_SHA = re.compile(rf\"^{TS} ([0-9a-f]{{40}})$\")\n-RE_GIO = re.compile(r\"\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ\")\n+RE_GIO = re.compile(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\")\n RE_ANSI = re.compile(r\"\\x1b\\[[0-9;]*m\")\n RE_HEX40 = re.compile(r\"^[0-9a-f]{40}$\")\n RE_REPO = re.compile(r\"^[\\w.-]+/[\\w.-]+$\")\n","exit_code":0,"status":"completed"}}
