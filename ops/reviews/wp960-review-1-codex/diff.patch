+def _cac_cau(van: str):
+    """Câu của MỘT scalar. Gộp khoảng trắng TRƯỚC khi tách: cụm từ gãy qua dòng vẫn là một câu."""
+    return [c for c in _RE_CAU.split(" ".join(van.split())) if c]
+
