+def _commit_them_cau(root: Path, rel: str, cau: str):
+    """Commit ĐẦU TIÊN trong lịch sử tệp có chứa câu `cau` (đã chuẩn hoá). `None` = KHÔNG ĐO ĐƯỢC.
