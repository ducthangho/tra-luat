{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "bien_nhan_audit.v1",
 "title": "bien_nhan_audit.v1 (wp1460 B1a r7)",
 "oneOf": [{"$ref": "#/$defs/bien_nhan_xanh"}, {"$ref": "#/$defs/bien_nhan_khong_xanh"}],
 "$defs": {
  "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])"},
  "sha64": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
  "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"},
  "moc_rest": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"},
  "moc_ms": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])"},
  "cap": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*(?![\\s\\S])"},
  "kho": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?![\\s\\S])"},
  "chuoi": {"type": "string", "minLength": 1},
  "so_duong": {"type": "integer", "minimum": 1},
  "ds_ten": {"type": "array", "items": {"$ref": "#/$defs/chuoi"}, "minItems": 2, "uniqueItems": true},
  "ten_schema": {"const": "bien_nhan_audit.v1"},
  "workflow": {"type": "object", "additionalProperties": false, "required": ["duong_dan", "workflow_ref"], "properties": {"duong_dan": {"const": ".github/workflows/ci-dot-bien-du.yml"}, "workflow_ref": {"$ref": "#/$defs/chuoi"}}},
  "luot": {"type": "object", "additionalProperties": false, "required": ["run_attempt", "run_id"], "properties": {"run_id": {"$ref": "#/$defs/so_duong"}, "run_attempt": {"$ref": "#/$defs/so_duong"}}},
  "cong_cu": {"type": "object", "additionalProperties": false, "required": ["duong_dan", "sha256"], "properties": {"duong_dan": {"$ref": "#/$defs/chuoi"}, "sha256": {"$ref": "#/$defs/sha64"}}},
  "artifact": {"type": "object", "additionalProperties": false, "required": ["digest", "id", "sha256_noi_dung", "ten"], "properties": {"id": {"$ref": "#/$defs/so_duong"}, "ten": {"$ref": "#/$defs/chuoi"}, "digest": {"$ref": "#/$defs/digest"}, "sha256_noi_dung": {"$ref": "#/$defs/sha64"}}},
  "su_kien_schedule": {"type": "object", "additionalProperties": false, "required": ["cron", "khung_danh_nghia_utc", "ref", "run_created_at", "sha", "ten"], "properties": {"ten": {"const": "schedule"}, "sha": {"$ref": "#/$defs/sha40"}, "ref": {"$ref": "#/$defs/chuoi"}, "cron": {"$ref": "#/$defs/chuoi"}, "khung_danh_nghia_utc": {"$ref": "#/$defs/moc_rest"}, "run_created_at": {"$ref": "#/$defs/moc_rest"}}},
  "su_kien_dispatch": {"type": "object", "additionalProperties": false, "required": ["ref", "run_created_at", "sha", "ten"], "properties": {"ten": {"const": "workflow_dispatch"}, "sha": {"$ref": "#/$defs/sha40"}, "ref": {"$ref": "#/$defs/chuoi"}, "run_created_at": {"$ref": "#/$defs/moc_rest"}}},
  "su_kien_khong_xanh": {"type": "object", "additionalProperties": false, "required": ["cron", "khung_danh_nghia_utc", "ref", "run_created_at", "sha", "ten"], "properties": {"ten": {"$ref": "#/$defs/chuoi"}, "sha": {"$ref": "#/$defs/sha40"}, "ref": {"$ref": "#/$defs/chuoi"}, "cron": {"type": ["string", "null"]}, "khung_danh_nghia_utc": {"oneOf": [{"$ref": "#/$defs/moc_rest"}, {"type": "null"}]}, "run_created_at": {"oneOf": [{"$ref": "#/$defs/moc_rest"}, {"type": "null"}]}}},
  "definition_measured": {"type": "object", "additionalProperties": false, "required": ["blob_oid", "sha256", "trang_thai", "workflow_sha"], "properties": {"trang_thai": {"const": "measured"}, "workflow_sha": {"$ref": "#/$defs/sha40"}, "blob_oid": {"$ref": "#/$defs/sha40"}, "sha256": {"$ref": "#/$defs/sha64"}}},
  "definition_not_measured": {"type": "object", "additionalProperties": false, "required": ["ly_do", "trang_thai", "workflow_sha"], "properties": {"trang_thai": {"const": "not_measured"}, "workflow_sha": {"oneOf": [{"$ref": "#/$defs/sha40"}, {"type": "null"}]}, "ly_do": {"$ref": "#/$defs/chuoi"}}},
  "job_truoc": {"type": "object", "additionalProperties": false, "required": ["checkout_sha", "checkout_tree", "completed_at", "dau_job", "job_id", "ket_luan", "khoa", "run_attempt", "started_at", "ten", "tu_than"], "properties": {"ten": {"$ref": "#/$defs/chuoi"}, "khoa": {"$ref": "#/$defs/chuoi"}, "job_id": {"$ref": "#/$defs/so_duong"}, "run_attempt": {"$ref": "#/$defs/so_duong"}, "started_at": {"$ref": "#/$defs/moc_rest"}, "checkout_sha": {"$ref": "#/$defs/sha40"}, "checkout_tree": {"$ref": "#/$defs/sha40"}, "dau_job": {"$ref": "#/$defs/artifact"}, "tu_than": {"const": false}, "ket_luan": {"const": "success"}, "completed_at": {"$ref": "#/$defs/moc_rest"}}},
  "job_thu": {"type": "object", "additionalProperties": false, "required": ["checkout_sha", "checkout_tree", "completed_at", "dau_job", "job_id", "ket_luan", "khoa", "run_attempt", "started_at", "ten", "tu_than"], "properties": {"ten": {"$ref": "#/$defs/chuoi"}, "khoa": {"$ref": "#/$defs/chuoi"}, "job_id": {"$ref": "#/$defs/so_duong"}, "run_attempt": {"$ref": "#/$defs/so_duong"}, "started_at": {"$ref": "#/$defs/moc_rest"}, "checkout_sha": {"$ref": "#/$defs/sha40"}, "checkout_tree": {"$ref": "#/$defs/sha40"}, "dau_job": {"$ref": "#/$defs/artifact"}, "tu_than": {"const": true}, "ket_luan": {"type": "null"}, "completed_at": {"type": "null"}}},
  "manh": {"type": "object", "additionalProperties": false, "required": ["artifact", "attempt_ben_san_xuat", "head", "khoa_job", "manh"], "properties": {"manh": {"type": "integer", "minimum": 0}, "khoa_job": {"$ref": "#/$defs/chuoi"}, "attempt_ben_san_xuat": {"$ref": "#/$defs/so_duong"}, "head": {"$ref": "#/$defs/sha40"}, "artifact": {"$ref": "#/$defs/artifact"}}},
  "bien_nhan_xanh": {"type": "object", "additionalProperties": false, "required": ["cong_cu", "dau_hieu_duong", "dinh_danh_definition", "job", "kho", "kho_id", "kiem_ke_job", "luot", "manh", "ok", "schema", "su_kien", "tao_luc", "workflow"], "properties": {"schema": {"$ref": "#/$defs/ten_schema"}, "kho": {"$ref": "#/$defs/kho"}, "kho_id": {"$ref": "#/$defs/so_duong"}, "workflow": {"$ref": "#/$defs/workflow"}, "luot": {"$ref": "#/$defs/luot"}, "tao_luc": {"$ref": "#/$defs/moc_ms"}, "cong_cu": {"$ref": "#/$defs/cong_cu"}, "ok": {"const": true}, "su_kien": {"oneOf": [{"$ref": "#/$defs/su_kien_schedule"}, {"$ref": "#/$defs/su_kien_dispatch"}]}, "dinh_danh_definition": {"oneOf": [{"$ref": "#/$defs/definition_measured"}, {"$ref": "#/$defs/definition_not_measured"}]}, "kiem_ke_job": {"type": "object", "additionalProperties": false, "required": ["ky_vong", "thuc_co"], "properties": {"ky_vong": {"$ref": "#/$defs/ds_ten"}, "thuc_co": {"$ref": "#/$defs/ds_ten"}}}, "job": {"type": "array", "minItems": 2, "items": {"oneOf": [{"$ref": "#/$defs/job_truoc"}, {"$ref": "#/$defs/job_thu"}]}, "contains": {"$ref": "#/$defs/job_thu"}, "maxContains": 1}, "manh": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/manh"}}, "dau_hieu_duong": {"type": "object", "additionalProperties": false, "required": ["job_truoc_success", "manh"], "properties": {"job_truoc_success": {"$ref": "#/$defs/cap"}, "manh": {"$ref": "#/$defs/cap"}}}}},
  "bien_nhan_khong_xanh": {"type": "object", "additionalProperties": false, "required": ["cong_cu", "kho", "kho_id", "luot", "ly_do", "ok", "schema", "su_kien", "tao_luc", "workflow"], "properties": {"schema": {"$ref": "#/$defs/ten_schema"}, "kho": {"$ref": "#/$defs/kho"}, "kho_id": {"$ref": "#/$defs/so_duong"}, "workflow": {"$ref": "#/$defs/workflow"}, "luot": {"$ref": "#/$defs/luot"}, "tao_luc": {"$ref": "#/$defs/moc_ms"}, "cong_cu": {"$ref": "#/$defs/cong_cu"}, "ok": {"const": false}, "su_kien": {"$ref": "#/$defs/su_kien_khong_xanh"}, "ly_do": {"type": "array", "items": {"$ref": "#/$defs/chuoi"}, "minItems": 1}}},
  "dau_job_v1": {"type": "object", "additionalProperties": false, "required": ["checkout_sha", "checkout_tree", "khoa_job", "run_attempt", "run_id", "schema", "su_kien_sha"], "properties": {"schema": {"const": "dau_job.v1"}, "khoa_job": {"$ref": "#/$defs/chuoi"}, "run_id": {"$ref": "#/$defs/so_duong"}, "run_attempt": {"$ref": "#/$defs/so_duong"}, "su_kien_sha": {"$ref": "#/$defs/sha40"}, "checkout_sha": {"$ref": "#/$defs/sha40"}, "checkout_tree": {"$ref": "#/$defs/sha40"}}}
 }
}
