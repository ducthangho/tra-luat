{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ducthangho/tra-luat/schemas/review_verdict.v2.schema.json",
  "title": "tra-luat review verdict v2 (ADR-0068: bang lop bat buoc)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "generation", "doi_tuong", "doi_tuong_sha256", "luot", "provider", "role", "model_family",
               "execution_surface", "transport", "session_id", "model_reviewer_identity", "github_submitter_identity", "reviewed_sha",
               "independent_from_executor_session", "review_axes", "tests", "findings", "bang_lop", "doi_chieu_luot_truoc", "verdict",
               "assurance", "evidence_url"],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"},
    "hang": {"enum": ["P0", "P1", "P2", "P3"]},
    "chu": {"type": "string", "minLength": 1}
  },
  "properties": {
    "schema_version": {"const": 2},
    "packet_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"},
    "generation": {"type": "integer", "minimum": 1},
    "doi_tuong": {"enum": ["ma", "dac_ta", "ke_hoach"]},
    "doi_tuong_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "luot": {"type": "integer", "minimum": 1},
    "provider": {"enum": ["claude", "codex", "google_antigravity", "human"]},
    "role": {"const": "reviewer"},
    "model_family": {"enum": ["claude", "openai", "gemini", null]},
    "execution_surface": {"$ref": "#/$defs/chu"},
    "transport": {"$ref": "#/$defs/chu"},
    "session_id": {"$ref": "#/$defs/chu"},
    "model_reviewer_identity": {"$ref": "#/$defs/chu"},
    "github_submitter_identity": {"type": ["string", "null"], "minLength": 1},
    "reviewed_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"},
    "independent_from_executor_session": {"const": true},
    "review_axes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["spec", "standards_security"]}},
    "tests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "evidence"],
      "properties": {"name": {"$ref": "#/$defs/chu"}, "status": {"enum": ["passed", "failed", "skipped", "not_run"]}, "evidence": {"type": "string"}}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["finding_id", "class_slug", "severity", "path", "line", "evidence", "goi_y_va"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/slug"},
        "class_slug": {"$ref": "#/$defs/slug"},
        "severity": {"$ref": "#/$defs/hang"},
        "path": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "evidence": {"$ref": "#/$defs/chu"},
        "goi_y_va": {"type": "object", "additionalProperties": false, "required": ["va_o_dau", "va_the_nao", "ca_khoa", "co_the_de_ra"],
          "properties": {"va_o_dau": {"$ref": "#/$defs/chu"}, "va_the_nao": {"$ref": "#/$defs/chu"}, "ca_khoa": {"$ref": "#/$defs/chu"}, "co_the_de_ra": {"$ref": "#/$defs/chu"}}}}}},
    "bang_lop": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["slug", "hang", "finding_ids", "nguon", "cach_va_chung", "phep_kiem_dong"],
      "properties": {
        "slug": {"$ref": "#/$defs/slug"},
        "hang": {"$ref": "#/$defs/hang"},
        "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "nguon": {"$ref": "#/$defs/chu"},
        "cach_va_chung": {"$ref": "#/$defs/chu"},
        "phep_kiem_dong": {"$ref": "#/$defs/chu"}}}},
    "doi_chieu_luot_truoc": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["finding_id", "class_slug", "nhan", "bang_chung"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/slug"},
        "class_slug": {"$ref": "#/$defs/slug"},
        "nhan": {"enum": ["ĐÃ VÁ THẬT", "VÁ HỜ", "VÁ SINH LỖI MỚI", "CHƯA VÁ"]},
        "bang_chung": {"$ref": "#/$defs/chu"}}}},
    "hoi_tu": {"type": "object", "additionalProperties": false, "required": ["U", "F"],
      "properties": {"U": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}, "F": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}}},
    "verdict": {"enum": ["approve", "changes_requested", "blocked"]},
    "assurance": {"enum": ["cross_approved", "same_provider_approved", "human_audited", "review_deferred"]},
    "evidence_url": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"luot": {"const": 1}}}, "then": {"properties": {"doi_chieu_luot_truoc": {"maxItems": 0}}}, "else": {"required": ["hoi_tu"]}},
    {"if": {"properties": {"doi_tuong": {"const": "ma"}}}, "then": {"properties": {"doi_tuong_sha256": {"type": "null"}}}, "else": {"properties": {"doi_tuong_sha256": {"type": "string"}}}}
  ]
}
