+INV_BANG_SHA256 = "a022ca600b71d79322dde5e5b91db3c6e672e46a604f16cad690ce54df640a4c"
+INV_NEO_PROTOCOL = (  # (nhãn, loại đơn vị, băm) — `tieu_de`: trọn một dòng tiêu đề; `cau`: trọn một dãy câu liền nhau của một khối văn xuôi
+    ("N01", "tieu_de", "0eb04ef288db2efe2ef8c79cd080572b0e6319c519cd7373d2831c2169b43c7f"),
