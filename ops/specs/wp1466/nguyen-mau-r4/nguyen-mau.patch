+    m = re.findall(r"(?ms)^" + re.escape(dau) + r".*?(?=\n[ \t]*\n)", goc)
+    if len(m) != 1:
+        raise AssertionError(f"fixture: cần đúng một khối mở bằng {dau!r}, thấy {len(m)}")
+    return m[0]
+
