+    ("K05", "a269e3af7b2d36a8183d16c912c5ddbcfae33e923d3b2d45cbd888b59b362b70", 8, "31820977356049aac3c810dbf26933fd93ee491e9f3bfda0ad875a81289776b9"),
+    ("K06", "a269e3af7b2d36a8183d16c912c5ddbcfae33e923d3b2d45cbd888b59b362b70", 9, "8e35ce2dc3bb5cac3dbd9855d35bc80a558b47bce8cafaaeff3de9a9ba0a9f51"),
+    ("K07", "a269e3af7b2d36a8183d16c912c5ddbcfae33e923d3b2d45cbd888b59b362b70", 10, "3188510c14bb84bb6cc4a881e2bd190e01bc863f55a869b12adcfb884f9671ef"),
+)
+_INV_ID_TRAN = re.compile(r"INV-[0-9]{2}(?![0-9A-Za-z-])")
