{
  "id": "nlm_query_quality",
  "title": "Truy vấn NotebookLM chất lượng cao",
  "risk": "medium",
  "applies_to": [
    "notebooklm_query",
    "legal_qa",
    "profile_qa"
  ],
  "recommended_commands": [
    "source-map --json",
    "reg-query --json",
    "nlm-query-plan <question> --source-id <id> --json",
    "nlm-query <question> --source-id <id> --json",
    "nlm-cross <question> --source-id <id> --json",
    "extract <query> --json"
  ],
  "plan": [
    "locate/source-map/reg-query to shortlist sources",
    "select exact source_ids",
    "ask narrow question",
    "verify important answer by original text or tl extract"
  ],
  "apply": [
    "use 1-3 source_ids by default",
    "use 4 only for justified comparison",
    "5 is hard cap, not default",
    "split into multiple questions when more sources are needed"
  ],
  "verify": [
    "confirm answer cites selected sources",
    "confirm no RAG answer is treated as verbatim",
    "cross-check legal quotes with tl extract when VBQPPL"
  ],
  "stop_conditions": [
    "more than 4 sources required without split",
    "uncertain source version",
    "OCR/draft source without warning"
  ],
  "rules": [
    "NLM is for reading/locating, not final legal authority",
    "Scope by source_id whenever possible"
  ],
  "schema": "workflow_card.v1",
  "write_scope": "nlm_read_only",
  "dry_run_required": true,
  "confirm_required": false,
  "readback_required": true,
  "rollback_required": false,
  "live_state_required": false,
  "volatile_fields": [
    "path",
    "file",
    "out_dir",
    "seconds",
    "stdout_tail",
    "stderr_tail"
  ]
}
